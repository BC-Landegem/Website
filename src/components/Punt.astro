---
// Het meetpunt: het rode bolletje met de veer-ring eromheen. Twee gedaantes,
// dezelfde bol — op de draad (absoluut, links op de rail-inspringing) of los
// naast een label, waar het klopt om "dit is live" te tonen.
interface Props {
  /**
   * Zet het punt op de draad, op de opgegeven hoogte — een volledige
   * Tailwind-klasse (`top-2`, `top-12`), want Tailwind leest de broncode
   * statisch. Zonder deze prop staat het punt gewoon in de tekststroom.
   */
  top?: string;
  /** Groeit bij hover op de omliggende `.group` — voor punten die in een link zitten. */
  groeit?: boolean;
  /** Klopt zachtjes; blijft stil wanneer de bezoeker minder beweging vraagt. */
  klopt?: boolean;
  id?: string;
}

const { top, klopt = false, groeit = false, id } = Astro.props;
---

<span
  id={id}
  class:list={[
    'h-3.5 w-3.5 rounded-full bg-club-500 ring-4 ring-veer-50',
    top && ['absolute left-[6px] -translate-x-1/2', top],
    klopt && 'motion-safe:animate-pulse',
    groeit && 'transition-transform duration-300 group-hover:scale-125',
  ]}
  aria-hidden="true"></span>

---
import { url } from '../lib/url';
import teams from '../data/teams.json';

const clubItems = [
  { label: 'Over de club', href: '/club/over-de-club/' },
  { label: 'Aanspreekpunt Integriteit', href: '/club/aanspreekpunt-integriteit/' },
  { label: 'Gedragscode', href: '/club/gedragscode/' },
];

const mainItems = [
  { label: 'Jeugd', href: '/jeugd/' },
  { label: 'Intraclub', href: '/intraclub/' },
  { label: 'Kalender', href: '/kalender/' },
  { label: "Foto's", href: '/media/' },
];

const reeksen = ['Heren', 'Gemengd', 'Dames'];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(url(href).replace(/\/$/, ''));
---

<header class="sticky top-0 z-50 border-b border-inkt-950/10 bg-veer-50/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={url('/')} class="flex items-center gap-3">
      <img src={url('/images/logo-bc1.svg')} alt="" class="h-10 w-auto" />
      <span class="stem-baan text-sm text-inkt-950">BC Landegem</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="peer sr-only" aria-label="Menu openen of sluiten" />

    <!-- Hamburger (mobiel) -->
    <label
      for="nav-toggle"
      class="cursor-pointer rounded p-2 hover:bg-veer-100 peer-checked:[&_.icon-open]:hidden peer-checked:[&_.icon-close]:block md:hidden"
    >
      <svg class="icon-open h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="icon-close hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </label>

    <!-- Navigatie -->
    <nav
      class="absolute inset-x-0 top-full hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-b border-inkt-950/10 bg-veer-50 shadow-lg peer-checked:block md:static md:block md:max-h-none md:overflow-visible md:border-0 md:bg-transparent md:shadow-none"
    >
      <ul class="flex flex-col gap-1 p-4 md:flex-row md:items-center md:gap-1 md:p-0">
        <li>
          <a
            href={url('/')}
            class:list={[
              'block border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600',
              currentPath === url('/') && 'border-club-500 text-club-600',
            ]}
          >
            Home
          </a>
        </li>

        <!-- Competitie met ploegen-dropdown: spelers springen zo rechtstreeks naar hun ploeg -->
        <li class="group relative">
          <a
            href={url('/competitie/')}
            class:list={[
              'hidden items-center gap-1 border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600 md:flex',
              isActive('/competitie/') && 'border-club-500 text-club-600',
            ]}
          >
            Competitie
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href={url('/competitie/')}
            class:list={[
              'block border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600 md:hidden',
              isActive('/competitie/') && 'border-club-500 text-club-600',
            ]}
          >
            Competitie
          </a>

          <!-- Desktop: hoverpaneel met de ploegen per reeks -->
          <div
            class="hidden md:invisible md:absolute md:left-0 md:top-full md:block md:border md:border-inkt-950/10 md:bg-veer-50 md:opacity-0 md:shadow-lg md:transition md:group-hover:visible md:group-hover:opacity-100 md:group-focus-within:visible md:group-focus-within:opacity-100"
          >
            <div class="flex gap-8 px-5 py-4">
              {reeksen.map((reeks) => (
                <div>
                  <span class="stem-baan block text-xs text-inkt-500">{reeks}</span>
                  <ul class="mt-2 space-y-0.5">
                    {teams.ploegen.filter((p) => p.type === reeks).map((ploeg) => (
                      <li>
                        <a
                          href={ploeg.url}
                          target="_blank"
                          rel="noopener"
                          class="block whitespace-nowrap py-1 text-sm font-medium hover:text-club-600"
                        >
                          {ploeg.naam}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <a
              href={url('/competitie/')}
              class="block whitespace-nowrap border-t border-inkt-950/10 px-5 py-3 text-sm font-semibold text-club-700 hover:bg-veer-100 hover:text-club-800"
            >
              Alle ploegen en info →
            </a>
          </div>

          <!-- Mobiel: compacte ploeg-pillen onder de link -->
          <ul class="flex flex-wrap gap-2 px-3 pb-2 pl-6 md:hidden">
            {teams.ploegen.map((ploeg) => (
              <li>
                <a
                  href={ploeg.url}
                  target="_blank"
                  rel="noopener"
                  class="stem-baan block rounded-full border border-inkt-950/30 px-3 py-1.5 text-xs text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
                >
                  {ploeg.naam.replace('Landegem ', '')}
                </a>
              </li>
            ))}
          </ul>
        </li>

        {mainItems.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'block border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600',
                isActive(item.href) && 'border-club-500 text-club-600',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}

        <!-- Club met submenu -->
        <li class="group relative">
          <a
            href={url('/club/over-de-club/')}
            class:list={[
              'hidden items-center gap-1 border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600 md:flex',
              isActive('/club/') && 'border-club-500 text-club-600',
            ]}
          >
            Club
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <span class="stem-baan block px-3 pt-2 text-xs text-inkt-500 md:hidden">Club</span>
          <ul
            class="md:invisible md:absolute md:right-0 md:top-full md:min-w-56 md:border md:border-inkt-950/10 md:bg-veer-50 md:py-1 md:opacity-0 md:shadow-lg md:transition md:group-hover:visible md:group-hover:opacity-100 md:group-focus-within:visible md:group-focus-within:opacity-100"
          >
            {clubItems.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  class:list={[
                    'block whitespace-nowrap px-3 py-2 pl-6 text-sm font-medium hover:bg-veer-100 hover:text-club-600 md:pl-4',
                    isActive(item.href) && 'text-club-600',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </li>

        <li class="mt-2 md:ml-3 md:mt-0">
          <a
            href={url('/club/word-lid/')}
            class="stem-baan block rounded-full bg-club-500 px-5 py-2.5 text-center text-xs text-white transition-colors hover:bg-club-600"
          >
            Word lid!
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

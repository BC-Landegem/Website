---
import { url } from '../lib/url';
import teams from '../data/teams.json';

// De hoofdnavigatie volgt de doelgroepen: jeugd, recreanten, intraclub,
// competitie. Intraclub staat naast Recreatief omdat het grotendeels dezelfde
// mensen zijn — /recreatief/ linkt er twee keer heen.
const clubItems = [
  { label: 'Over de club', href: '/club/over-de-club/' },
  { label: 'Contact', href: '/club/contact/' },
  { label: 'Aanspreekpunt Integriteit', href: '/club/aanspreekpunt-integriteit/' },
  { label: 'Gedragscode', href: '/club/gedragscode/' },
  { label: 'Archief', href: '/archief/' },
];

const mainItems = [
  { label: 'Jeugd', href: '/jeugd/' },
  { label: 'Recreatief', href: '/recreatief/' },
  { label: 'Intraclub', href: '/intraclub/' },
  { label: 'Kalender', href: '/kalender/' },
  { label: "Foto's", href: '/media/' },
];

const reeksen = ['Heren', 'Gemengd', 'Dames'];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(url(href).replace(/\/$/, ''));
---

<header class="sticky top-0 z-50 border-b border-inkt-950/10 bg-veer-50/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={url('/')} class="flex items-center gap-3">
      <img src={url('/images/logo-bc1.svg')} alt="" class="h-10 w-auto" />
      <span class="stem-baan text-sm text-inkt-950">BC Landegem</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="peer sr-only" aria-label="Menu openen of sluiten" />

    {/* Hamburger (mobiel) */}
    <label
      for="nav-toggle"
      class="cursor-pointer rounded p-2 hover:bg-veer-100 peer-checked:[&_.icon-open]:hidden peer-checked:[&_.icon-close]:block lg:hidden"
    >
      <svg class="icon-open h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="icon-close hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </label>

    {/* Navigatie. Het breekpunt ligt op lg, niet op md: met acht items mat de
         balk uitgeklapt 736px en paste hij met logo en marges pas vanaf ~893px.
         Op een tablet van 768px liep hij ruim honderd pixels buiten beeld; daar
         draagt de hamburger de navigatie. Intraclub maakt het negen items, dus
         de marge tot lg (1024px) is nu krap — komt er nog een item bij, meet de
         balk dan opnieuw voor je op lg blijft rekenen. */}
    <nav
      class="absolute inset-x-0 top-full hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-b border-inkt-950/10 bg-veer-50 shadow-lg peer-checked:block lg:static lg:block lg:max-h-none lg:overflow-visible lg:border-0 lg:bg-transparent lg:shadow-none"
    >
      <ul class="flex flex-col gap-1 p-4 lg:flex-row lg:items-center lg:gap-1 lg:p-0">
        <li>
          <a
            href={url('/')}
            class:list={[
              'block border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600',
              currentPath === url('/') && 'border-club-500 text-club-600',
            ]}
          >
            Home
          </a>
        </li>

        {/* Competitie met ploegen-dropdown: spelers springen zo rechtstreeks naar hun ploeg */}
        <li class="group relative">
          <a
            href={url('/competitie/')}
            class:list={[
              'hidden items-center gap-1 border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600 lg:flex',
              isActive('/competitie/') && 'border-club-500 text-club-600',
            ]}
          >
            Competitie
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href={url('/competitie/')}
            class:list={[
              'block border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600 lg:hidden',
              isActive('/competitie/') && 'border-club-500 text-club-600',
            ]}
          >
            Competitie
          </a>

          {/* Desktop: hoverpaneel met de ploegen per reeks */}
          <div
            class="hidden lg:invisible lg:absolute lg:left-0 lg:top-full lg:block lg:border lg:border-inkt-950/10 lg:bg-veer-50 lg:opacity-0 lg:shadow-lg lg:transition lg:group-hover:visible lg:group-hover:opacity-100 lg:group-focus-within:visible lg:group-focus-within:opacity-100"
          >
            <div class="flex gap-8 px-5 py-4">
              {reeksen.map((reeks) => (
                <div>
                  <span class="stem-baan block text-xs text-inkt-500">{reeks}</span>
                  <ul class="mt-2 space-y-0.5">
                    {teams.ploegen.filter((p) => p.type === reeks).map((ploeg) => (
                      <li>
                        <a
                          href={ploeg.url}
                          target="_blank"
                          rel="noopener"
                          class="block whitespace-nowrap py-1 text-sm font-medium hover:text-club-600"
                        >
                          {ploeg.naam}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <a
              href={url('/competitie/')}
              class="block whitespace-nowrap border-t border-inkt-950/10 px-5 py-3 text-sm font-semibold text-club-700 hover:bg-veer-100 hover:text-club-800"
            >
              Alle ploegen en info →
            </a>
          </div>

          {/* Mobiel: compacte ploeg-pillen onder de link */}
          <ul class="flex flex-wrap gap-2 px-3 pb-2 pl-6 lg:hidden">
            {teams.ploegen.map((ploeg) => (
              <li>
                <a
                  href={ploeg.url}
                  target="_blank"
                  rel="noopener"
                  class="stem-baan block rounded-full border border-inkt-950/30 px-3 py-1.5 text-xs text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
                >
                  {ploeg.naam.replace('Landegem ', '')}
                </a>
              </li>
            ))}
          </ul>
        </li>

        {mainItems.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'block border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600',
                isActive(item.href) && 'border-club-500 text-club-600',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}

        {/* Club met submenu */}
        <li class="group relative">
          <a
            href={url('/club/over-de-club/')}
            class:list={[
              'hidden items-center gap-1 border-b-2 border-transparent px-3 py-2 text-sm font-semibold transition-colors hover:text-club-600 lg:flex',
              isActive('/club/') && 'border-club-500 text-club-600',
            ]}
          >
            Club
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <span class="stem-baan block px-3 pt-2 text-xs text-inkt-500 lg:hidden">Club</span>
          <ul
            class="lg:invisible lg:absolute lg:right-0 lg:top-full lg:min-w-56 lg:border lg:border-inkt-950/10 lg:bg-veer-50 lg:py-1 lg:opacity-0 lg:shadow-lg lg:transition lg:group-hover:visible lg:group-hover:opacity-100 lg:group-focus-within:visible lg:group-focus-within:opacity-100"
          >
            {clubItems.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  class:list={[
                    'block whitespace-nowrap px-3 py-2 pl-6 text-sm font-medium hover:bg-veer-100 hover:text-club-600 lg:pl-4',
                    isActive(item.href) && 'text-club-600',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </li>

        <li class="mt-2 lg:ml-3 lg:mt-0">
          <a
            href={url('/club/word-lid/')}
            class="stem-baan block rounded-full bg-club-600 px-5 py-2.5 text-center text-xs text-white transition-colors hover:bg-club-700"
          >
            Word lid!
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

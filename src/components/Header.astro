---
import { url } from '../lib/url';
import teams from '../data/teams.json';

// De hoofdnavigatie volgt de doelgroepen: jeugd, recreanten, intraclub,
// competitie. Intraclub staat naast Recreatief omdat het grotendeels dezelfde
// mensen zijn — /recreatief/ linkt er twee keer heen.
const clubItems = [
  { label: 'Over de club', href: '/club/over-de-club/' },
  { label: 'Contact', href: '/club/contact/' },
  { label: 'Aanspreekpunt Integriteit', href: '/club/aanspreekpunt-integriteit/' },
  { label: 'Gedragscode', href: '/club/gedragscode/' },
  { label: 'Archief', href: '/archief/' },
];

const mainItems = [
  { label: 'Jeugd', href: '/jeugd/' },
  { label: 'Recreatief', href: '/recreatief/' },
  { label: 'Intraclub', href: '/intraclub/' },
  { label: 'Kalender', href: '/kalender/' },
  { label: "Foto's", href: '/media/' },
];

const reeksen = ['Heren', 'Gemengd', 'Dames'];


const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(url(href).replace(/\/$/, ''));
---

<header class="sticky top-0 z-50 border-b border-inkt-950/10 bg-veer-50/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={url('/')} class="flex items-center gap-3">
      <img src={url('/images/logo-bc1.svg')} alt="" class="h-10 w-auto" />
      <span class="stem-baan text-sm text-inkt-950">BC Landegem</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="sr-only" aria-label="Menu openen of sluiten" />

    {/* Hamburger (mobiel) */}
    <label for="nav-toggle" class="hamburger cursor-pointer rounded p-2 hover:bg-veer-100">
      <svg class="icoon-open h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="icoon-sluit h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </label>

    <nav class="nav">
      <ul class="lijst">
        <li>
          <a href={url('/')} class:list={['navlink', currentPath === url('/') && 'actief']}>Home</a>
        </li>

        {/* Competitie met ploegen-dropdown: spelers springen zo rechtstreeks naar hun ploeg */}
        <li class="menu">
          <a href={url('/competitie/')} class:list={['navlink', isActive('/competitie/') && 'actief']}>
            Competitie
            <svg class="chevron h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          {/* Desktop: hoverpaneel met de ploegen per reeks */}
          <div class="paneel">
            <div class="flex gap-8 px-5 py-4">
              {reeksen.map((reeks) => (
                <div>
                  <span class="stem-baan block text-xs text-inkt-500">{reeks}</span>
                  <ul class="mt-2 space-y-0.5">
                    {teams.ploegen.filter((p) => p.type === reeks).map((ploeg) => (
                      <li>
                        <a
                          href={ploeg.url}
                          target="_blank"
                          rel="noopener"
                          class="block whitespace-nowrap py-1 text-sm font-medium hover:text-club-600"
                        >
                          {ploeg.naam}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <a
              href={url('/competitie/')}
              class="block whitespace-nowrap border-t border-inkt-950/10 px-5 py-3 text-sm font-semibold text-club-700 hover:bg-veer-100 hover:text-club-800"
            >
              Alle ploegen en info →
            </a>
          </div>

          {/* Mobiel: compacte ploeg-pillen onder de link */}
          <ul class="ploegpillen">
            {teams.ploegen.map((ploeg) => (
              <li>
                <a
                  href={ploeg.url}
                  target="_blank"
                  rel="noopener"
                  class="stem-baan block rounded-full border border-inkt-950/30 px-3 py-1.5 text-xs text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
                >
                  {ploeg.naam.replace('Landegem ', '')}
                </a>
              </li>
            ))}
          </ul>
        </li>

        {mainItems.map((item) => (
          <li>
            <a href={url(item.href)} class:list={['navlink', isActive(item.href) && 'actief']}>
              {item.label}
            </a>
          </li>
        ))}

        {/* Club met submenu */}
        <li class="menu">
          <a href={url('/club/over-de-club/')} class:list={['navlink', isActive('/club/') && 'actief']}>
            Club
            <svg class="chevron h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <span class="subnav-kop stem-baan px-3 pt-2 text-xs text-inkt-500">Club</span>
          <ul class="subnav">
            {clubItems.map((item) => (
              <li>
                <a href={url(item.href)} class:list={['subnavlink', isActive(item.href) && 'actief']}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </li>

        <li class="word-lid">
          <a
            href={url('/club/word-lid/')}
            class="stem-baan block rounded-full bg-club-600 px-5 py-2.5 text-center text-xs text-white transition-colors hover:bg-club-700"
          >
            Word lid!
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* De navigatie is het enige stuk van de site waar mobiel en desktop écht twee
     verschillende dingen zijn: een uitklappaneel tegenover een balk met
     hoverpanelen. In utility-klassen kostte dat veertien lg:-prefixes op één
     element plus een tweede, bijna identieke Competitie-link; als media query
     is het het blok hieronder.

     Let op: scoped stijlen staan buiten Tailwinds @layer utilities en winnen
     dus altijd van een gelijknamige utility, ongeacht specificiteit. Daarom
     wordt display hier volledig in CSS geregeld en niet half in klassen. */

  header {
    --rand: color-mix(in srgb, var(--color-inkt-950) 10%, transparent);
    --paneel-schaduw:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
  }

  /* ── Mobiel: de basis ─────────────────────────────────────────────────── */

  .nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    display: none;
    /* 4rem is de hoogte van de balk: het paneel scrollt binnen wat overblijft. */
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    border-bottom: 1px solid var(--rand);
    background: var(--color-veer-50);
    box-shadow: var(--paneel-schaduw);
  }

  #nav-toggle:checked ~ .nav {
    display: block;
  }

  .icoon-sluit {
    display: none;
  }
  #nav-toggle:checked ~ .hamburger .icoon-open {
    display: none;
  }
  #nav-toggle:checked ~ .hamburger .icoon-sluit {
    display: block;
  }

  .lijst {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
  }

  .menu {
    position: relative;
  }

  .navlink {
    display: block;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid transparent;
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .navlink:hover {
    color: var(--color-club-600);
  }
  .navlink.actief {
    border-bottom-color: var(--color-club-500);
    color: var(--color-club-600);
  }

  .subnav-kop {
    display: block;
  }

  .subnavlink {
    display: block;
    white-space: nowrap;
    padding: 0.5rem 0.75rem 0.5rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .subnavlink:hover {
    background: var(--color-veer-100);
    color: var(--color-club-600);
  }
  .subnavlink.actief {
    color: var(--color-club-600);
  }

  /* Het ploegenpaneel is een hover-affordance; een telefoon heeft geen hover,
     daar staan de ploegen als pillen onder de link. */
  .paneel,
  .chevron {
    display: none;
  }

  .ploegpillen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 0.75rem 0.5rem 1.5rem;
  }

  .word-lid {
    margin-top: 0.5rem;
  }

  /* ── Desktop ──────────────────────────────────────────────────────────────
     Het breekpunt ligt op 64rem (Tailwinds lg), niet op 48rem (md): met acht
     items mat de balk uitgeklapt 736px en paste hij met logo en marges pas
     vanaf ~893px. Op een tablet van 768px liep hij ruim honderd pixels buiten
     beeld; daar draagt de hamburger de navigatie. Intraclub maakt het negen
     items, dus de marge tot 1024px is nu krap — komt er nog een item bij, meet
     de balk dan opnieuw voor je op 64rem blijft rekenen. */

  @media (width >= 64rem) {
    .hamburger,
    .subnav-kop,
    .ploegpillen {
      display: none;
    }

    .nav {
      position: static;
      display: block;
      max-height: none;
      overflow: visible;
      border: 0;
      background: transparent;
      box-shadow: none;
    }

    .lijst {
      flex-direction: row;
      align-items: center;
      padding: 0;
    }

    .menu > .navlink {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .chevron {
      display: block;
    }

    /* Onzichtbaar maar wél gelayout, zodat de overgang iets heeft om te lopen. */
    .paneel,
    .subnav {
      position: absolute;
      top: 100%;
      left: 0;
      display: block;
      visibility: hidden;
      opacity: 0;
      border: 1px solid var(--rand);
      background: var(--color-veer-50);
      box-shadow: var(--paneel-schaduw);
      transition:
        opacity 0.15s,
        visibility 0.15s;
    }

    /* Het clubmenu staat rechts in de balk en klapt dus naar links open. */
    .subnav {
      left: auto;
      right: 0;
      min-width: 14rem;
      padding-block: 0.25rem;
    }

    .menu:hover > .paneel,
    .menu:focus-within > .paneel,
    .menu:hover > .subnav,
    .menu:focus-within > .subnav {
      visibility: visible;
      opacity: 1;
    }

    .subnavlink {
      padding-left: 1rem;
    }

    .word-lid {
      margin-top: 0;
      margin-left: 0.75rem;
    }
  }
</style>

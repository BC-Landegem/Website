---
import { url } from '../lib/url';
import teams from '../data/teams.json';

// De hoofdnavigatie volgt de doelgroepen: jeugd, recreanten, intraclub,
// competitie. Intraclub staat naast Recreatief omdat het grotendeels dezelfde
// mensen zijn — /recreatief/ linkt er twee keer heen.
const clubItems = [
  { label: 'Over de club', href: '/club/over-de-club/' },
  { label: 'Contact', href: '/club/contact/' },
  { label: 'Twizzit tips', href: '/club/twizzit/' },
  { label: 'Aanspreekpunt Integriteit', href: '/club/aanspreekpunt-integriteit/' },
  { label: 'Gedragscode', href: '/club/gedragscode/' },
  { label: 'Archief', href: '/archief/' },
];

// De intraclub is meer dan het klassement geworden: er hangen zeventien
// seizoenen historiek en een recordpagina aan. Dat wordt een submenu en geen
// tiende item in de balk — die telt er al negen en past pas vanaf ~893px.
const intraclubItems = [
  { label: 'Klassement', href: '/intraclub/', exact: true },
  { label: 'Erelijst', href: '/intraclub/erelijst/' },
  { label: 'Clubrecords', href: '/intraclub/records/' },
  { label: 'Zo werkt het', href: '/intraclub/zo-werkt-het/' },
];

const mainItems = [
  { label: 'Jeugd', href: '/jeugd/' },
  { label: 'Recreatief', href: '/recreatief/' },
  { label: 'Intraclub', href: '/intraclub/', children: intraclubItems },
  { label: 'Kalender', href: '/kalender/' },
  { label: "Foto's", href: '/media/' },
];

const divisions = ['Heren', 'Gemengd', 'Dames'];


const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(url(href).replace(/\/$/, ''));
/**
 * "Klassement" wijst naar /intraclub/ zelf, en dat pad is het begin van elke
 * intraclub-URL. Met startsWith zou het dus op de erelijst óók actief staan.
 */
const isExact = (href: string) => currentPath.replace(/\/$/, '') === url(href).replace(/\/$/, '');
---

<header class="sticky top-0 z-50 border-b border-ink-950/10 bg-feather-50/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={url('/')} class="flex items-center gap-3">
      <img src={url('/images/logo-bc1.svg')} alt="" class="h-10 w-auto" />
      <span class="type-label text-sm text-ink-950">BC Landegem</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="sr-only" aria-label="Menu openen of sluiten" />

    {/* Hamburger (mobiel) */}
    <label for="nav-toggle" class="hamburger cursor-pointer rounded p-2 hover:bg-feather-100">
      <svg class="icon-open h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="icon-close h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </label>

    <nav class="nav">
      <ul class="list">
        <li>
          <a href={url('/')} class:list={['navlink', currentPath === url('/') && 'active']}>Home</a>
        </li>

        {/* Competitie met ploegen-dropdown: spelers springen zo rechtstreeks naar hun ploeg */}
        <li class="menu">
          <a href={url('/competitie/')} class:list={['navlink', isActive('/competitie/') && 'active']}>
            Competitie
            <svg class="chevron h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          {/* Desktop: hoverpaneel met de ploegen per reeks */}
          <div class="panel">
            <div class="flex gap-8 px-5 py-4">
              {divisions.map((division) => (
                <div>
                  <span class="type-label block text-xs text-ink-500">{division}</span>
                  <ul class="mt-2 space-y-0.5">
                    {teams.teams.filter((t) => t.type === division).map((team) => (
                      <li>
                        <a
                          href={team.url}
                          target="_blank"
                          rel="noopener"
                          class="block whitespace-nowrap py-1 text-sm font-medium hover:text-club-600"
                        >
                          {team.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <a
              href={url('/competitie/')}
              class="block whitespace-nowrap border-t border-ink-950/10 px-5 py-3 text-sm font-semibold text-club-700 hover:bg-feather-100 hover:text-club-800"
            >
              Alle ploegen en info →
            </a>
          </div>

          {/* Mobiel: compacte ploeg-pillen onder de link */}
          <ul class="team-pills">
            {teams.teams.map((team) => (
              <li>
                <a
                  href={team.url}
                  target="_blank"
                  rel="noopener"
                  class="type-label block rounded-full border border-ink-950/30 px-3 py-1.5 text-xs text-ink-950 transition-colors hover:border-club-600 hover:text-club-600"
                >
                  {team.name.replace('Landegem ', '')}
                </a>
              </li>
            ))}
          </ul>
        </li>

        {mainItems.map((item) =>
          item.children ? (
            /* Zelfde patroon als Club: een submenu in plaats van een extra item in de balk */
            <li class="menu">
              <a href={url(item.href)} class:list={['navlink', isActive(item.href) && 'active']}>
                {item.label}
                <svg class="chevron h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <span class="subnav-heading type-label px-3 pt-2 text-xs text-ink-500">{item.label}</span>
              <ul class="subnav">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={url(child.href)}
                      class:list={[
                        'subnavlink',
                        (child.exact ? isExact(child.href) : isActive(child.href)) && 'active',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={url(item.href)} class:list={['navlink', isActive(item.href) && 'active']}>
                {item.label}
              </a>
            </li>
          ),
        )}

        {/* Club met submenu */}
        <li class="menu">
          <a href={url('/club/over-de-club/')} class:list={['navlink', isActive('/club/') && 'active']}>
            Club
            <svg class="chevron h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <span class="subnav-heading type-label px-3 pt-2 text-xs text-ink-500">Club</span>
          <ul class="subnav">
            {clubItems.map((item) => (
              <li>
                <a href={url(item.href)} class:list={['subnavlink', isActive(item.href) && 'active']}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </li>

        <li class="join">
          <a
            href={url('/club/word-lid/')}
            class="type-label block rounded-full bg-club-600 px-5 py-2.5 text-center text-xs text-white transition-colors hover:bg-club-700"
          >
            Word lid!
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* De navigatie is het enige stuk van de site waar mobiel en desktop écht twee
     verschillende dingen zijn: een uitklappaneel tegenover een balk met
     hoverpanelen. In utility-klassen kostte dat veertien lg:-prefixes op één
     element plus een tweede, bijna identieke Competitie-link; als media query
     is het het blok hieronder.

     Let op: scoped stijlen staan buiten Tailwinds @layer utilities en winnen
     dus altijd van een gelijknamige utility, ongeacht specificiteit. Daarom
     wordt display hier volledig in CSS geregeld en niet half in klassen. */

  header {
    --edge: color-mix(in srgb, var(--color-ink-950) 10%, transparent);
    --panel-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
  }

  /* ── Mobiel: de basis ─────────────────────────────────────────────────── */

  .nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    display: none;
    /* 4rem is de hoogte van de balk: het paneel scrollt binnen wat overblijft. */
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    border-bottom: 1px solid var(--edge);
    background: var(--color-feather-50);
    box-shadow: var(--panel-shadow);
  }

  #nav-toggle:checked ~ .nav {
    display: block;
  }

  .icon-close {
    display: none;
  }
  #nav-toggle:checked ~ .hamburger .icon-open {
    display: none;
  }
  #nav-toggle:checked ~ .hamburger .icon-close {
    display: block;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
  }

  .menu {
    position: relative;
  }

  .navlink {
    display: block;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid transparent;
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .navlink:hover {
    color: var(--color-club-600);
  }
  .navlink.active {
    border-bottom-color: var(--color-club-500);
    color: var(--color-club-600);
  }

  .subnav-heading {
    display: block;
  }

  .subnavlink {
    display: block;
    white-space: nowrap;
    padding: 0.5rem 0.75rem 0.5rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .subnavlink:hover {
    background: var(--color-feather-100);
    color: var(--color-club-600);
  }
  .subnavlink.active {
    color: var(--color-club-600);
  }

  /* Het ploegenpaneel is een hover-affordance; een telefoon heeft geen hover,
     daar staan de ploegen als pillen onder de link. */
  .panel,
  .chevron {
    display: none;
  }

  .team-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 0.75rem 0.5rem 1.5rem;
  }

  .join {
    margin-top: 0.5rem;
  }

  /* ── Desktop ──────────────────────────────────────────────────────────────
     Het breekpunt ligt op 64rem (Tailwinds lg), niet op 48rem (md): met acht
     items mat de balk uitgeklapt 736px en paste hij met logo en marges pas
     vanaf ~893px. Op een tablet van 768px liep hij ruim honderd pixels buiten
     beeld; daar draagt de hamburger de navigatie. Intraclub maakt het negen
     items, dus de marge tot 1024px is nu krap — komt er nog een item bij, meet
     de balk dan opnieuw voor je op 64rem blijft rekenen. */

  @media (width >= 64rem) {
    .hamburger,
    .subnav-heading,
    .team-pills {
      display: none;
    }

    .nav {
      position: static;
      display: block;
      max-height: none;
      overflow: visible;
      border: 0;
      background: transparent;
      box-shadow: none;
    }

    .list {
      flex-direction: row;
      align-items: center;
      padding: 0;
    }

    .menu > .navlink {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .chevron {
      display: block;
    }

    /* Onzichtbaar maar wél gelayout, zodat de overgang iets heeft om te lopen. */
    .panel,
    .subnav {
      position: absolute;
      top: 100%;
      left: 0;
      display: block;
      visibility: hidden;
      opacity: 0;
      border: 1px solid var(--edge);
      background: var(--color-feather-50);
      box-shadow: var(--panel-shadow);
      transition:
        opacity 0.15s,
        visibility 0.15s;
    }

    /* Het clubmenu staat rechts in de balk en klapt dus naar links open. */
    .subnav {
      left: auto;
      right: 0;
      min-width: 14rem;
      padding-block: 0.25rem;
    }

    .menu:hover > .panel,
    .menu:focus-within > .panel,
    .menu:hover > .subnav,
    .menu:focus-within > .subnav {
      visibility: visible;
      opacity: 1;
    }

    .subnavlink {
      padding-left: 1rem;
    }

    .join {
      margin-top: 0;
      margin-left: 0.75rem;
    }
  }
</style>

---
// Filter- of tabknop: een ronde pil die rood invult zodra ze aan staat. De
// aan-staat komt uit aria-selected (tabs) of aria-pressed (toggles) — welke
// van de twee bepaalt de aanroeper, de pil stijlt ze allebei.
interface Props {
  /** `small` voor de pillen die binnen een tabelrij of scorebord staan. */
  size?: 'normal' | 'small';
  class?: string;
  [key: string]: unknown;
}

const { size = 'normal', class: extra, ...rest } = Astro.props;

// Volledige klassennamen, want Tailwind leest de broncode statisch.
const sizes = {
  normal: 'px-4 py-1.5 text-xs',
  small: 'px-3 py-1 text-[0.65rem]',
};
---

<button
  type="button"
  class:list={[
    'type-label rounded-full border-2 border-ink-950/20 text-ink-700 transition-colors hover:border-club-600 hover:text-club-600',
    'aria-selected:border-club-600 aria-selected:bg-club-600 aria-selected:text-white',
    'aria-pressed:border-club-600 aria-pressed:bg-club-600 aria-pressed:text-white',
    sizes[size],
    extra,
  ]}
  {...rest}
>
  <slot />
</button>

---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<div class="border-b border-neutral-200 bg-neutral-50">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    {intro && <p class="mt-3 max-w-2xl text-lg text-neutral-600">{intro}</p>}
  </div>
</div>

---
import { url } from '../lib/url';
import { vanGroep, type Groep } from '../lib/archief';

/**
 * Zijdeur naar het archief, vanaf de pagina waar dat onderwerp leeft.
 * Kurk in plaats van clubrood: dezelfde taal als /archief/ zelf, zodat de
 * bezoeker vóór het klikken al ziet dat hij naar oude inhoud gaat.
 */
interface Props {
  groep: Groep;
  /** Overschrijft de standaardzin; gebruik als de pagina om een andere toon vraagt. */
  tekst?: string;
}

const { groep, tekst } = Astro.props;
const artikels = await vanGroep(groep);
if (artikels.length === 0) return new Response(null, { status: 404 });

const oudste = artikels[artikels.length - 1].data.datum.getUTCFullYear();
const nieuwste = artikels[0].data.datum.getUTCFullYear();
---

<a
  href={url(`/archief/${groep}/`)}
  class="group mt-10 flex items-baseline justify-between gap-4 border-l-2 border-kurk-400 bg-kurk-300/15 px-5 py-4 transition-colors hover:bg-kurk-300/30"
>
  <span>
    <span class="stem-baan block text-[0.65rem] text-kurk-600">Uit het archief</span>
    <span class="mt-1 block text-sm text-inkt-700">
      {tekst ?? `${artikels.length} oude artikels over dit onderwerp, van ${oudste} tot ${nieuwste}.`}
    </span>
  </span>
  <span class="stem-baan shrink-0 text-xs text-inkt-950 group-hover:text-kurk-600" aria-hidden="true">
    Bekijk →
  </span>
</a>

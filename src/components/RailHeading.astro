---
// Paginakop op de statische rail: meetpuntbol, korte vaste draad en eindpunt,
// zoals op de kalenderpagina. Voor pagina's zonder scroll-getekende draad.
// Met `continuous` valt het eindpunt weg en loopt de draad tot de onderrand,
// zodat de pagina hem zelf kan verderzetten (bv. de jaartijdlijn op /media/).
interface Props {
  title: string;
  intro?: string;
  continuous?: boolean;
  /**
   * Kleur van de draad. Clubrood is de levende site; kurk is het archief —
   * dezelfde vorm, andere temperatuur, zodat een oude pagina niet als nieuws leest.
   */
  accent?: 'club' | 'kurk';
}

const { title, intro, continuous = false, accent = 'club' } = Astro.props;
// Volledige klassennamen, want Tailwind leest de broncode statisch.
const dot = accent === 'kurk' ? 'bg-kurk-600' : 'bg-club-500';
const ring = accent === 'kurk' ? 'ring-veer-100' : 'ring-veer-50';
---

<div class="relative pl-10">
  <span class:list={['absolute left-[6px] top-3 h-3.5 w-3.5 -translate-x-1/2 rounded-full ring-4', dot, ring]} aria-hidden="true"></span>
  <span
    class:list={[
      'absolute left-[6px] top-7 w-1 -translate-x-1/2',
      dot,
      continuous ? 'bottom-0' : 'bottom-1 rounded-full',
    ]}
    aria-hidden="true"
  ></span>
  {!continuous && (
    <span class:list={['absolute bottom-0 left-[6px] h-2 w-2 -translate-x-1/2 rounded-full', dot]} aria-hidden="true"></span>
  )}
  <h1 class="stem-display kop-pagina text-inkt-950">{title}</h1>
  {intro && <p class="mt-3 max-w-2xl text-inkt-700">{intro}</p>}
  <slot />
</div>

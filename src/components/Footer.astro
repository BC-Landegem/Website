---
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import sponsors from '../data/sponsors.json';
import { channels } from '../data/sociaal';
import trainingen from '../data/trainingen.json';
import libertatem from '../assets/sponsors/libertatem.png';
import lieventyvaert from '../assets/sponsors/lieventyvaert.png';
import wema from '../assets/sponsors/wema.jpg';

const logos: Record<string, ImageMetadata> = { libertatem, lieventyvaert, wema };

// Beeldmerken van de sociale kanalen, als één pad op een 24-grid.
const socialPath: Record<string, string> = {
  facebook:
    'M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z',
  instagram:
    'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.8 3.8 0 0 1-1.38-.9 3.8 3.8 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zm0 6.5a3.34 3.34 0 1 0 0 6.68 3.34 3.34 0 0 0 0-6.68zm0 5.51a2.17 2.17 0 1 1 0-4.34 2.17 2.17 0 0 1 0 4.34zm4.25-5.64a.78.78 0 1 1-1.56 0 .78.78 0 0 1 1.56 0z',
};
const year = new Date().getFullYear();
---

<footer class="bg-inkt-950 text-veer-200">
  {/* Sponsors */}
  <div class="border-b border-veer-50/10">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <h2 class="stem-baan mb-6 text-center text-xs text-veer-200/70">
        Met dank aan onze sponsors
      </h2>
      <ul class="flex flex-wrap items-center justify-center gap-5">
        {sponsors.map((sponsor) => (
          <li>
            <a
              href={sponsor.url}
              target="_blank"
              rel="noopener"
              class="flex h-28 w-64 items-center justify-center rounded-2xl bg-white px-6 transition hover:ring-2 hover:ring-club-500"
            >
              <Image
                src={logos[sponsor.logo]}
                alt={sponsor.naam}
                height={sponsor.hoogte * 2}
                class="w-auto max-w-full object-contain"
                style={`height: ${sponsor.hoogte}px`}
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div
    class:list={[
      'mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2',
      channels.length > 0 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
    ]}
  >
    <div>
      <h2 class="stem-baan mb-3 text-xs text-white">BC Landegem</h2>
      <p class="text-sm leading-relaxed">
        Badmintonclub Landegem — recreatief en competitief badminton voor jong en oud, sinds 1987.
      </p>
    </div>
    <div>
      <h2 class="stem-baan mb-3 text-xs text-white">Waar we spelen</h2>
      <p class="text-sm leading-relaxed">
        {trainingen.locatie.naam}<br />
        {trainingen.locatie.adres}<br />
        {trainingen.locatie.gemeente}
      </p>
    </div>
    {channels.length > 0 && (
      <div>
        <h2 class="stem-baan mb-3 text-xs text-white">Volg de club</h2>
        <ul class="flex flex-wrap gap-3">
          {channels.map((channel) => (
            <li>
              <a
                href={channel.url}
                target="_blank"
                rel="noopener"
                title={channel.naam}
                class="flex h-11 w-11 items-center justify-center rounded-full border border-veer-50/20 transition-colors hover:border-club-400 hover:text-club-300"
              >
                <span class="sr-only">{channel.naam}</span>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={socialPath[channel.icoon]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <nav aria-label="Footer">
      <h2 class="stem-baan mb-3 text-xs text-white">Snel naar</h2>
      <ul class="space-y-2 text-sm">
        <li><a href={url('/club/word-lid/')} class="transition-colors hover:text-club-300">Word lid!</a></li>
        <li><a href={url('/kalender/')} class="transition-colors hover:text-club-300">Kalender</a></li>
        <li><a href={url('/club/contact/')} class="transition-colors hover:text-club-300">Contact</a></li>
        <li><a href={url('/club/gedragscode/')} class="transition-colors hover:text-club-300">Gedragscode</a></li>
        <li><a href={url('/club/privacy/')} class="transition-colors hover:text-club-300">Privacy</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-veer-50/10">
    <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-veer-200/60">
      © {year} Badmintonclub Landegem
    </p>
  </div>
</footer>

---
// Sectiekop in de displaystem, met optioneel de rode aanloop erboven (dag,
// reeks, stap). De maat is een ladder van drie, niet een vrij getal: dat houdt
// de koppenhiërarchie over de pagina's heen gelijk.
interface Props {
  as?: 'h2' | 'h3' | 'h4';
  maat?: 'groot' | 'normaal' | 'klein';
  /** Kleine rode aanloop boven de kop, bv. "Woensdagavond" of "Stap 2". */
  bovenkop?: string;
  /**
   * `wit` op een donkere ondergrond, `erft` wanneer de omliggende sectie de
   * tekstkleur al zet (zoals de rode banden) en de kop die moet overnemen.
   */
  kleur?: 'inkt' | 'wit' | 'erft';
  class?: string;
}

const { as: Tag = 'h2', maat = 'normaal', bovenkop, kleur = 'inkt', class: extra } = Astro.props;

// Volledige klassennamen, want Tailwind leest de broncode statisch.
const maten = {
  groot: 'text-4xl sm:text-5xl',
  normaal: 'text-3xl sm:text-4xl',
  klein: 'text-2xl sm:text-3xl',
};
const kleuren = { inkt: 'text-inkt-950', wit: 'text-white', erft: '' };
---

{bovenkop && <p class="stem-baan text-xs text-club-700">{bovenkop}</p>}
<Tag class:list={['stem-display', maten[maat], kleuren[kleur], bovenkop && 'mt-1', extra]}><slot /></Tag>

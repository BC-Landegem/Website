---
import { url } from '../lib/url';

/**
 * Zoeken in het archief, op Pagefind.
 *
 * Pagefind bouwt zijn index ná `astro build`, over de HTML in dist/ — zie het
 * build-script in package.json. In dev bestaat die index dus niet; het veld
 * zegt dat dan gewoon en blijft verder stil.
 *
 * Alleen archiefartikels worden geïndexeerd: zij dragen `data-pagefind-body`,
 * en zodra één pagina dat attribuut heeft slaat Pagefind alle pagina's zonder
 * over. De navigatie en footer van de site blijven zo uit de resultaten.
 */
const pagefindPad = url('/pagefind/pagefind.js');
---

<search class="mt-10">
  <label for="archief-zoek" class="stem-baan block text-xs text-inkt-500"> Zoek in 837 artikels </label>
  <div class="relative mt-2">
    <input
      type="search"
      id="archief-zoek"
      autocomplete="off"
      placeholder="een naam, een ploeg, een tegenstander…"
      class="w-full border-b-2 border-inkt-950/20 bg-transparent py-3 pr-10 text-lg text-inkt-950 placeholder:text-inkt-500/60 focus:border-kurk-600 focus:outline-none"
    />
    <span
      id="archief-zoek-bezig"
      hidden
      class="absolute right-1 top-1/2 h-4 w-4 -translate-y-1/2 animate-spin rounded-full border-2 border-kurk-300 border-t-kurk-600"
      aria-hidden="true"></span>
  </div>

  <p id="archief-zoek-status" class="mt-3 text-sm text-inkt-500" role="status" aria-live="polite"></p>
  <ol id="archief-zoek-resultaten" class="mt-6 space-y-6"></ol>
</search>

<style>
  /* Pagefind zet <mark> rond de treffers; de standaard-geel van de browser
     hoort niet in deze wereld. Kurk onderstreept in plaats van te overschilderen. */
  #archief-zoek-resultaten :global(mark) {
    background: transparent;
    color: var(--color-inkt-950);
    font-weight: 700;
    box-shadow: inset 0 -0.35em 0 var(--color-kurk-300);
  }
</style>

<script is:inline define:vars={{ pagefindPad }}>
  (() => {
    const veld = document.getElementById('archief-zoek');
    const lijst = document.getElementById('archief-zoek-resultaten');
    const status = document.getElementById('archief-zoek-status');
    const bezig = document.getElementById('archief-zoek-bezig');
    if (!veld) return;

    let pagefind = null;
    let laden = null;
    let teller = 0;

    // Pas laden bij de eerste toetsaanslag: de index is een paar honderd kB en
    // wie alleen bladert heeft hem niet nodig.
    const zorgVoorIndex = () => {
      laden ??= import(/* @vite-ignore */ pagefindPad)
        .then(async (m) => {
          await m.init();
          pagefind = m;
        })
        .catch(() => {
          pagefind = false;
        });
      return laden;
    };

    const leeg = () => {
      lijst.replaceChildren();
      status.textContent = '';
    };

    const toon = (resultaten, vraag) => {
      lijst.replaceChildren();
      if (!resultaten.length) {
        status.textContent = `Niets gevonden voor "${vraag}".`;
        return;
      }
      status.textContent = `${resultaten.length === 40 ? '40+' : resultaten.length} resultaten voor "${vraag}".`;
      for (const r of resultaten) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = r.url;
        a.className = 'group block border-l-2 border-kurk-300 pl-4 hover:border-kurk-600';
        const titel = document.createElement('span');
        titel.className = 'stem-display block text-lg text-inkt-950 group-hover:text-kurk-600';
        titel.textContent = r.meta?.title || 'Zonder titel';
        const meta = document.createElement('span');
        meta.className = 'stem-baan mt-1 block text-[0.65rem] text-inkt-500';
        meta.textContent = [r.meta?.datum, r.meta?.auteur].filter(Boolean).join(' · ');
        const uittreksel = document.createElement('p');
        uittreksel.className = 'mt-1 text-sm text-inkt-700';
        // Pagefind levert het uittreksel met <mark> rond de treffers; dat is
        // zijn eigen opmaak, geen invoer van de bezoeker.
        uittreksel.innerHTML = r.excerpt;
        a.append(titel, meta, uittreksel);
        li.append(a);
        lijst.append(li);
      }
    };

    let wacht;
    veld.addEventListener('input', () => {
      clearTimeout(wacht);
      const vraag = veld.value.trim();
      if (vraag.length < 2) {
        leeg();
        return;
      }
      wacht = setTimeout(async () => {
        const beurt = ++teller;
        bezig.hidden = false;
        await zorgVoorIndex();
        if (beurt !== teller) return;
        if (!pagefind) {
          bezig.hidden = true;
          status.textContent =
            'Zoeken werkt pas in een echte build — de index wordt na het bouwen aangemaakt.';
          return;
        }
        const zoek = await pagefind.search(vraag);
        if (beurt !== teller) return;
        const data = await Promise.all(zoek.results.slice(0, 40).map((r) => r.data()));
        if (beurt !== teller) return;
        bezig.hidden = true;
        toon(data, vraag);
      }, 180);
    });
  })();
</script>

---
// De strook onderaan die zegt dat pushberichten bestaan. Eén zin, een link naar
// /club/pushberichten/ en een kruisje; nooit de browserprompt zelf (die komt
// pas bij het eerste vinkje op die pagina, zie PRODUCT.md). Staat op de
// startpagina en op /intraclub/: de twee plekken waar iemand die de app op zijn
// beginscherm heeft, binnenkomt.
//
// De strook verschijnt alleen voor wie terugkomt. Het signaal daarvoor is de
// service worker: bij een allereerste bezoek installeert hij nog en bestuurt hij
// de pagina niet (navigator.serviceWorker.controller is null); bij elk volgend
// bezoek, en dus zeker in de geïnstalleerde app, wél. Geen bezoekteller in
// localStorage nodig. Verder blijft ze weg voor wie al geabonneerd is, wie
// berichten geblokkeerd heeft, en in browsers zonder push.
//
// iOS in Safari zonder installatie is het geval apart: Apple geeft push daar
// alleen aan een app op het beginscherm. Dan zegt de strook niet "kies je
// berichten" maar "zet de site op je beginscherm", en wijst ze naar de stappen
// op de instellingenpagina. De tekst zit al in de HTML; het script kiest.
//
// Wegklikken onthoudt de datum in localStorage en zwijgt dan een half jaar: een
// seizoen ver, zodat wie in september opnieuw begint het nog één keer hoort.
// Doorklikken telt ook als gezien.
import Arrow from './Arrow.astro';
import { PUSH_ENABLED } from '../data/push';
import { url } from '../lib/url';

interface Props {
  /** De ene zin die zegt wat je krijgt. Per pagina anders. */
  text: string;
  /** Dezelfde zin voor iOS zonder installatie, waar de eerste stap het beginscherm is. */
  iosText?: string;
}

const {
  text,
  iosText = 'Zet de site op je beginscherm en krijg een seintje bij clubnieuws of een nieuwe intraclubstand.',
} = Astro.props;
---

{
  PUSH_ENABLED && (
    <aside
      id="push-nudge"
      hidden
      aria-label="Pushberichten"
      class="fixed inset-x-0 bottom-0 z-40 border-t-4 border-club-600 bg-ink-950 text-feather-50 shadow-[0_-8px_24px_rgba(0,0,0,0.18)]"
      style="padding-bottom: env(safe-area-inset-bottom)"
    >
      <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:gap-6">
        <p class="min-w-0 flex-1 text-sm font-medium leading-snug sm:text-base">
          <span id="push-nudge-default">
            {text}{' '}
            <a
              id="push-nudge-link"
              href={url('/club/pushberichten/')}
              class="type-label inline-flex items-center gap-1.5 whitespace-nowrap text-xs text-club-300 hover:text-white hover:underline"
            >
              Kies je berichten
              <Arrow class="h-3.5 w-3.5" />
            </a>
          </span>
          <span id="push-nudge-ios" hidden>
            {iosText}{' '}
            <a
              id="push-nudge-ios-link"
              href={url('/club/pushberichten/#instellingen')}
              class="type-label inline-flex items-center gap-1.5 whitespace-nowrap text-xs text-club-300 hover:text-white hover:underline"
            >
              Zo doe je dat
              <Arrow class="h-3.5 w-3.5" />
            </a>
          </span>
        </p>
        <button
          id="push-nudge-close"
          type="button"
          class="flex h-10 w-10 shrink-0 items-center justify-center text-feather-200 transition-colors hover:text-white"
          aria-label="Sluiten"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </button>
      </div>
    </aside>
  )
}

<script>
  import { permission, pushSupport } from '../lib/push-client';

  const STORAGE_KEY = 'push-nudge:dismissed-at';
  const SILENCE_MS = 180 * 24 * 60 * 60 * 1000;

  const nudge = document.getElementById('push-nudge');

  // localStorage kan ontbreken of gooien (privévenster, geblokkeerde sitedata).
  // Zonder geheugen liever geen strook dan een die elke keer terugkomt.
  const dismissedAt = (): number | null => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? Number(raw) || 0 : null;
    } catch {
      return 0;
    }
  };
  const dismiss = () => {
    try {
      localStorage.setItem(STORAGE_KEY, String(Date.now()));
    } catch {
      // Dan komt ze bij het volgende bezoek gewoon terug.
    }
    if (nudge) nudge.hidden = true;
  };

  // Welke variant er komt, of geen: 'default' met de vinkjes als volgende stap,
  // 'ios' met het beginscherm als volgende stap.
  const variant = async (): Promise<'default' | 'ios' | null> => {
    const support = pushSupport();
    if (support !== 'ok' && support !== 'ios-install') return null;
    // In Safari zonder installatie bestaat Notification niet, dus is er ook
    // niets geweigerd; die controle geldt alleen waar push echt kan.
    if (support === 'ok' && permission() === 'denied') return null;
    const since = dismissedAt();
    if (since === 0 || (since !== null && Date.now() - since < SILENCE_MS)) return null;
    // Wie hier voor het eerst is, heeft nog geen besturende worker: dan niet.
    if (!('serviceWorker' in navigator) || !navigator.serviceWorker.controller) return null;
    if (support === 'ios-install') return 'ios';
    const registration = await navigator.serviceWorker.getRegistration();
    if (!registration) return null;
    return (await registration.pushManager.getSubscription()) === null ? 'default' : null;
  };

  if (nudge) {
    variant()
      .then((which) => {
        if (!which) return;
        const ios = which === 'ios';
        const defaultText = document.getElementById('push-nudge-default');
        const iosText = document.getElementById('push-nudge-ios');
        if (defaultText) defaultText.hidden = ios;
        if (iosText) iosText.hidden = !ios;
        nudge.hidden = false;
        for (const id of ['push-nudge-close', 'push-nudge-link', 'push-nudge-ios-link']) {
          document.getElementById(id)?.addEventListener('click', dismiss);
        }
      })
      .catch(() => {
        // Een browser die halverwege struikelt, krijgt gewoon geen strook.
      });
  }
</script>

---
import Layout from '../layouts/Layout.astro';
import ArchiveLink from '../components/ArchiveLink.astro';
import RailHeading from '../components/RailHeading.astro';
import { url } from '../lib/url';

const tabs = [
  { key: 'general', label: 'Algemeen', kind: 'ranking' },
  { key: 'women', label: 'Dames', kind: 'ranking' },
  { key: 'recreants', label: 'Recreanten', kind: 'ranking' },
  { key: 'veterans', label: 'Veteranen', kind: 'ranking' },
  { key: 'speeldagen', label: 'Speeldagen', kind: 'speeldagen' },
  { key: 'aanwezigheden', label: 'Aanwezigheden', kind: 'aanwezigheden' },
];
---

<Layout
  title="Intraclub"
  description="De standen en uitslagen van de intraclubcompetitie van BC Landegem."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Intraclub"
      intro="Onze interne competitie: vier spelers per match, elke set een ander duo, het hele seizoen een klassement."
    >
      <a
        href={url('/intraclub/zo-werkt-het/')}
        class="stem-baan mt-5 inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline"
      >
        Zo werkt intraclub
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0l-6-6m6 6l-6 6" />
        </svg>
      </a>
    </RailHeading>

    <div
      id="intra-fout"
      role="alert"
      class="ml-10 mt-10 hidden max-w-3xl border-2 border-club-500 bg-club-50 p-4 font-medium text-club-800"
    >
      De standen konden niet geladen worden. Probeer het later opnieuw.
    </div>

    <p id="intra-laden" class="mt-10 flex items-center gap-3 pl-10 text-sm font-medium text-inkt-500" aria-live="polite">
      <span class="h-3.5 w-3.5 rounded-full bg-club-500 ring-4 ring-veer-50 motion-safe:animate-pulse" aria-hidden="true"></span>
      Standen laden…
    </p>

    <div id="intra-inhoud" class="mt-12 hidden max-w-3xl pl-10">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="stem-display text-2xl text-inkt-950 sm:text-3xl">Klassement</h2>
        <a id="intra-laatste" href="#" class="stem-baan hidden items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
          <span id="intra-laatste-tekst"></span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0l-6-6m6 6l-6 6" />
          </svg>
        </a>
      </div>

      <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Overzicht">
        {tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            data-tab={tab.key}
            data-soort={tab.kind}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="stem-baan rounded-full border-2 border-inkt-950/20 px-4 py-1.5 text-xs text-inkt-700 transition-colors hover:border-club-600 hover:text-club-600 aria-selected:border-club-600 aria-selected:bg-club-600 aria-selected:text-white"
          >
            {tab.label}
          </button>
        ))}
      </div>

      {/* Klassementen */}
      <div id="paneel-ranking" class="mt-8 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="stem-baan border-b border-inkt-950/10 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">#</th>
              <th class="py-2.5 pr-3 font-bold">Naam</th>
              <th class="py-2.5 pr-3 text-right font-bold">Gemiddelde</th>
              <th class="py-2.5 text-right font-bold">+/−</th>
            </tr>
          </thead>
          <tbody id="intra-tabel"></tbody>
        </table>
      </div>

      {/* Speeldagen */}
      <div id="paneel-speeldagen" class="mt-8 hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="stem-baan border-b border-inkt-950/10 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">Speeldag</th>
              <th class="py-2.5 pr-3 font-bold">Datum</th>
              <th class="py-2.5 pr-3 text-right font-bold">Spelers</th>
              <th class="py-2.5 text-right font-bold">Gem. afwezigen</th>
            </tr>
          </thead>
          <tbody id="intra-speeldagen"></tbody>
        </table>
      </div>

      {/* Aanwezigheden */}
      <div id="paneel-aanwezigheden" class="mt-8 hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="stem-baan border-b border-inkt-950/10 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">#</th>
              <th class="py-2.5 pr-3 font-bold">Naam</th>
              <th class="py-2.5 pr-3 text-right font-bold">Aanwezig</th>
              <th class="py-2.5 text-right font-bold">Gewonnen sets</th>
            </tr>
          </thead>
          <tbody id="intra-aanwezigheden"></tbody>
        </table>
      </div>
    </div>
  
    <div class="pl-10">
      <ArchiveLink group="intraclub" />
    </div>
  </div>
</Layout>

<script>
  import { fetchJson, fullName, playerUrl, speeldagUrl, formatDate, latestCalculatedRound } from '../lib/intra';
  import type { RankingRow, Rankings, Round } from '../lib/intra';

  interface PlayerStats {
    id: string; firstName: string; name: string;
    statistics: { rounds: { present: number }; sets: { won: number } };
  }

  const error = document.getElementById('intra-fout')!;
  const loading = document.getElementById('intra-laden')!;
  const content = document.getElementById('intra-inhoud')!;
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = {
    ranking: document.getElementById('paneel-ranking')!,
    speeldagen: document.getElementById('paneel-speeldagen')!,
    aanwezigheden: document.getElementById('paneel-aanwezigheden')!,
  };
  const tables = {
    ranking: document.getElementById('intra-tabel')!,
    speeldagen: document.getElementById('intra-speeldagen')!,
    aanwezigheden: document.getElementById('intra-aanwezigheden')!,
  };

  /*
   * De intra-API staat op shared hosting, praat HTTP/1.1 en wordt merkbaar
   * trager zodra ze meerdere verzoeken tegelijk krijgt: één call landt in
   * ~0,3 s, vier gelijktijdige calls in 1 tot 2,3 s. Deze pagina haalde vroeger
   * /rankings (alle vier de klassementen), /rounds, de seizoensstatistieken én
   * /rounds/latestCalculated op in één Promise.all — dus wachtte je op het
   * langzaamste van vier verzoeken die elkaar in de weg zaten, voor drie tabs
   * die je misschien nooit opent.
   *
   * Nu haalt ze bij het openen enkel het algemene klassement en /rounds op. De
   * andere klassementen en de aanwezigheden komen pas bij een klik op hun tab,
   * en elk antwoord verschijnt zodra het binnen is in plaats van te wachten op
   * de rest. /rounds/latestCalculated is helemaal weg: /rounds geeft de laatste
   * speeldag ook, en is tien keer kleiner.
   */
  const promises = new Map<string, Promise<unknown>>();
  function once<T>(path: string): Promise<T> {
    let promise = promises.get(path) as Promise<T> | undefined;
    if (!promise) {
      promise = fetchJson<T>(path);
      promises.set(path, promise);
    }
    return promise;
  }

  const playerLink = (row: { id: string; firstName: string; name: string }) =>
    `<a href="${playerUrl(row.id)}" class="font-medium hover:text-club-600 hover:underline">${fullName(row)}</a>`;

  // Richting zit in het teken; kleur blijft binnen het palet (daling = club-700)
  const arrowUp = '<svg class="-mt-0.5 inline h-2.5 w-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M5 1.5l4 7H1z"/></svg>';
  const arrowDown = '<svg class="-mt-0.5 inline h-2.5 w-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M5 8.5l-4-7h8z"/></svg>';

  // Alle drie de tabellen hebben vier kolommen, dus volstaat één meldingsrij.
  const messageRow = (text: string, color: string) =>
    `<tr><td colspan="4" class="py-4 text-sm ${color}">${text}</td></tr>`;

  function renderRanking(rows: RankingRow[]) {
    tables.ranking.innerHTML = rows
      .map((row) => {
        const diff = row.difference > 0
          ? `<span class="stem-cijfer text-inkt-950">${arrowUp} ${row.difference}</span>`
          : row.difference < 0
            ? `<span class="stem-cijfer text-club-700">${arrowDown} ${Math.abs(row.difference)}</span>`
            : '<span class="text-inkt-950/30">–</span>';
        return `<tr class="border-b border-inkt-950/10">
          <td class="stem-cijfer py-2.5 pr-3 text-club-700">${row.rank}</td>
          <td class="py-2.5 pr-3">${playerLink(row)}</td>
          <td class="stem-cijfer py-2.5 pr-3 text-right">${row.average.toFixed(2)}</td>
          <td class="py-2.5 text-right">${diff}</td>
        </tr>`;
      })
      .join('');
  }

  function renderSpeeldagen(rounds: Round[]) {
    tables.speeldagen.innerHTML = rounds
      .slice()
      .reverse()
      .map((round) => `<tr class="border-b border-inkt-950/10">
        <td class="py-2.5 pr-3"><a href="${speeldagUrl(round.id)}" class="font-semibold text-club-700 hover:text-club-800 hover:underline">Speeldag ${round.number}</a></td>
        <td class="py-2.5 pr-3">${formatDate(round.date)}</td>
        <td class="stem-cijfer py-2.5 pr-3 text-right">${parseInt(round.matches) * 4}</td>
        <td class="stem-cijfer py-2.5 text-right">${round.averageAbsent}</td>
      </tr>`)
      .join('');
  }

  function renderAttendance(stats: PlayerStats[]) {
    const sorted = stats.slice().sort((a, b) => {
      if (a.statistics.rounds.present === b.statistics.rounds.present) {
        return b.statistics.sets.won - a.statistics.sets.won;
      }
      return b.statistics.rounds.present - a.statistics.rounds.present;
    });
    tables.aanwezigheden.innerHTML = sorted
      .map((row, i) => `<tr class="border-b border-inkt-950/10">
        <td class="stem-cijfer py-2.5 pr-3 text-club-700">${i + 1}</td>
        <td class="py-2.5 pr-3">${playerLink(row)}</td>
        <td class="stem-cijfer py-2.5 pr-3 text-right">${row.statistics.rounds.present}</td>
        <td class="stem-cijfer py-2.5 text-right">${row.statistics.sets.won}</td>
      </tr>`)
      .join('');
  }

  function renderLatestSpeeldag(rounds: Round[]) {
    const latest = latestCalculatedRound(rounds);
    if (!latest) return;
    const link = document.getElementById('intra-laatste') as HTMLAnchorElement;
    link.href = speeldagUrl(latest.id);
    document.getElementById('intra-laatste-tekst')!.textContent =
      `Stand na speeldag ${latest.number} (${formatDate(latest.date)})`;
    link.classList.remove('hidden');
    link.classList.add('inline-flex');
  }

  /**
   * Vult het paneel van een tab, en haalt de data op als dat de eerste keer is.
   * `gekozen` houdt bij waar de bezoeker staat: klikt hij door terwijl een
   * antwoord onderweg is, dan mag dat antwoord de tabel niet meer overschrijven.
   */
  let selected = 'general';

  async function fillTab(key: string, kind: keyof typeof panels) {
    const path =
      kind === 'ranking' ? `/rankings/${key}`
      : kind === 'speeldagen' ? '/rounds'
      : '/seasons/latest/statistics';
    const table = tables[kind];
    // Nog niet opgehaald (dan staat er data van een andere categorie), of nog
    // leeg omdat het verzoek van bij het openen nog loopt: in beide gevallen
    // liever "Laden…" dan een verouderde of blanco tabel.
    if (!promises.has(path) || !table.children.length) {
      table.innerHTML = messageRow('Laden…', 'text-inkt-500');
    }

    try {
      if (kind === 'ranking') {
        const data = await once<Rankings>(path);
        if (selected !== key) return;
        renderRanking((data[key as keyof Rankings] as RankingRow[]) ?? []);
      } else if (kind === 'speeldagen') {
        const rounds = await once<Round[]>(path);
        if (selected !== key) return;
        renderSpeeldagen(rounds);
      } else {
        const stats = await once<PlayerStats[]>(path);
        if (selected !== key) return;
        renderAttendance(stats);
      }
    } catch {
      // Alleen deze tab is mislukt; de belofte weg, zodat een nieuwe klik
      // het opnieuw probeert in plaats van de fout te blijven herhalen.
      promises.delete(path);
      if (selected === key) {
        table.innerHTML = messageRow('Niet gelukt. Probeer het later opnieuw.', 'text-club-700');
      }
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const key = tab.dataset.tab!;
      const kind = tab.dataset.soort as keyof typeof panels;
      selected = key;
      for (const other of tabs) other.setAttribute('aria-selected', String(other === tab));
      for (const panel of Object.values(panels)) panel.classList.add('hidden');
      panels[kind].classList.remove('hidden');
      fillTab(key, kind);
    });
  }

  async function loadData() {
    // /rounds gaat wel meteen mee: het is het kleinste antwoord van de hele API
    // (0,3 kB gzip) en levert de regel "Stand na speeldag N" naast de kop. Het
    // klassement wacht er niet op — beide verschijnen los van elkaar.
    once<Round[]>('/rounds')
      .then(renderLatestSpeeldag)
      // Geen datumregel is geen ramp: het klassement blijft staan, en de
      // Speeldagen-tab probeert het opnieuw.
      .catch(() => promises.delete('/rounds'));

    try {
      const data = await once<Rankings>('/rankings/general');
      renderRanking(data.general ?? []);
      loading.classList.add('hidden');
      content.classList.remove('hidden');
    } catch {
      loading.classList.add('hidden');
      error.classList.remove('hidden');
    }
  }

  loadData();
</script>

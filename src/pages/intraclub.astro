---
import Layout from '../layouts/Layout.astro';
import RailKop from '../components/RailKop.astro';

const tabs = [
  { key: 'general', label: 'Algemeen', soort: 'ranking' },
  { key: 'women', label: 'Dames', soort: 'ranking' },
  { key: 'recreants', label: 'Recreanten', soort: 'ranking' },
  { key: 'veterans', label: 'Veteranen', soort: 'ranking' },
  { key: 'speeldagen', label: 'Speeldagen', soort: 'speeldagen' },
  { key: 'aanwezigheden', label: 'Aanwezigheden', soort: 'aanwezigheden' },
];
---

<Layout
  title="Intraclub"
  description="De standen en uitslagen van de intraclubcompetitie van BC Landegem."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailKop
      title="Intraclub"
      intro="Onze interne competitie: vier spelers per match, elke set een ander duo, het hele seizoen een klassement."
    />

    <div
      id="intra-fout"
      role="alert"
      class="ml-10 mt-10 hidden max-w-3xl border-2 border-club-500 bg-club-50 p-4 font-medium text-club-800"
    >
      De standen konden niet geladen worden. Probeer het later opnieuw.
    </div>

    <p id="intra-laden" class="mt-10 flex items-center gap-3 pl-10 text-sm font-medium text-inkt-500" aria-live="polite">
      <span class="h-3.5 w-3.5 rounded-full bg-club-500 ring-4 ring-veer-50 motion-safe:animate-pulse" aria-hidden="true"></span>
      Standen laden…
    </p>

    <div id="intra-inhoud" class="mt-12 hidden max-w-3xl pl-10">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="stem-display text-2xl text-inkt-950 sm:text-3xl">Klassement</h2>
        <a id="intra-laatste" href="#" class="stem-baan hidden items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
          <span id="intra-laatste-tekst"></span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0l-6-6m6 6l-6 6" />
          </svg>
        </a>
      </div>

      <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Overzicht">
        {tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            data-tab={tab.key}
            data-soort={tab.soort}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="stem-baan rounded-full border-2 border-inkt-950/20 px-4 py-1.5 text-xs text-inkt-700 transition-colors hover:border-club-600 hover:text-club-600 aria-selected:border-club-500 aria-selected:bg-club-500 aria-selected:text-white"
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Klassementen -->
      <div id="paneel-ranking" class="mt-8 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="stem-baan border-b border-inkt-950/10 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">#</th>
              <th class="py-2.5 pr-3 font-bold">Naam</th>
              <th class="py-2.5 pr-3 text-right font-bold">Gemiddelde</th>
              <th class="py-2.5 text-right font-bold">+/−</th>
            </tr>
          </thead>
          <tbody id="intra-tabel"></tbody>
        </table>
      </div>

      <!-- Speeldagen -->
      <div id="paneel-speeldagen" class="mt-8 hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="stem-baan border-b border-inkt-950/10 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">Speeldag</th>
              <th class="py-2.5 pr-3 font-bold">Datum</th>
              <th class="py-2.5 pr-3 text-right font-bold">Spelers</th>
              <th class="py-2.5 text-right font-bold">Gem. afwezigen</th>
            </tr>
          </thead>
          <tbody id="intra-speeldagen"></tbody>
        </table>
      </div>

      <!-- Aanwezigheden -->
      <div id="paneel-aanwezigheden" class="mt-8 hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="stem-baan border-b border-inkt-950/10 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">#</th>
              <th class="py-2.5 pr-3 font-bold">Naam</th>
              <th class="py-2.5 pr-3 text-right font-bold">Aanwezig</th>
              <th class="py-2.5 text-right font-bold">Gewonnen sets</th>
            </tr>
          </thead>
          <tbody id="intra-aanwezigheden"></tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { fetchJson, naam, spelerUrl, speeldagUrl, formatDatum } from '../lib/intra';
  import type { RankingRij } from '../lib/intra';

  interface Rankings {
    seasonId: number;
    [categorie: string]: RankingRij[] | number;
  }
  interface Ronde { id: string; number: string; date: string; matches: string; averageAbsent: string }
  interface Statistiek {
    id: string; firstName: string; name: string;
    statistics: { rounds: { present: number }; sets: { won: number } };
  }

  const fout = document.getElementById('intra-fout')!;
  const laden = document.getElementById('intra-laden')!;
  const inhoud = document.getElementById('intra-inhoud')!;
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panelen = {
    ranking: document.getElementById('paneel-ranking')!,
    speeldagen: document.getElementById('paneel-speeldagen')!,
    aanwezigheden: document.getElementById('paneel-aanwezigheden')!,
  };

  const spelerLink = (rij: { id: string; firstName: string; name: string }) =>
    `<a href="${spelerUrl(rij.id)}" class="font-medium hover:text-club-600 hover:underline">${naam(rij)}</a>`;

  // Richting zit in het teken; kleur blijft binnen het palet (daling = club-700)
  const pijlOp = '<svg class="-mt-0.5 inline h-2.5 w-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M5 1.5l4 7H1z"/></svg>';
  const pijlNeer = '<svg class="-mt-0.5 inline h-2.5 w-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M5 8.5l-4-7h8z"/></svg>';

  function toonRanking(rijen: RankingRij[]) {
    const tabel = document.getElementById('intra-tabel')!;
    tabel.innerHTML = rijen
      .map((rij) => {
        const diff = rij.difference > 0
          ? `<span class="stem-cijfer text-inkt-950">${pijlOp} ${rij.difference}</span>`
          : rij.difference < 0
            ? `<span class="stem-cijfer text-club-700">${pijlNeer} ${Math.abs(rij.difference)}</span>`
            : '<span class="text-inkt-950/30">–</span>';
        return `<tr class="border-b border-inkt-950/10">
          <td class="stem-cijfer py-2.5 pr-3 text-club-700">${rij.rank}</td>
          <td class="py-2.5 pr-3">${spelerLink(rij)}</td>
          <td class="stem-cijfer py-2.5 pr-3 text-right">${rij.average.toFixed(2)}</td>
          <td class="py-2.5 text-right">${diff}</td>
        </tr>`;
      })
      .join('');
  }

  function toonSpeeldagen(rondes: Ronde[]) {
    const tabel = document.getElementById('intra-speeldagen')!;
    tabel.innerHTML = rondes
      .slice()
      .reverse()
      .map((ronde) => `<tr class="border-b border-inkt-950/10">
        <td class="py-2.5 pr-3"><a href="${speeldagUrl(ronde.id)}" class="font-semibold text-club-700 hover:text-club-800 hover:underline">Speeldag ${ronde.number}</a></td>
        <td class="py-2.5 pr-3">${formatDatum(ronde.date)}</td>
        <td class="stem-cijfer py-2.5 pr-3 text-right">${parseInt(ronde.matches) * 4}</td>
        <td class="stem-cijfer py-2.5 text-right">${ronde.averageAbsent}</td>
      </tr>`)
      .join('');
  }

  function toonAanwezigheden(statistieken: Statistiek[]) {
    const gesorteerd = statistieken.slice().sort((a, b) => {
      if (a.statistics.rounds.present === b.statistics.rounds.present) {
        return b.statistics.sets.won - a.statistics.sets.won;
      }
      return b.statistics.rounds.present - a.statistics.rounds.present;
    });
    const tabel = document.getElementById('intra-aanwezigheden')!;
    tabel.innerHTML = gesorteerd
      .map((rij, i) => `<tr class="border-b border-inkt-950/10">
        <td class="stem-cijfer py-2.5 pr-3 text-club-700">${i + 1}</td>
        <td class="py-2.5 pr-3">${spelerLink(rij)}</td>
        <td class="stem-cijfer py-2.5 pr-3 text-right">${rij.statistics.rounds.present}</td>
        <td class="stem-cijfer py-2.5 text-right">${rij.statistics.sets.won}</td>
      </tr>`)
      .join('');
  }

  async function laadData() {
    try {
      const [rankings, rondes, statistieken, laatste] = await Promise.all([
        fetchJson<Rankings>('/rankings'),
        fetchJson<Ronde[]>('/rounds'),
        fetchJson<Statistiek[]>('/seasons/latest/statistics'),
        fetchJson<Ronde | false>('/rounds/latestCalculated'),
      ]);

      toonRanking(rankings.general as RankingRij[]);
      toonSpeeldagen(rondes);
      toonAanwezigheden(statistieken);

      if (laatste && laatste.id) {
        const link = document.getElementById('intra-laatste') as HTMLAnchorElement;
        link.href = speeldagUrl(laatste.id);
        document.getElementById('intra-laatste-tekst')!.textContent =
          `Stand na speeldag ${laatste.number} (${formatDatum(laatste.date)})`;
        link.classList.remove('hidden');
        link.classList.add('inline-flex');
      }

      for (const tab of tabs) {
        tab.addEventListener('click', () => {
          for (const andere of tabs) andere.setAttribute('aria-selected', 'false');
          tab.setAttribute('aria-selected', 'true');
          for (const paneel of Object.values(panelen)) paneel.classList.add('hidden');
          panelen[tab.dataset.soort as keyof typeof panelen].classList.remove('hidden');
          if (tab.dataset.soort === 'ranking') {
            toonRanking(rankings[tab.dataset.tab!] as RankingRij[]);
          }
        });
      }

      laden.classList.add('hidden');
      inhoud.classList.remove('hidden');
    } catch {
      laden.classList.add('hidden');
      fout.classList.remove('hidden');
    }
  }

  laadData();
</script>

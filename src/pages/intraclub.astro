---
import Layout from '../layouts/Layout.astro';
import Heading from '../components/Heading.astro';
import Pill from '../components/Pill.astro';
import Dot from '../components/Dot.astro';
import ArchiveLink from '../components/ArchiveLink.astro';
import RailHeading from '../components/RailHeading.astro';
import { url } from '../lib/url';

const tabs = [
  { key: 'general', label: 'Algemeen', kind: 'ranking' },
  { key: 'women', label: 'Dames', kind: 'ranking' },
  { key: 'recreants', label: 'Recreanten', kind: 'ranking' },
  { key: 'veterans', label: 'Veteranen', kind: 'ranking' },
  { key: 'matchdays', label: 'Speeldagen', kind: 'matchdays' },
  { key: 'attendance', label: 'Aanwezigheden', kind: 'attendance' },
];
---

<Layout
  title="Intraclub"
  description="De standen en uitslagen van de intraclubcompetitie van BC Landegem."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Intraclub"
      intro="Onze tweewekelijkse interne competitie: één match met vier spelers, elke set een andere combinatie van spelers die samen speelt, het hele seizoen een klassement."
    >
      <a
        href={url('/intraclub/zo-werkt-het/')}
        class="type-label mt-5 inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline"
      >
        Zo werkt intraclub
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0l-6-6m6 6l-6 6" />
        </svg>
      </a>
    </RailHeading>

    <div
      id="intra-error"
      role="alert"
      class="ml-10 mt-10 hidden max-w-3xl border-2 border-club-500 bg-club-50 p-4 font-medium text-club-800"
    >
      De standen konden niet geladen worden. Probeer het later opnieuw.
    </div>

    <p id="intra-loading" class="mt-10 flex items-center gap-3 pl-10 text-sm font-medium text-ink-500" aria-live="polite">
      <Dot pulses />
      Standen laden…
    </p>

    <div id="intra-content" class="mt-12 hidden max-w-3xl pl-10">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <Heading size="small">Klassement</Heading>
        <p id="intra-latest" class="type-label hidden text-xs text-club-700"></p>
      </div>

      <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Overzicht">
        {tabs.map((tab, i) => (
          <Pill
            role="tab"
            data-tab={tab.key}
            data-kind={tab.kind}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {tab.label}
          </Pill>
        ))}
      </div>

      {/* Klassementen */}
      <div id="panel-ranking" class="mt-8 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="type-label border-b-[3px] border-ink-950/20 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">#</th>
              <th class="w-full py-2.5 pr-3 font-bold">Naam</th>
              <th class="w-0 whitespace-nowrap py-2.5 pl-3 pr-1 text-center font-bold">Gemiddelde</th>
              <th class="w-0 whitespace-nowrap py-2.5 pl-1 text-right font-bold">
                <span class="inline-flex items-center justify-end gap-0.5" aria-label="Stijging en daling">
                  <svg class="-mt-0.5 inline h-2.5 w-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M5 1.5l4 7H1z"/></svg>
                  <span aria-hidden="true">/</span>
                  <svg class="-mt-0.5 inline h-2.5 w-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M5 8.5l-4-7h8z"/></svg>
                </span>
              </th>
            </tr>
          </thead>
          <tbody id="intra-table"></tbody>
        </table>
      </div>

      {/* Speeldagen */}
      <div id="panel-matchdays" class="mt-8 hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="type-label border-b-[3px] border-ink-950/20 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">Speeldag</th>
              <th class="py-2.5 pr-3 font-bold">Datum</th>
              <th class="py-2.5 pr-3 text-right font-bold">Spelers</th>
              <th class="py-2.5 text-right font-bold">Gem. afwezigen</th>
            </tr>
          </thead>
          <tbody id="intra-matchdays"></tbody>
        </table>
      </div>

      {/* Aanwezigheden */}
      <div id="panel-attendance" class="mt-8 hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="type-label border-b-[3px] border-ink-950/20 text-xs text-club-700">
              <th class="py-2.5 pr-3 font-bold">#</th>
              <th class="py-2.5 pr-3 font-bold">Naam</th>
              <th class="py-2.5 pr-3 font-bold">Aanwezig</th>
              <th class="py-2.5 text-right font-bold">Gewonnen sets</th>
            </tr>
          </thead>
          <tbody id="intra-attendance"></tbody>
        </table>
      </div>
    </div>

    <div class="pl-10">
      <ArchiveLink group="intraclub" />
    </div>
  </div>
</Layout>

<script>
  import { fetchJson, fullName, playerUrl, matchdayUrl, formatDate, lastCalculated } from '../lib/intra';
  import type { RankingRow, Rankings, Round } from '../lib/intra';

  interface Statistic {
    id: string; firstName: string; name: string;
    statistics: { rounds: { present: number }; sets: { won: number } };
  }

  const error = document.getElementById('intra-error')!;
  const loading = document.getElementById('intra-loading')!;
  const content = document.getElementById('intra-content')!;
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = {
    ranking: document.getElementById('panel-ranking')!,
    matchdays: document.getElementById('panel-matchdays')!,
    attendance: document.getElementById('panel-attendance')!,
  };
  const tables = {
    ranking: document.getElementById('intra-table')!,
    matchdays: document.getElementById('intra-matchdays')!,
    attendance: document.getElementById('intra-attendance')!,
  };

  /*
   * De intra-API staat op shared hosting, praat HTTP/1.1 en wordt merkbaar
   * trager zodra ze meerdere verzoeken tegelijk krijgt: één call landt in
   * ~0,3 s, vier gelijktijdige calls in 1 tot 2,3 s. Deze pagina haalde vroeger
   * /rankings (alle vier de klassementen), /rounds, de seizoensstatistieken én
   * /rounds/latestCalculated op in één Promise.all — dus wachtte je op het
   * langzaamste van vier verzoeken die elkaar in de weg zaten, voor drie tabs
   * die je misschien nooit opent.
   *
   * Nu haalt ze bij het openen enkel het algemene klassement en /rounds op. De
   * andere klassementen en de aanwezigheden komen pas bij een klik op hun tab,
   * en elk antwoord verschijnt zodra het binnen is in plaats van te wachten op
   * de rest. /rounds/latestCalculated is helemaal weg: /rounds geeft de laatste
   * speeldag ook, en is tien keer kleiner.
   */
  const promises = new Map<string, Promise<unknown>>();
  function fetchOnce<T>(path: string): Promise<T> {
    let promise = promises.get(path) as Promise<T> | undefined;
    if (!promise) {
      promise = fetchJson<T>(path);
      promises.set(path, promise);
    }
    return promise;
  }

  const playerLink = (row: { id: string; firstName: string; name: string }) =>
    `<a href="${playerUrl(row.id)}" class="font-medium hover:text-club-600 hover:underline">${fullName(row)}</a>`;

  // Richting zit in het teken; kleur blijft binnen het palet (daling = club-700)
  const arrowUp = '<svg class="-mt-0.5 inline h-2.5 w-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M5 1.5l4 7H1z"/></svg>';
  const arrowDown = '<svg class="-mt-0.5 inline h-2.5 w-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M5 8.5l-4-7h8z"/></svg>';

  // Alle drie de tabellen hebben vier kolommen, dus volstaat één meldingsrij.
  const message = (text: string, color: string) =>
    `<tr><td colspan="4" class="py-4 text-sm ${color}">${text}</td></tr>`;

  function renderRanking(rows: RankingRow[]) {
    tables.ranking.innerHTML = rows
      .map((row) => {
        const diff = row.difference > 0
          ? `<span class="type-numeral text-ink-950">${arrowUp} ${row.difference}</span>`
          : row.difference < 0
            ? `<span class="type-numeral text-club-700">${arrowDown} ${Math.abs(row.difference)}</span>`
            : '<span class="text-ink-950/30">–</span>';
        return `<tr class="border-b border-ink-950/10">
          <td class="type-numeral py-2.5 pr-3 text-club-700">${row.rank}</td>
          <td class="w-full py-2.5 pr-3">${playerLink(row)}</td>
          <td class="type-numeral w-0 whitespace-nowrap py-2.5 pl-3 pr-1 text-center">${row.average.toFixed(2)}</td>
          <td class="w-0 whitespace-nowrap py-2.5 pl-1 text-right">${diff}</td>
        </tr>`;
      })
      .join('');
  }

  function renderMatchdays(rounds: Round[]) {
    tables.matchdays.innerHTML = rounds
      .slice()
      .reverse()
      .map((round) => `<tr class="border-b border-ink-950/10">
        <td class="py-2.5 pr-3"><a href="${matchdayUrl(round.id)}" class="font-semibold text-club-700 hover:text-club-800 hover:underline">Speeldag ${round.number}</a></td>
        <td class="py-2.5 pr-3">${formatDate(round.date)}</td>
        <td class="type-numeral py-2.5 pr-3 text-right">${parseInt(round.matches) * 4}</td>
        <td class="type-numeral py-2.5 text-right">${round.averageAbsent}</td>
      </tr>`)
      .join('');
  }

  function percentage(part: number, total: number): number {
    return total > 0 ? Math.round((part / total) * 100) : 0;
  }

  function countCalculatedMatchdays(rounds: Round[]): number {
    return rounds.filter((round) => round.calculated === '1').length;
  }

  function renderAttendance(statistics: Statistic[], totalMatchdays: number) {
    const sorted = statistics.slice().sort((a, b) => {
      if (a.statistics.rounds.present === b.statistics.rounds.present) {
        return b.statistics.sets.won - a.statistics.sets.won;
      }
      return b.statistics.rounds.present - a.statistics.rounds.present;
    });
    tables.attendance.innerHTML = sorted
      .map((row, i) => `<tr class="border-b border-ink-950/10">
        <td class="type-numeral py-2.5 pr-3 text-club-700">${i + 1}</td>
        <td class="py-2.5 pr-3">${playerLink(row)}</td>
        <td class="type-numeral py-2.5 pr-3">${row.statistics.rounds.present} <span class="text-ink-500">(${percentage(row.statistics.rounds.present, totalMatchdays)}%)</span></td>
        <td class="type-numeral py-2.5 text-right">${row.statistics.sets.won}</td>
      </tr>`)
      .join('');
  }

  function renderLatestMatchday(rounds: Round[]) {
    const latest = lastCalculated(rounds);
    if (!latest) return;
    const line = document.getElementById('intra-latest')!;
    line.innerHTML = `Stand na <a href="${matchdayUrl(latest.id)}" class="font-semibold text-club-700 hover:text-club-800 hover:underline">speeldag ${latest.number} (${formatDate(latest.date)})</a>`;
    line.classList.remove('hidden');
  }

  /**
   * Vult het paneel van een tab, en haalt de data op als dat de eerste keer is.
   * `selected` houdt bij waar de bezoeker staat: klikt hij door terwijl een
   * antwoord onderweg is, dan mag dat antwoord de tabel niet meer overschrijven.
   */
  let selected = 'general';

  async function fillTab(key: string, kind: keyof typeof panels) {
    const path =
      kind === 'ranking' ? `/rankings/${key}`
      : kind === 'matchdays' ? '/rounds'
      : '/seasons/latest/statistics';
    const table = tables[kind];
    // Nog niet opgehaald (dan staat er data van een andere categorie), of nog
    // leeg omdat het verzoek van bij het openen nog loopt: in beide gevallen
    // liever "Laden…" dan een verouderde of blanco tabel.
    if (!promises.has(path) || !table.children.length) {
      table.innerHTML = message('Laden…', 'text-ink-500');
    }

    try {
      if (kind === 'ranking') {
        const data = await fetchOnce<Rankings>(path);
        if (selected !== key) return;
        renderRanking((data[key as keyof Rankings] as RankingRow[]) ?? []);
      } else if (kind === 'matchdays') {
        const rounds = await fetchOnce<Round[]>(path);
        if (selected !== key) return;
        renderMatchdays(rounds);
      } else {
        const [statistics, rounds] = await Promise.all([
          fetchOnce<Statistic[]>(path),
          fetchOnce<Round[]>('/rounds'),
        ]);
        if (selected !== key) return;
        renderAttendance(statistics, countCalculatedMatchdays(rounds));
      }
    } catch {
      // Alleen deze tab is mislukt; de belofte weg, zodat een nieuwe klik
      // het opnieuw probeert in plaats van de fout te blijven herhalen.
      promises.delete(path);
      if (selected === key) {
        table.innerHTML = message('Niet gelukt. Probeer het later opnieuw.', 'text-club-700');
      }
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const key = tab.dataset.tab!;
      const kind = tab.dataset.kind as keyof typeof panels;
      selected = key;
      for (const other of tabs) other.setAttribute('aria-selected', String(other === tab));
      for (const panel of Object.values(panels)) panel.classList.add('hidden');
      panels[kind].classList.remove('hidden');
      fillTab(key, kind);
    });
  }

  async function loadData() {
    // /rounds gaat wel meteen mee: het is het kleinste antwoord van de hele API
    // (0,3 kB gzip) en levert de regel "Stand na speeldag N" naast de kop. Het
    // klassement wacht er niet op — beide verschijnen los van elkaar.
    fetchOnce<Round[]>('/rounds')
      .then(renderLatestMatchday)
      // Geen datumregel is geen ramp: het klassement blijft staan, en de
      // Speeldagen-tab probeert het opnieuw.
      .catch(() => promises.delete('/rounds'));

    try {
      const data = await fetchOnce<Rankings>('/rankings/general');
      renderRanking(data.general ?? []);
      loading.classList.add('hidden');
      content.classList.remove('hidden');
    } catch {
      loading.classList.add('hidden');
      error.classList.remove('hidden');
    }
  }

  loadData();
</script>

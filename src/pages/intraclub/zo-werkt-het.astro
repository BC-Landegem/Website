---
import Layout from '../../layouts/Layout.astro';
import Heading from '../../components/Heading.astro';
import Pill from '../../components/Pill.astro';
import Dot from '../../components/Dot.astro';
import RailHeading from '../../components/RailHeading.astro';
import { url } from '../../lib/url';
import example from '../../data/intraclub-example.json';
import {
  absenteeScore,
  bands,
  dayScore,
  formatComma,
  newAverage,
  SET_LINEUP,
  isHomeSide,
  opponentPoints,
  trimSet,
  lead,
  fullName,
  type Court,
  type Player,
} from '../../lib/intra-explainer';

// Alles op deze pagina komt uit één bevroren speeldag: src/data/intraclub-example.json,
// geschreven door scripts/intra-snapshot.mjs. Echte spelers, echte loting, echte
// uitslagen. Er gaat geen enkel request uit — de pagina is volledig gerenderd en
// alle interactie is rekenwerk op die data, ook zonder bereik in de sporthal.
// Zonder JavaScript blijft precies dit startbeeld staan: één speler, set 1, de
// echte uitslag. Daarom worden alle cijfers hieronder ook hier al berekend.
const players = example.players as Player[];
const courts = example.courts as Court[];
const { matchday, matchdaysPlayed, playersInRanking } = example;

// Voor de loting telt de volgorde van de avond zelf: de stand ná de vórige speeldag.
const byStrength = [...players].sort((a, b) => a.rankOnEvening - b.rankOnEvening);
const count = byStrength.length;
const { upperEnd, lowerStart } = bands(count);
const positionById = new Map(byStrength.map((player, i) => [player.id, i]));
const playerById = new Map(players.map((player) => [player.id, player]));

const groups = [
  { kind: 'upper', heading: 'Alleen de bovenste groep', players: byStrength.slice(0, lowerStart) },
  { kind: 'overlap', heading: 'In beide groepen', players: byStrength.slice(lowerStart, upperEnd) },
  { kind: 'lower', heading: 'Alleen de onderste groep', players: byStrength.slice(upperEnd) },
] as const;

const courtById = new Map<string, Court>();
for (const court of courts) for (const id of court.players) courtById.set(id, court);

/** Uit welke band een échte baan van die avond getrokken is. */
function sourceOf(court: Court) {
  const positions = court.players.map((id) => positionById.get(id)!);
  if (positions.every((p) => p < upperEnd)) return 'upper';
  if (positions.every((p) => p >= lowerStart)) return 'lower';
  return 'rest';
}
const actualSources = courts.map(sourceOf);
const restCourtNumber = actualSources.indexOf('rest') + 1;
const hasRestCourt = restCourtNumber > 0;

// De speler die het verhaal draagt tot je zelf iemand kiest: iemand uit de
// overlapband — die laat zien dat je naar boven én naar onder geloot kan worden —
// die bovendien een set in verlenging speelde, want daarop draait stap 4.
const inOverlap = new Set(groups[1].players.map((s) => s.id));
const start =
  byStrength.find(
    (s) => inOverlap.has(s.id) && courtById.get(s.id)!.sets.some(([h, a]) => h > 21 || a > 21),
  ) ?? byStrength[0];

const startCourt = courtById.get(start.id)!;
const startCourtNumber = courts.indexOf(startCourt) + 1;
const startPosition = startCourt.players.indexOf(start.id);
const startCourtPlayers = startCourt.players.map((id) => playerById.get(id)!);
const startBonuses = startCourtPlayers.map((s) => s.bonus);

// Stap 3, set 1: wie met wie, en met welke voorsprong.
const pairNames = (positions: readonly number[]) =>
  positions.map((p) => fullName(startCourtPlayers[p])).join(' & ');
const startLead = lead(startBonuses, 0);
const startGap = Math.max(startLead.home, startLead.away);
const startLeadingPair =
  startLead.home > 0
    ? pairNames(SET_LINEUP[0].home)
    : startLead.away > 0
      ? pairNames(SET_LINEUP[0].away)
      : null;

// Stap 4: de echte sets van deze speler, en wat ze opleveren.
const startSets = [0, 1, 2].map((set) => {
  const [home, away] = startCourt.sets[set];
  const own = isHomeSide(startPosition, set) ? home : away;
  const other = isHomeSide(startPosition, set) ? away : home;
  return { won: own > other, points: own, counted: trimSet(own, other) };
});
const startScore = dayScore(startSets.map((s) => s.counted));
const startAverage = newAverage(start.previousAverage, startScore, matchdaysPlayed);

const absent = absenteeScore(courts);
const dateText = new Date(matchday.date).toLocaleDateString('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const bonusRules = [
  { who: 'Dame', points: '+2' },
  { who: 'Speelt geen competitie', points: '+5' },
  { who: 'Dubbelklassement 11 of 12', points: '+4' },
  { who: 'Dubbelklassement 9 of 10', points: '+3' },
  { who: 'Dubbelklassement 7 of 8', points: '+2' },
  { who: 'Dubbelklassement 5 of 6', points: '+1' },
  { who: 'Dubbelklassement 1 tot 4', points: '0' },
];

const sourceLabel = { upper: 'bovenste groep', lower: 'onderste groep', rest: 'restbaan' } as const;
const arrowPath = 'M4 12h16m0 0l-6-6m6 6l-6 6';
---

<Layout
  title="Zo werkt intraclub"
  description="Hoe de loting, de bonuspunten en het klassement van de intraclub werken. Uitgelegd met de namen en de uitslagen van een echte speeldag."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Zo werkt intraclub"
      intro={`Om de twee weken is het woensdag intraclub. Je wordt bij drie andere spelers geloot, je speelt drie sets met telkens een andere partner, en achteraf wordt je plaats in het klassement bijgewerkt. Hieronder staat wat er die avond gebeurt, met de cijfers van speeldag ${matchday.number}.`}
      continuous
    >
      <p class="mt-4 max-w-2xl text-sm text-ink-500">
        Alle namen, uitslagen en cijfers hieronder komen van {dateText}: {count} spelers,
         {courts.length} banen. Verzet gerust wat je wil, aan de echte stand verandert er niets.
      </p>
    </RailHeading>

    {/* De container is max-w-6xl zoals elke andere pagina, zodat de rail links op
        dezelfde lijn staat. De inhoud zelf blijft smaller en lijnt links uit. */}
    <div class="mt-16 max-w-4xl space-y-16">
      {/* ─────────────────────────── STAP 1 ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-0 left-[6px] w-1 -translate-x-1/2 bg-club-500" aria-hidden="true"></span>
        <Dot top="top-2" />

        <Heading eyebrow="Stap 1 · vóór 20u30">Je meldt je aan</Heading>
        <p class="mt-4 max-w-2xl text-ink-700">
          In de sporthal staat een tablet. Wie meespeelt, tikt zijn naam aan. Om 20u30 gaat de lijst
          dicht en staat vast wie er die avond bij is.
        </p>

        {/* De tablet uit de sporthal, en meteen de spelerkiezer: kies je eigen naam
             en de rest van de pagina rekent verder met jou. */}
        <div class="mt-8 max-w-md border-2 border-ink-950 bg-white p-1.5 shadow-[6px_6px_0_0_var(--color-ink-950)]">
          <div class="border border-ink-950/10 bg-feather-50 p-5">
            <p class="type-label text-xs text-club-700">Aanwezig op {dateText}</p>
            <p class="type-display mt-1 text-4xl text-ink-950">
              {count}<span class="text-2xl text-ink-500"> spelers</span>
            </p>
            <label for="player-select" class="type-label mt-5 block text-xs text-ink-500">
              Speel je zelf mee? Kies je naam
            </label>
            <select
              id="player-select"
              class="mt-2 w-full border-2 border-ink-950/20 bg-white px-3 py-2.5 text-sm text-ink-950 transition-colors hover:border-club-600 focus:border-club-500"
            >
              {byStrength.map((player) => (
                <option value={player.id} selected={player.id === start.id}>
                  {fullName(player)}
                </option>
              ))}
            </select>
            <p class="mt-3 text-xs text-ink-500">
              Staat je naam er niet bij, dan speelde je die avond niet mee. Lees gewoon verder met de
              speler die er staat.
            </p>
          </div>
        </div>
      </section>

      {/* ─────────────────────────── STAP 2 ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-0 left-[6px] w-1 -translate-x-1/2 bg-club-500" aria-hidden="true"></span>
        <Dot top="top-2" />

        <Heading eyebrow="Stap 2 · 20u30">De loting</Heading>
        <p class="mt-4 max-w-2xl text-ink-700">
          De aanwezigen worden op sterkte gezet en in twee groepen verdeeld. Elke groep beslaat 60% van
          de aanwezigen: de eerste groep vanaf de best gerangschikte speler naar beneden, de tweede groep vanaf de laatst gerangschikte speler naar boven. Wie in de middelste
          20% valt, zit dus in allebei de groepen en kan naar boven én naar onder geloot worden.
        </p>
        <p class="mt-3 max-w-2xl text-ink-700">
          Daarna trekt de computer beurtelings vier namen uit de bovenste groep en vier uit de onderste,
          tot er in geen van beide groepen nog vier namen overblijven. Wie geloot is, verdwijnt uit
          allebei de groepen. Zo speel je zelden ver boven of onder je eigen niveau, en sta je toch
          bijna elke speeldag met andere mensen op de baan.
        </p>

        {/* De pot: iedereen die aanwezig was, op sterkte, met de overlap als eigen baan. */}
        <div class="mt-8">
          <p class="type-label text-xs text-ink-500">
            De {count} aanwezigen, op rangschikking
            <span class="text-ink-950/40">· de stand zoals die vóór deze speeldag was</span>
          </p>
          <p class="mt-1 text-xs text-ink-500">
            Wijs een baan aan of tik erop om te zien waar die vier spelers vandaan komen.
          </p>
          <div class="mt-3 border border-ink-950/10">
            {groups.map((group) => (
              <div
                class:list={[
                  'px-3 py-3',
                  group.kind === 'overlap' ? 'border-y-2 border-club-500/30 bg-club-50' : 'bg-white',
                ]}
              >
                <p class="type-label text-[0.65rem] text-club-700">
                  {group.heading}
                  <span class="text-ink-500">
                    {' · '}plaats {group.players[0].rankOnEvening}–{group.players[group.players.length - 1].rankOnEvening}
                  </span>
                </p>
                <div class="mt-2 flex flex-wrap gap-1">
                  {group.players.map((player) => (
                    <span
                      data-chip={player.id}
                      class:list={[
                        'border px-2 py-1 text-xs leading-tight transition-colors',
                        player.id === start.id
                          ? 'border-club-500 bg-club-100 font-bold text-ink-950'
                          : 'border-ink-950/15 bg-white text-ink-700',
                      ]}
                    ><span class="type-numeral text-club-700">{player.rankOnEvening}.</span> {fullName(player)}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button
            id="draw-again"
            type="button"
            class="type-label inline-flex items-center gap-2 rounded-full bg-club-600 px-6 py-3 text-sm text-white transition-colors hover:bg-club-700"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M20 9A8 8 0 006.3 5.3M4 15a8 8 0 0013.7 3.7" />
            </svg>
            Loot opnieuw
          </button>
          <button
            id="show-actual"
            type="button"
            class="type-label rounded-full border-2 border-ink-950/20 px-6 py-2.5 text-sm text-ink-700 transition-colors hover:border-club-600 hover:text-club-600"
          >
            Toon de echte loting
          </button>
        </div>

        <p id="draw-caption" class="mt-4 text-sm text-ink-500" aria-live="polite">
          Zo zag de loting van {dateText} er echt uit.
        </p>

        <div class="mt-5 grid gap-2 sm:grid-cols-2">
          {courts.map((court, i) => (
            <div
              data-court={i}
              tabindex="0"
              role="button"
              aria-pressed="false"
              class="flight landed cursor-pointer border border-ink-950/10 bg-white p-3 transition-colors hover:border-club-500 focus-visible:border-club-500"
            >
              <p class="flex items-baseline justify-between gap-2">
                <span class="type-label text-[0.65rem] text-club-700">Baan {i + 1}</span>
                <span data-source class="type-label text-[0.65rem] text-ink-500">{sourceLabel[actualSources[i]]}</span>
              </p>
              <p class="mt-1.5 text-[0.8rem] leading-snug text-ink-700">
                {court.players.map((id, position) => (
                  <>
                    {position > 0 && <span class="text-ink-950/30"> · </span>}
                    <span
                      data-position={position}
                      class:list={id === start.id ? 'font-bold text-club-700' : undefined}
                    >{fullName(playerById.get(id)!)}</span>
                  </>
                ))}
              </p>
            </div>
          ))}
        </div>

        <p class="mt-5 max-w-2xl text-sm text-ink-500">
          De twee groepen lopen zelden gelijk leeg. De spelers uit de middelste 20% worden nu eens naar
          boven, dan weer naar onder geloot, en daardoor blijft er op de meeste speeldagen een handvol
          namen over — ook wanneer het aantal aanwezigen netjes door vier deelt. Die komen samen op de
          <strong class="font-bold text-ink-700">restbaan</strong>, de enige baan waar de sterkste en
          de zwakste van de zaal naast elkaar kunnen staan.
          {hasRestCourt ? (
            <> Op {dateText} was dat baan {restCourtNumber}.</>
          ) : (
            <> Op {dateText} viel dat niet voor: alle {count} aanwezigen pasten precies op banen.</>
          )}
        </p>
        <p class="mt-3 max-w-2xl text-sm text-ink-500">
          Blijven er minder dan vier namen over, dan wordt de baan aangevuld door iemand die al gespeeld
          heeft. Die tweede match telt niet mee voor de rangschikking: wie de baan mee helpt vol maken,
          speelt voor het plezier.
        </p>
      </section>

      {/* ─────────────────────────── STAP 3 ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-0 left-[6px] w-1 -translate-x-1/2 bg-club-500" aria-hidden="true"></span>
        <Dot top="top-2" />

        <Heading eyebrow="Stap 3 · op de baan">Drie sets, elke keer een ander duo</Heading>
        <p class="mt-4 max-w-2xl text-ink-700">
          Op je baan staan vier spelers en er worden drie sets gespeeld. Met elk van de drie anderen
          speel je één set samen, tegen elk van hen speel je twee sets. Wie je partner is, weegt dus
          even zwaar door als wie tegenover je staat.
        </p>
        <p class="mt-3 max-w-2xl text-ink-700">
          Elke speler brengt ook bonuspunten mee. Per duo worden die samengeteld en het verschil tussen
          de twee duo's is de voorsprong waarmee de set begint. Omdat de duo's elke set veranderen,
          verandert die voorsprong mee: dezelfde vier spelers starten drie keer anders.
        </p>

        <div class="mt-8 border border-ink-950/10 bg-white">
          <div class="border-b border-ink-950/10 bg-feather-50 px-4 py-3">
            <p class="type-label text-[0.65rem] text-ink-500">
              <span id="court-title">Baan {startCourtNumber}</span> · {dateText}
            </p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {startCourtPlayers.map((player, position) => (
                <span
                  data-court-player={position}
                  class:list={[
                    'border px-2 py-1 text-[0.8rem] leading-tight',
                    player.id === start.id
                      ? 'border-club-500 bg-club-100 font-bold text-ink-950'
                      : 'border-ink-950/15 text-ink-700',
                  ]}
                >
                  <span data-name>{fullName(player)}</span>
                  <span data-bonus class="type-numeral ml-1 text-club-700">{player.bonus}</span>
                </span>
              ))}
            </div>
          </div>

          <div class="px-4 py-5">
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Set">
              {[0, 1, 2].map((set) => (
                <Pill
                  role="tab"
                  data-set-tab={set}
                  aria-selected={set === 0 ? 'true' : 'false'}
                >
                  Set {set + 1}
                </Pill>
              ))}
            </div>

            {/* Het scorebord: twee duo's met hun opgetelde bonus, en de stand waarmee ze starten. */}
            <div class="mt-6 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3">
              <div class="text-right">
                <p id="pair-home" class="text-sm leading-snug text-ink-950">{pairNames(SET_LINEUP[0].home)}</p>
                <p class="type-label mt-1 text-[0.65rem] text-ink-500">
                  bonus <span id="bonus-home" class="type-numeral text-club-700">{startLead.homeBonus}</span>
                </p>
              </div>
              <p class="type-numeral bg-feather-100 px-4 py-2 text-center text-2xl text-ink-950">
                <span id="start-home">{startLead.home}</span><span class="text-ink-950/30"> – </span><span id="start-away">{startLead.away}</span>
              </p>
              <div>
                <p id="pair-away" class="text-sm leading-snug text-ink-950">{pairNames(SET_LINEUP[0].away)}</p>
                <p class="type-label mt-1 text-[0.65rem] text-ink-500">
                  bonus <span id="bonus-away" class="type-numeral text-club-700">{startLead.awayBonus}</span>
                </p>
              </div>
            </div>
            <p id="lead-explainer" class="mt-3 text-center text-sm text-ink-500">
              {startLeadingPair
                ? `${startLead.homeBonus} tegen ${startLead.awayBonus} bonuspunten: ${startLeadingPair} begint ${startGap} punt${startGap === 1 ? '' : 'en'} voor.`
                : 'Even veel bonuspunten aan beide kanten: deze set begint op nul.'}
            </p>

            <p class="type-label mt-6 text-[0.65rem] text-ink-500">De echte uitslag van deze set</p>
            <p class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span id="actual-result" class="type-numeral text-2xl text-ink-950">
                {startCourt.sets[0][0]} – {startCourt.sets[0][1]}
              </span>
              <span id="actual-winner" class="text-sm text-ink-500">
                {pairNames(startCourt.sets[0][0] > startCourt.sets[0][1] ? SET_LINEUP[0].home : SET_LINEUP[0].away)} wonnen
              </span>
            </p>
          </div>
        </div>

        <details class="mt-5 max-w-2xl border-l-2 border-club-500/30 pl-4">
          <summary class="type-label cursor-pointer text-xs text-club-700 hover:text-club-800">
            Waar komt dat bonuscijfer vandaan?
          </summary>
          <p class="mt-3 text-sm text-ink-700">
            Wie op papier zwakker staat, begint elke set met een voorsprong. Zo blijft het voor alle
            vier spelers spannend. De club telt op:
          </p>
          <table class="mt-3 w-full max-w-sm text-left text-sm">
            <tbody>
              {bonusRules.map((rule) => (
                <tr class="border-b border-ink-950/10">
                  <td class="py-1.5 pr-3 text-ink-700">{rule.who}</td>
                  <td class="type-numeral py-1.5 text-right text-ink-950">{rule.points}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 text-sm text-ink-500">
            Het dubbelklassement is dat van Badminton Vlaanderen, waarbij een hoger cijfer een lager
            niveau betekent. Een dame die geen competitie speelt komt zo aan 7 bonuspunten, het
            hoogste dat voorkomt. Hierboven staat alleen het totaal per speler.
          </p>
        </details>
      </section>

      {/* ─────────────────────────── STAP 4 ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-0 left-[6px] w-1 -translate-x-1/2 bg-club-500" aria-hidden="true"></span>
        <Dot top="top-2" />

        <Heading eyebrow="Stap 4 · na de laatste shuttle">Van uitslag naar stand</Heading>
        <p class="mt-4 max-w-2xl text-ink-700">
          De uitslagen gaan in de tablet en daarna wordt de hele stand opnieuw berekend. Niet op
          gewonnen matchen, wel op <strong class="font-bold">punten per set</strong>: je cijfer voor
          een speeldag is het gemiddelde van wat je in je drie sets bij elkaar speelde.
        </p>
        <p class="mt-3 max-w-2xl text-ink-700">
          Een set die in verlenging gaat, telt niet zwaarder mee: alles boven 21 wordt teruggerekend.
          Wie wint krijgt dus altijd 21, of de set nu op 21–5 of op 30–29 eindigde. Alleen als je
          verliest, maakt het uit hoeveel punten je haalde.
        </p>

        <div class="mt-8 border border-ink-950/10 bg-white p-4 sm:p-6">
          <p class="type-label text-[0.65rem] text-ink-500">
            Verzet de sets van <span id="calculator-name" class="text-club-700">{fullName(start)}</span>
          </p>

          <div class="mt-4 space-y-4">
            {startSets.map((setResult, set) => (
              <div class="grid grid-cols-[3rem_minmax(0,1fr)] items-center gap-x-3 gap-y-2 border-b border-ink-950/5 pb-4 last:border-0 last:pb-0 sm:grid-cols-[3rem_9rem_minmax(0,1fr)_8rem]">
                <span class="type-label text-xs text-ink-500">Set {set + 1}</span>

                <div class="flex flex-wrap gap-1 justify-self-start" role="group" aria-label={`Uitslag set ${set + 1}`}>
                  {['won', 'lost'].map((kind) => (
                    <Pill
                      size="small"
                      data-result={set}
                      data-kind={kind}
                      aria-pressed={(kind === 'won') === setResult.won ? 'true' : 'false'}
                    >
                      {kind === 'won' ? 'Gewonnen' : 'Verloren'}
                    </Pill>
                  ))}
                </div>

                <label class="col-span-2 flex items-center gap-3 sm:col-span-1">
                  <span class="sr-only">Jouw punten in set {set + 1}</span>
                  <input
                    type="range"
                    data-points={set}
                    min="0"
                    max="28"
                    step="1"
                    value={setResult.won ? 21 : setResult.points}
                    disabled={setResult.won}
                    class="h-1 w-full min-w-32 cursor-pointer appearance-none rounded-full bg-ink-950/15 accent-club-500 disabled:cursor-not-allowed disabled:opacity-30"
                  />
                </label>

                <p class="col-start-2 justify-self-start sm:col-start-4 sm:justify-self-end">
                  <span data-score={set} class="type-numeral text-sm text-ink-500">
                    {setResult.won ? 'gewonnen' : `${setResult.points} – ${opponentPoints(setResult.points)}`}
                  </span>
                  <span data-counted={set} class="type-numeral ml-2 bg-feather-100 px-2 py-0.5 text-sm text-ink-950">
                    {formatComma(setResult.counted)}
                  </span>
                </p>
              </div>
            ))}
          </div>

          <button
            id="restore-result"
            type="button"
            class="type-label mt-5 text-[0.65rem] text-club-700 underline hover:text-club-800"
          >
            Herstel de echte uitslag
          </button>

          {/* De rekensom, van drie sets naar één plaats in het klassement. */}
          <div class="mt-6 border-t-2 border-ink-950 pt-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <p class="type-label text-xs text-ink-500">Je cijfer voor deze speeldag</p>
              <p id="day-score" class="type-numeral text-3xl text-ink-950">{formatComma(startScore)}</p>
            </div>
            <p id="day-score-sum" class="mt-1 text-sm text-ink-500">
              ({startSets.map((s) => formatComma(s.counted)).join(' + ')}) ÷ 3 — je gemiddeld aantal punten per set.
            </p>

            <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <p class="type-label text-xs text-ink-500">Je stand na deze speeldag</p>
              <p class="type-numeral text-3xl text-ink-950">
                <span id="average-previous" class="text-lg text-ink-500">{formatComma(start.previousAverage)}</span>
                <span class="text-lg text-ink-950/30"> → </span>
                <span id="average-new">{formatComma(startAverage)}</span>
              </p>
            </div>
            <p id="average-sum" class="mt-1 text-sm text-ink-500">
              ({formatComma(start.previousAverage)} × {matchdaysPlayed} + {formatComma(startScore)}) ÷ {matchdaysPlayed + 1}
               — het gemiddelde van je basispunt en al je {matchdaysPlayed} speeldagcijfers.
            </p>
          </div>
        </div>

        <div class="mt-6 max-w-2xl border-l-4 border-club-500 bg-club-50 p-4">
          <p class="type-label text-[0.65rem] text-club-700">En als je er niet bij was?</p>
          <p class="mt-2 text-sm text-ink-700">
            Dan krijg je geen nul, maar het gemiddelde van alle verliezende duo's van die avond.
            Op {dateText} was dat
             <strong class="type-numeral font-bold text-ink-950">{formatComma(absent)}</strong>, terwijl de
            top van de stand rond {formatComma(players[0].average, 1)} zit. Sta je hoger dan dat cijfer,
            dan kost elke gemiste speeldag je een beetje.
          </p>
        </div>

        <details class="mt-5 max-w-2xl border-l-2 border-club-500/30 pl-4">
          <summary class="type-label cursor-pointer text-xs text-club-700 hover:text-club-800">
            Voor de rekenaars
          </summary>
          <ul class="mt-3 space-y-3 text-sm text-ink-700">
            <li>
              <strong class="font-bold">Het basispunt.</strong> Bij de start van een seizoen krijgt
              iedereen 19,000 als eerste waarde. Je stand is het gemiddelde van dat basispunt en al
              je speeldagcijfers, dus na {matchdaysPlayed} speeldagen weegt het nog één
              {matchdaysPlayed + 1}de mee. Vroeg in het seizoen springt je stand daardoor flink,
              later verschuift ze nog nauwelijks.
            </li>
            <li>
              <strong class="font-bold">De tiebreaker.</strong> Dat basispunt is niet voor iedereen
              exact gelijk. Wie vorig seizoen hoger eindigde, krijgt er tienduizendsten bovenop
              (19,0001, 19,0002 en zo verder). Genoeg om twee gelijke standen te scheiden, en
              verder onzichtbaar.
            </li>
            <li>
              <strong class="font-bold">Terugschalen.</strong> Bij een set boven 21 wordt elke score
              vermenigvuldigd met 21 gedeeld door de hoogste score. Bij 24–22 geeft dat 21 en
              21⁄24 × 22 = {formatComma((21 / 24) * 22)}.
            </li>
            <li>
              <strong class="font-bold">De code.</strong> De loting, de puntenberekening en de hele
              clubapplicatie staan open op
               <a href="https://github.com/BC-Landegem/Intraclub" class="text-club-700 underline hover:text-club-800" rel="noopener">GitHub</a>.
              Wat hierboven staat, komt daaruit.
            </li>
          </ul>
        </details>
      </section>

      {/* ─────────────────────────── SLOT ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-2 left-[6px] w-1 -translate-x-1/2 rounded-full bg-club-500" aria-hidden="true"></span>
        <Dot top="top-2" />
        <span class="absolute bottom-0 left-[6px] h-2 w-2 -translate-x-1/2 rounded-full bg-club-500" aria-hidden="true"></span>

        <Heading>En nu?</Heading>

        <div class="mt-6 grid gap-4 pb-10 sm:grid-cols-2">
          <div class="border-2 border-ink-950 p-5">
            <p class="type-label text-xs text-club-700">Je speelt al mee</p>
            <p class="mt-2 text-sm text-ink-700">
              Dit seizoen staan er {playersInRanking} spelers in het klassement. Bekijk de stand, je eigen
              verloop over de speeldagen en alle uitslagen.
            </p>
            <div class="mt-4 flex flex-col items-start gap-2">
              <a href={url('/intraclub/')} class="type-label inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
                Naar de stand
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={arrowPath} />
                </svg>
              </a>
              <a
                id="link-own-progression"
                href={url(`/intraclub/speler/?id=${start.id}`)}
                class="type-label inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline"
              >
                <span id="link-own-text">Het verloop van {fullName(start)}</span>
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={arrowPath} />
                </svg>
              </a>
              <a href={url(`/intraclub/speeldag/?id=${matchday.id}`)} class="type-label inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
                Alle uitslagen van speeldag {matchday.number}
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={arrowPath} />
                </svg>
              </a>
            </div>
          </div>

          {/* Kleine tekst op clubrood is ink-950 (kleine-letter-regel uit DESIGN.md) */}
          <div class="bg-club-500 p-5 text-ink-950">
            <p class="type-label text-xs">Nog nooit meegedaan?</p>
            <p class="mt-2 text-sm font-medium">
              Je hoeft er niets voor te kunnen. Door de groepen speel je tegen je eigen niveau, en met de
              bonuspunten klopt een recreant geregeld een competitiespeler. Kom gewoon eens langs op
              woensdag, vanaf 20u in Sporthal Oostbroek.
            </p>
            <a
              href={url('/club/word-lid/')}
              class="type-label mt-4 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-xs text-club-600 transition-colors hover:bg-club-50"
            >
              Word lid
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={arrowPath} />
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import example from '../../data/intraclub-example.json';
  import {
    bands,
    dayScore,
    formatComma,
    draw,
    newAverage,
    SET_LINEUP,
    isHomeSide,
    opponentPoints,
    trimSet,
    lead,
    fullName,
    type Court,
    type CourtSource,
    type DrawnCourt,
    type Player,
  } from '../../lib/intra-explainer';

  const players = example.players as Player[];
  const courts = example.courts as Court[];
  const matchdaysPlayed = example.matchdaysPlayed;

  const playerById = new Map(players.map((p) => [p.id, p]));
  const byStrength = [...players].sort((a, b) => a.rankOnEvening - b.rankOnEvening);
  const { upperEnd, lowerStart } = bands(byStrength.length);
  const positionById = new Map(byStrength.map((p, i) => [p.id, i]));
  const courtById = new Map<string, Court>();
  for (const court of courts) for (const id of court.players) courtById.set(id, court);

  const el = (id: string) => document.getElementById(id)!;
  const picker = el('player-select') as HTMLSelectElement;
  let current = playerById.get(picker.value)!;
  let activeSet = 0;

  /** Zet de opmaak van "dit ben jij" op één element. */
  function mark(element: HTMLElement, isYou: boolean, normal: string[]) {
    element.classList.toggle('border-club-500', isYou);
    element.classList.toggle('bg-club-100', isYou);
    element.classList.toggle('font-bold', isYou);
    element.classList.toggle('text-ink-950', isYou);
    for (const cls of normal) element.classList.toggle(cls, !isYou);
  }

  /* ── Stap 2: de loting ─────────────────────────────────────────────── */

  const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-chip]'));
  const courtRows = Array.from(document.querySelectorAll<HTMLElement>('[data-court]'));
  const caption = el('draw-caption');

  const sourceName: Record<CourtSource, string> = {
    upper: 'bovenste groep',
    lower: 'onderste groep',
    rest: 'restbaan',
    drawnOut: 'uitgeloot',
  };

  /** De echte loting van die avond, in hetzelfde formaat als een simulatie. */
  function actualDraw(): DrawnCourt[] {
    return courts.map((court) => {
      const positions = court.players.map((id) => positionById.get(id)!);
      const source: CourtSource = positions.every((p) => p < upperEnd)
        ? 'upper'
        : positions.every((p) => p >= lowerStart)
          ? 'lower'
          : 'rest';
      return { source, players: court.players.map((id) => playerById.get(id)!) };
    });
  }

  let currentDraw = actualDraw();

  /**
   * Zet een loting in de vaste rijen die al in de HTML staan — alleen hun inhoud
   * verandert. Met 48 aanwezigen levert elke loting precies 12 banen op; komt er
   * ooit een snapshot met een ander aantal, dan blijven overtollige rijen leeg.
   */
  function renderDraw(drawnCourts: DrawnCourt[], animate: boolean) {
    currentDraw = drawnCourts;

    courtRows.forEach((row, i) => {
      const court = drawnCourts[i];
      row.hidden = !court;
      if (!court) return;
      row.querySelector('[data-source]')!.textContent = sourceName[court.source];
      court.players.forEach((player, position) => {
        const nameEl = row.querySelector<HTMLElement>(`[data-position="${position}"]`);
        if (!nameEl) return;
        nameEl.textContent = fullName(player);
        nameEl.classList.toggle('font-bold', player.id === current.id);
        nameEl.classList.toggle('text-club-700', player.id === current.id);
      });
      if (animate) {
        row.classList.remove('landed');
        row.style.transitionDelay = `${i * 110}ms`;
      }
    });

    for (const chip of chips) {
      mark(chip, chip.dataset.chip === current.id, [
        'border-ink-950/15',
        'bg-white',
        'text-ink-700',
      ]);
    }

    updateChipHighlight();
    updateCourtSelection();

    if (animate) {
      requestAnimationFrame(() =>
        requestAnimationFrame(() => courtRows.forEach((row) => row.classList.add('landed'))),
      );
    } else {
      for (const row of courtRows) {
        row.style.transitionDelay = '';
        row.classList.add('landed');
      }
    }
  }

  el('draw-again').addEventListener('click', () => {
    renderDraw(draw(byStrength), true);
    const index = currentDraw.findIndex((court) => court.players.some((p) => p.id === current.id));
    const court = currentDraw[index];
    caption.textContent =
      `Zo had het er die avond ook kunnen uitzien. ${current.firstName} komt op baan ${index + 1} terecht` +
      (court.source === 'rest' ? ', in de restbaan.' : `, uit de ${sourceName[court.source]}.`);
  });

  el('show-actual').addEventListener('click', () => {
    renderDraw(actualDraw(), true);
    caption.textContent = 'Zo zag de loting van die avond er echt uit.';
  });

  // Een baan aanwijzen licht zijn vier spelers op in de lijst hierboven: zo zie je
  // meteen uit welk deel van de zaal ze geplukt zijn.
  const chipById = new Map(chips.map((chip) => [chip.dataset.chip!, chip]));
  let selectedCourt: number | null = null;
  let hoveredCourt: number | null = null;

  function updateChipHighlight() {
    const active = hoveredCourt ?? selectedCourt;
    for (const chip of chips) chip.classList.remove('ring-2', 'ring-club-500');
    if (active === null) return;
    for (const player of currentDraw[active]?.players ?? []) {
      chipById.get(player.id)?.classList.add('ring-2', 'ring-club-500');
    }
  }

  function updateCourtSelection() {
    courtRows.forEach((row, i) => {
      const selected = i === selectedCourt;
      row.classList.toggle('border-2', selected);
      row.classList.toggle('border-club-600', selected);
      row.classList.toggle('border-ink-950/10', !selected);
      row.classList.toggle('bg-club-50', selected);
      row.setAttribute('aria-pressed', String(selected));
    });
  }

  function selectCourt(index: number) {
    selectedCourt = selectedCourt === index ? null : index;
    updateCourtSelection();
    updateChipHighlight();
  }

  courtRows.forEach((row, i) => {
    row.addEventListener('click', () => selectCourt(i));
    row.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectCourt(i);
      }
    });
    row.addEventListener('mouseenter', () => {
      hoveredCourt = i;
      updateChipHighlight();
    });
    row.addEventListener('mouseleave', () => {
      hoveredCourt = null;
      updateChipHighlight();
    });
    row.addEventListener('focus', () => {
      hoveredCourt = i;
      updateChipHighlight();
    });
    row.addEventListener('blur', () => {
      hoveredCourt = null;
      updateChipHighlight();
    });
  });

  /* ── Stap 3: duo's en voorsprongen ─────────────────────────────────── */

  const courtPlayerEls = Array.from(document.querySelectorAll<HTMLElement>('[data-court-player]'));
  const setTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-set-tab]'));

  function renderCourt() {
    const court = courtById.get(current.id)!;
    el('court-title').textContent = `Baan ${courts.indexOf(court) + 1}`;
    court.players.forEach((id, position) => {
      const player = playerById.get(id)!;
      const box = courtPlayerEls[position];
      box.querySelector('[data-name]')!.textContent = fullName(player);
      box.querySelector('[data-bonus]')!.textContent = String(player.bonus);
      mark(box, id === current.id, ['border-ink-950/15', 'text-ink-700']);
    });
    renderSet();
  }

  function renderSet() {
    const court = courtById.get(current.id)!;
    const onCourt = court.players.map((id) => playerById.get(id)!);
    const { home, away } = SET_LINEUP[activeSet];
    const v = lead(onCourt.map((p) => p.bonus), activeSet);
    const names = (positions: readonly number[]) =>
      positions.map((p) => fullName(onCourt[p])).join(' & ');

    el('pair-home').textContent = names(home);
    el('pair-away').textContent = names(away);
    el('bonus-home').textContent = String(v.homeBonus);
    el('bonus-away').textContent = String(v.awayBonus);
    el('start-home').textContent = String(v.home);
    el('start-away').textContent = String(v.away);

    const ahead = v.home > 0 ? names(home) : v.away > 0 ? names(away) : null;
    const gap = Math.max(v.home, v.away);
    el('lead-explainer').textContent = ahead
      ? `${v.homeBonus} tegen ${v.awayBonus} bonuspunten: ${ahead} begint ${gap} punt${gap === 1 ? '' : 'en'} voor.`
      : 'Even veel bonuspunten aan beide kanten: deze set begint op nul.';

    const [homeScore, awayScore] = court.sets[activeSet];
    el('actual-result').textContent = `${homeScore} – ${awayScore}`;
    el('actual-winner').textContent = `${names(homeScore > awayScore ? home : away)} wonnen`;

    for (const tab of setTabs) {
      tab.setAttribute('aria-selected', String(Number(tab.dataset.setTab) === activeSet));
    }
  }

  for (const tab of setTabs) {
    tab.addEventListener('click', () => {
      activeSet = Number(tab.dataset.setTab);
      renderSet();
    });
  }

  /* ── Stap 4: van uitslag naar stand ────────────────────────────────── */

  // Per set: won je hem (dan telt hij altijd als 21), of verloor je met zoveel punten?
  type SetResult = { won: boolean; points: number };
  let setResults: SetResult[] = [];

  const sliders = Array.from(document.querySelectorAll<HTMLInputElement>('[data-points]'));
  const resultButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-result]'));

  /** De echte uitslag van deze speler, als startpunt van de rekenmachine. */
  function actualSetResults(): SetResult[] {
    const court = courtById.get(current.id)!;
    const position = court.players.indexOf(current.id);
    return [0, 1, 2].map((set) => {
      const [home, away] = court.sets[set];
      const own = isHomeSide(position, set) ? home : away;
      const other = isHomeSide(position, set) ? away : home;
      return { won: own > other, points: own };
    });
  }

  function renderCalculator() {
    el('calculator-name').textContent = fullName(current);

    const counted = setResults.map((result) =>
      result.won ? 21 : trimSet(result.points, opponentPoints(result.points)),
    );

    setResults.forEach((result, set) => {
      const slider = sliders[set];
      slider.disabled = result.won;
      slider.value = String(result.won ? 21 : result.points);

      for (const button of resultButtons) {
        if (Number(button.dataset.result) !== set) continue;
        button.setAttribute('aria-pressed', String((button.dataset.kind === 'won') === result.won));
      }

      document.querySelector(`[data-score="${set}"]`)!.textContent = result.won
        ? 'gewonnen'
        : `${result.points} – ${opponentPoints(result.points)}`;
      document.querySelector(`[data-counted="${set}"]`)!.textContent = formatComma(counted[set]);
    });

    const score = dayScore(counted);
    el('day-score').textContent = formatComma(score);
    el('day-score-sum').textContent =
      `(${counted.map((p) => formatComma(p)).join(' + ')}) ÷ 3 — je gemiddeld aantal punten per set.`;

    const next = newAverage(current.previousAverage, score, matchdaysPlayed);
    el('average-previous').textContent = formatComma(current.previousAverage);
    el('average-new').textContent = formatComma(next);
    el('average-sum').textContent =
      `(${formatComma(current.previousAverage)} × ${matchdaysPlayed} + ${formatComma(score)}) ÷ ${matchdaysPlayed + 1} — ` +
      `het gemiddelde van je basispunt en al je ${matchdaysPlayed} speeldagcijfers.`;
  }

  for (const slider of sliders) {
    slider.addEventListener('input', () => {
      setResults[Number(slider.dataset.points)] = { won: false, points: Number(slider.value) };
      renderCalculator();
    });
  }

  for (const button of resultButtons) {
    button.addEventListener('click', () => {
      const set = Number(button.dataset.result);
      const won = button.dataset.kind === 'won';
      setResults[set] = { won, points: won ? 21 : Math.min(setResults[set].points, 19) };
      renderCalculator();
    });
  }

  el('restore-result').addEventListener('click', () => {
    setResults = actualSetResults();
    renderCalculator();
  });

  /* ── De spelerkeuze bindt alles samen ───────────────────────────────── */

  function selectPlayer(id: string) {
    current = playerById.get(id)!;
    activeSet = 0;
    setResults = actualSetResults();
    renderDraw(currentDraw, false);
    renderCourt();
    renderCalculator();

    const link = el('link-own-progression') as HTMLAnchorElement;
    link.href = link.href.replace(/id=[^&]*/, `id=${current.id}`);
    el('link-own-text').textContent = `Het verloop van ${fullName(current)}`;
  }

  picker.addEventListener('change', () => selectPlayer(picker.value));
  selectPlayer(picker.value);
</script>

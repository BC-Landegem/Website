---
import Layout from '../../layouts/Layout.astro';
import RailHeading from '../../components/RailHeading.astro';
import { url } from '../../lib/url';
import example from '../../data/intraclub-voorbeeld.json';
import {
  absenteeScore,
  bands,
  dayScore,
  decimalComma,
  newStanding,
  SET_LINEUP,
  isHome,
  opponentPoints,
  trimSet,
  headStart,
  fullName,
  type Court,
  type Player,
} from '../../lib/intra-rules';

// Alles op deze pagina komt uit één bevroren speeldag: src/data/intraclub-voorbeeld.json,
// geschreven door scripts/intra-snapshot.mjs. Echte spelers, echte loting, echte
// uitslagen. Er gaat geen enkel request uit — de pagina is volledig gerenderd en
// alle interactie is rekenwerk op die data, ook zonder bereik in de sporthal.
// Zonder JavaScript blijft precies dit startbeeld staan: één speler, set 1, de
// echte uitslag. Daarom worden alle cijfers hieronder ook hier al berekend.
const players = example.spelers as Player[];
const courts = example.banen as Court[];
const { speeldag, speeldagenGespeeld, spelersInStand } = example;

// Voor de loting telt de volgorde van de avond zelf: de stand ná de vórige speeldag.
const byStrength = [...players].sort((a, b) => a.rangOpAvond - b.rangOpAvond);
const count = byStrength.length;
const { upperEnd, lowerStart } = bands(count);
const positionOf = new Map(byStrength.map((player, i) => [player.id, i]));
const playerById = new Map(players.map((player) => [player.id, player]));

const groups = [
  { kind: 'boven', heading: 'Alleen de bovenste band', spelers: byStrength.slice(0, lowerStart) },
  { kind: 'overlap', heading: 'In beide banden', spelers: byStrength.slice(lowerStart, upperEnd) },
  { kind: 'onder', heading: 'Alleen de onderste band', spelers: byStrength.slice(upperEnd) },
] as const;

const courtOf = new Map<string, Court>();
for (const court of courts) for (const id of court.spelers) courtOf.set(id, court);

/** Uit welke band een échte baan van die avond getrokken is. */
function sourceOf(court: Court) {
  const positions = court.spelers.map((id) => positionOf.get(id)!);
  if (positions.every((p) => p < upperEnd)) return 'boven';
  if (positions.every((p) => p >= lowerStart)) return 'onder';
  return 'rest';
}
const actualSources = courts.map(sourceOf);
const restCourtNumber = actualSources.indexOf('rest') + 1;

// De speler die het verhaal draagt tot je zelf iemand kiest: iemand uit de
// overlapband — die laat zien dat je naar boven én naar onder geloot kan worden —
// die bovendien een set in verlenging speelde, want daarop draait stap 4.
const inOverlap = new Set(groups[1].spelers.map((s) => s.id));
const start =
  byStrength.find(
    (s) => inOverlap.has(s.id) && courtOf.get(s.id)!.sets.some(([t, u]) => t > 21 || u > 21),
  ) ?? byStrength[0];

const startCourt = courtOf.get(start.id)!;
const startCourtNumber = courts.indexOf(startCourt) + 1;
const startPosition = startCourt.spelers.indexOf(start.id);
const startCourtPlayers = startCourt.spelers.map((id) => playerById.get(id)!);
const startBonuses = startCourtPlayers.map((s) => s.bonus);

// Stap 3, set 1: wie met wie, en met welke voorsprong.
const duoNames = (positions: readonly number[]) =>
  positions.map((p) => fullName(startCourtPlayers[p])).join(' & ');
const startHeadStart = headStart(startBonuses, 0);
const startDifference = Math.max(startHeadStart.home, startHeadStart.away);
const startHeadStartNames =
  startHeadStart.home > 0
    ? duoNames(SET_LINEUP[0].home)
    : startHeadStart.away > 0
      ? duoNames(SET_LINEUP[0].away)
      : null;

// Stap 4: de echte sets van deze speler, en wat ze opleveren.
const startSets = [0, 1, 2].map((set) => {
  const [home, away] = startCourt.sets[set];
  const own = isHome(startPosition, set) ? home : away;
  const other = isHome(startPosition, set) ? away : home;
  return { won: own > other, points: own, counts: trimSet(own, other) };
});
const startScore = dayScore(startSets.map((s) => s.counts));
const startStanding = newStanding(start.vorigGemiddelde, startScore, speeldagenGespeeld);

const absent = absenteeScore(courts);
const dateText = new Date(speeldag.datum).toLocaleDateString('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const bonusRules = [
  { who: 'Dame', points: '+2' },
  { who: 'Speelt geen competitie', points: '+5' },
  { who: 'Dubbelklassement 11 of 12', points: '+4' },
  { who: 'Dubbelklassement 9 of 10', points: '+3' },
  { who: 'Dubbelklassement 7 of 8', points: '+2' },
  { who: 'Dubbelklassement 5 of 6', points: '+1' },
  { who: 'Dubbelklassement 1 tot 4', points: '0' },
];

const sourceLabel = { boven: 'bovenste band', onder: 'onderste band', rest: 'restbaan' } as const;
const arrow = 'M4 12h16m0 0l-6-6m6 6l-6 6';
---

<Layout
  title="Zo werkt intraclub"
  description="Hoe de loting, de bonuspunten en het klassement van de intraclub werken. Uitgelegd met de namen en de uitslagen van een echte speeldag."
>
  <div class="mx-auto max-w-4xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Zo werkt intraclub"
      intro={`Om de twee weken is het woensdag intraclub. Je wordt bij drie andere spelers geloot, je speelt drie sets met telkens een andere partner, en achteraf schuift je plaats in het klassement op. Hieronder staat wat er die avond gebeurt, met de cijfers van speeldag ${speeldag.nummer}.`}
      continuous
    >
      <p class="mt-4 max-w-2xl text-sm text-inkt-500">
        Alle namen, uitslagen en cijfers hieronder komen van {dateText}: {count} spelers,
         {courts.length} banen. Verzet gerust wat je wil, aan de echte stand verandert er niets.
      </p>
    </RailHeading>

    <div class="mt-16 space-y-16">
      {/* ─────────────────────────── STAP 1 ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-0 left-[6px] w-1 -translate-x-1/2 bg-club-500" aria-hidden="true"></span>
        <span class="absolute left-[6px] top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>

        <p class="stem-baan text-xs text-club-700">Stap 1 · vóór 20u30</p>
        <h2 class="stem-display mt-1 text-3xl text-inkt-950 sm:text-4xl">Je meldt je aan</h2>
        <p class="mt-4 max-w-2xl text-inkt-700">
          In de sporthal staat een tablet. Wie meespeelt, tikt zijn naam aan. Om 20u30 gaat de lijst
          dicht en staat vast wie er die avond bij is.
        </p>

        {/* De tablet uit de sporthal, en meteen de spelerkiezer: kies je eigen naam
             en de rest van de pagina rekent verder met jou. */}
        <div class="mt-8 max-w-md border-2 border-inkt-950 bg-white p-1.5 shadow-[6px_6px_0_0_var(--color-inkt-950)]">
          <div class="border border-inkt-950/10 bg-veer-50 p-5">
            <p class="stem-baan text-xs text-club-700">Aanwezig op {dateText}</p>
            <p class="stem-display mt-1 text-4xl text-inkt-950">
              {count}<span class="text-2xl text-inkt-500"> spelers</span>
            </p>
            <label for="speler-keuze" class="stem-baan mt-5 block text-xs text-inkt-500">
              Speel je zelf mee? Kies je naam
            </label>
            <select
              id="speler-keuze"
              class="mt-2 w-full border-2 border-inkt-950/20 bg-white px-3 py-2.5 text-sm text-inkt-950 transition-colors hover:border-club-600 focus:border-club-500"
            >
              {byStrength.map((player) => (
                <option value={player.id} selected={player.id === start.id}>
                  {fullName(player)}
                </option>
              ))}
            </select>
            <p class="mt-3 text-xs text-inkt-500">
              Staat je naam er niet bij, dan speelde je die avond niet mee. Lees gewoon verder met de
              speler die er staat.
            </p>
          </div>
        </div>
      </section>

      {/* ─────────────────────────── STAP 2 ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-0 left-[6px] w-1 -translate-x-1/2 bg-club-500" aria-hidden="true"></span>
        <span class="absolute left-[6px] top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>

        <p class="stem-baan text-xs text-club-700">Stap 2 · 20u30</p>
        <h2 class="stem-display mt-1 text-3xl text-inkt-950 sm:text-4xl">De loting</h2>
        <p class="mt-4 max-w-2xl text-inkt-700">
          De aanwezigen worden op sterkte gezet en in twee banden verdeeld. Elke band beslaat 60% van
          de zaal: de bovenste vanaf de beste speler, de onderste tot de zwakste. Wie in de middelste
          20% valt, zit dus in allebei en kan naar boven én naar onder geloot worden.
        </p>
        <p class="mt-3 max-w-2xl text-inkt-700">
          Daarna trekt de computer beurtelings vier namen uit de bovenste band en vier uit de onderste,
          tot er niemand meer overblijft. Wie geloot is, verdwijnt uit allebei de banden. Zo speel je
          tegen je eigen niveau en sta je toch bijna elke speeldag met andere mensen op de baan.
        </p>

        {/* De pot: iedereen die aanwezig was, op sterkte, met de overlap als eigen baan. */}
        <div class="mt-8">
          <p class="stem-baan text-xs text-inkt-500">
            De {count} aanwezigen, op sterkte
            <span class="text-inkt-950/40">· de stand zoals die vóór deze speeldag was</span>
          </p>
          <p class="mt-1 text-xs text-inkt-500">
            Wijs een baan aan of tik erop om te zien waar die vier spelers vandaan komen.
          </p>
          <div class="mt-3 border border-inkt-950/10">
            {groups.map((group) => (
              <div
                class:list={[
                  'px-3 py-3',
                  group.kind === 'overlap' ? 'border-y-2 border-club-500/30 bg-club-50' : 'bg-white',
                ]}
              >
                <p class="stem-baan text-[0.65rem] text-club-700">
                  {group.heading}
                  <span class="text-inkt-500">
                    {' · '}plaats {group.spelers[0].rangOpAvond}–{group.spelers[group.spelers.length - 1].rangOpAvond}
                  </span>
                </p>
                <div class="mt-2 flex flex-wrap gap-1">
                  {group.spelers.map((player) => (
                    <span
                      data-chip={player.id}
                      class:list={[
                        'border px-2 py-1 text-xs leading-tight transition-colors',
                        player.id === start.id
                          ? 'border-club-500 bg-club-100 font-bold text-inkt-950'
                          : 'border-inkt-950/15 bg-white text-inkt-700',
                      ]}
                    >{fullName(player)}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button
            id="loot-opnieuw"
            type="button"
            class="stem-baan inline-flex items-center gap-2 rounded-full bg-club-600 px-6 py-3 text-sm text-white transition-colors hover:bg-club-700"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M20 9A8 8 0 006.3 5.3M4 15a8 8 0 0013.7 3.7" />
            </svg>
            Loot opnieuw
          </button>
          <button
            id="toon-echte"
            type="button"
            class="stem-baan rounded-full border-2 border-inkt-950/20 px-6 py-2.5 text-sm text-inkt-700 transition-colors hover:border-club-600 hover:text-club-600"
          >
            Toon de echte loting
          </button>
        </div>

        <p id="loting-bijschrift" class="mt-4 text-sm text-inkt-500" aria-live="polite">
          Zo zag de loting van {dateText} er echt uit.
        </p>

        <div class="mt-5 grid gap-2 sm:grid-cols-2">
          {courts.map((court, i) => (
            <div data-baan={i} tabindex="0" class="vlucht geland border border-inkt-950/10 bg-white p-3 transition-colors hover:border-club-500 focus-visible:border-club-500">
              <p class="flex items-baseline justify-between gap-2">
                <span class="stem-baan text-[0.65rem] text-club-700">Baan {i + 1}</span>
                <span data-bron class="stem-baan text-[0.65rem] text-inkt-500">{sourceLabel[actualSources[i]]}</span>
              </p>
              <p class="mt-1.5 text-[0.8rem] leading-snug text-inkt-700">
                {court.spelers.map((id, position) => (
                  <>
                    {position > 0 && <span class="text-inkt-950/30"> · </span>}
                    <span
                      data-plek={position}
                      class:list={id === start.id ? 'font-bold text-club-700' : undefined}
                    >{fullName(playerById.get(id)!)}</span>
                  </>
                ))}
              </p>
            </div>
          ))}
        </div>

        <p class="mt-5 max-w-2xl text-sm text-inkt-500">
          Deelt het aantal aanwezigen niet door vier, dan schuiven de laatste namen samen in een
          <strong class="font-bold text-inkt-700">restbaan</strong>. Dat is de enige baan waar de
          sterkste en de zwakste van de zaal samen op kunnen staan. Op {dateText} was dat baan
           {restCourtNumber}. Blijven er minder dan vier over, dan spelen die niet mee. Zij krijgen
          hetzelfde cijfer als wie er die avond niet was, dus kost het hen ook niets.
        </p>
      </section>

      {/* ─────────────────────────── STAP 3 ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-0 left-[6px] w-1 -translate-x-1/2 bg-club-500" aria-hidden="true"></span>
        <span class="absolute left-[6px] top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>

        <p class="stem-baan text-xs text-club-700">Stap 3 · op de baan</p>
        <h2 class="stem-display mt-1 text-3xl text-inkt-950 sm:text-4xl">Drie sets, elke keer een ander duo</h2>
        <p class="mt-4 max-w-2xl text-inkt-700">
          Op je baan staan vier spelers en er worden drie sets gespeeld. Met elk van de drie anderen
          speel je één set samen, tegen elk van hen speel je twee sets. Wie je partner is, weegt dus
          even zwaar door als wie tegenover je staat.
        </p>
        <p class="mt-3 max-w-2xl text-inkt-700">
          Elke speler brengt ook bonuspunten mee. Per duo worden die samengeteld en het verschil tussen
          de twee duo's is de voorsprong waarmee de set begint. Omdat de duo's elke set veranderen,
          verandert die voorsprong mee: dezelfde vier spelers starten drie keer anders.
        </p>

        <div class="mt-8 border border-inkt-950/10 bg-white">
          <div class="border-b border-inkt-950/10 bg-veer-50 px-4 py-3">
            <p class="stem-baan text-[0.65rem] text-inkt-500">
              <span id="baan-titel">Baan {startCourtNumber}</span> · {dateText}
            </p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {startCourtPlayers.map((player, position) => (
                <span
                  data-baanspeler={position}
                  class:list={[
                    'border px-2 py-1 text-[0.8rem] leading-tight',
                    player.id === start.id
                      ? 'border-club-500 bg-club-100 font-bold text-inkt-950'
                      : 'border-inkt-950/15 text-inkt-700',
                  ]}
                >
                  <span data-baannaam>{fullName(player)}</span>
                  <span data-baanbonus class="stem-cijfer ml-1 text-club-700">{player.bonus}</span>
                </span>
              ))}
            </div>
          </div>

          <div class="px-4 py-5">
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Set">
              {[0, 1, 2].map((set) => (
                <button
                  type="button"
                  role="tab"
                  data-set-tab={set}
                  aria-selected={set === 0 ? 'true' : 'false'}
                  class="stem-baan rounded-full border-2 border-inkt-950/20 px-4 py-1.5 text-xs text-inkt-700 transition-colors hover:border-club-600 hover:text-club-600 aria-selected:border-club-600 aria-selected:bg-club-600 aria-selected:text-white"
                >
                  Set {set + 1}
                </button>
              ))}
            </div>

            {/* Het scorebord: twee duo's met hun opgetelde bonus, en de stand waarmee ze starten. */}
            <div class="mt-6 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3">
              <div class="text-right">
                <p id="duo-thuis" class="text-sm leading-snug text-inkt-950">{duoNames(SET_LINEUP[0].home)}</p>
                <p class="stem-baan mt-1 text-[0.65rem] text-inkt-500">
                  bonus <span id="bonus-thuis" class="stem-cijfer text-club-700">{startHeadStart.homeBonus}</span>
                </p>
              </div>
              <p class="stem-cijfer bg-veer-100 px-4 py-2 text-center text-2xl text-inkt-950">
                <span id="start-thuis">{startHeadStart.home}</span><span class="text-inkt-950/30"> – </span><span id="start-uit">{startHeadStart.away}</span>
              </p>
              <div>
                <p id="duo-uit" class="text-sm leading-snug text-inkt-950">{duoNames(SET_LINEUP[0].away)}</p>
                <p class="stem-baan mt-1 text-[0.65rem] text-inkt-500">
                  bonus <span id="bonus-uit" class="stem-cijfer text-club-700">{startHeadStart.awayBonus}</span>
                </p>
              </div>
            </div>
            <p id="voorsprong-uitleg" class="mt-3 text-center text-sm text-inkt-500">
              {startHeadStartNames
                ? `${startHeadStart.homeBonus} tegen ${startHeadStart.awayBonus} bonuspunten: ${startHeadStartNames} begint ${startDifference} punt${startDifference === 1 ? '' : 'en'} voor.`
                : 'Even veel bonuspunten aan beide kanten: deze set begint op nul.'}
            </p>

            <p class="stem-baan mt-6 text-[0.65rem] text-inkt-500">De echte uitslag van deze set</p>
            <p class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span id="echte-uitslag" class="stem-cijfer text-2xl text-inkt-950">
                {startCourt.sets[0][0]} – {startCourt.sets[0][1]}
              </span>
              <span id="echte-winnaar" class="text-sm text-inkt-500">
                {duoNames(startCourt.sets[0][0] > startCourt.sets[0][1] ? SET_LINEUP[0].home : SET_LINEUP[0].away)} wonnen
              </span>
            </p>
          </div>
        </div>

        <details class="mt-5 max-w-2xl border-l-2 border-club-500/30 pl-4">
          <summary class="stem-baan cursor-pointer text-xs text-club-700 hover:text-club-800">
            Waar komt dat bonuscijfer vandaan?
          </summary>
          <p class="mt-3 text-sm text-inkt-700">
            Wie op papier zwakker staat, begint elke set met een voorsprong. Zo blijft het voor alle
            vier spelers spannend. De club telt op:
          </p>
          <table class="mt-3 w-full max-w-sm text-left text-sm">
            <tbody>
              {bonusRules.map((regel) => (
                <tr class="border-b border-inkt-950/10">
                  <td class="py-1.5 pr-3 text-inkt-700">{regel.who}</td>
                  <td class="stem-cijfer py-1.5 text-right text-inkt-950">{regel.points}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 text-sm text-inkt-500">
            Het dubbelklassement is dat van Badminton Vlaanderen, waarbij een hoger cijfer een lager
            niveau betekent. Een dame die geen competitie speelt komt zo aan 7 bonuspunten, het
            hoogste dat voorkomt. Hierboven staat alleen het totaal per speler.
          </p>
        </details>
      </section>

      {/* ─────────────────────────── STAP 4 ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-0 left-[6px] w-1 -translate-x-1/2 bg-club-500" aria-hidden="true"></span>
        <span class="absolute left-[6px] top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>

        <p class="stem-baan text-xs text-club-700">Stap 4 · na de laatste shuttle</p>
        <h2 class="stem-display mt-1 text-3xl text-inkt-950 sm:text-4xl">Van uitslag naar stand</h2>
        <p class="mt-4 max-w-2xl text-inkt-700">
          De uitslagen gaan in de tablet en daarna wordt de hele stand opnieuw berekend. Niet op
          gewonnen matchen, wel op <strong class="font-bold">punten per set</strong>: je cijfer voor
          een speeldag is het gemiddelde van wat je in je drie sets bij elkaar speelde.
        </p>
        <p class="mt-3 max-w-2xl text-inkt-700">
          Een set die in verlenging gaat, telt niet zwaarder mee: alles boven 21 wordt teruggerekend.
          Wie wint krijgt dus altijd 21, of de set nu op 21–5 of op 30–29 eindigde. Alleen als je
          verliest, maakt het uit hoeveel punten je haalde.
        </p>

        <div class="mt-8 border border-inkt-950/10 bg-white p-4 sm:p-6">
          <p class="stem-baan text-[0.65rem] text-inkt-500">
            Verzet de sets van <span id="rekenaar-naam" class="text-club-700">{fullName(start)}</span>
          </p>

          <div class="mt-4 space-y-4">
            {startSets.map((setstand, set) => (
              <div class="grid grid-cols-[3rem_minmax(0,1fr)] items-center gap-x-3 gap-y-2 border-b border-inkt-950/5 pb-4 last:border-0 last:pb-0 sm:grid-cols-[3rem_9rem_minmax(0,1fr)_8rem]">
                <span class="stem-baan text-xs text-inkt-500">Set {set + 1}</span>

                <div class="flex flex-wrap gap-1 justify-self-start" role="group" aria-label={`Uitslag set ${set + 1}`}>
                  {['gewonnen', 'verloren'].map((kind) => (
                    <button
                      type="button"
                      data-uitslag={set}
                      data-soort={kind}
                      aria-pressed={(kind === 'gewonnen') === setstand.won ? 'true' : 'false'}
                      class="stem-baan rounded-full border-2 border-inkt-950/20 px-3 py-1 text-[0.65rem] text-inkt-700 transition-colors hover:border-club-600 hover:text-club-600 aria-pressed:border-club-600 aria-pressed:bg-club-600 aria-pressed:text-white"
                    >
                      {kind === 'gewonnen' ? 'Gewonnen' : 'Verloren'}
                    </button>
                  ))}
                </div>

                <label class="col-span-2 flex items-center gap-3 sm:col-span-1">
                  <span class="sr-only">Jouw punten in set {set + 1}</span>
                  <input
                    type="range"
                    data-punten={set}
                    min="0"
                    max="28"
                    step="1"
                    value={setstand.won ? 21 : setstand.points}
                    disabled={setstand.won}
                    class="h-1 w-full min-w-32 cursor-pointer appearance-none rounded-full bg-inkt-950/15 accent-club-500 disabled:cursor-not-allowed disabled:opacity-30"
                  />
                </label>

                <p class="col-start-2 justify-self-start sm:col-start-4 sm:justify-self-end">
                  <span data-score={set} class="stem-cijfer text-sm text-inkt-500">
                    {setstand.won ? 'gewonnen' : `${setstand.points} – ${opponentPoints(setstand.points)}`}
                  </span>
                  <span data-telt={set} class="stem-cijfer ml-2 bg-veer-100 px-2 py-0.5 text-sm text-inkt-950">
                    {decimalComma(setstand.counts)}
                  </span>
                </p>
              </div>
            ))}
          </div>

          <button
            id="herstel-uitslag"
            type="button"
            class="stem-baan mt-5 text-[0.65rem] text-club-700 underline hover:text-club-800"
          >
            Herstel de echte uitslag
          </button>

          {/* De rekensom, van drie sets naar één plaats in het klassement. */}
          <div class="mt-6 border-t-2 border-inkt-950 pt-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <p class="stem-baan text-xs text-inkt-500">Je cijfer voor deze speeldag</p>
              <p id="dagcijfer" class="stem-cijfer text-3xl text-inkt-950">{decimalComma(startScore)}</p>
            </div>
            <p id="dagcijfer-som" class="mt-1 text-sm text-inkt-500">
              ({startSets.map((s) => decimalComma(s.counts)).join(' + ')}) ÷ 3 — je gemiddeld aantal punten per set.
            </p>

            <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <p class="stem-baan text-xs text-inkt-500">Je stand na deze speeldag</p>
              <p class="stem-cijfer text-3xl text-inkt-950">
                <span id="stand-vorig" class="text-lg text-inkt-500">{decimalComma(start.vorigGemiddelde)}</span>
                <span class="text-lg text-inkt-950/30"> → </span>
                <span id="stand-nieuw">{decimalComma(startStanding)}</span>
              </p>
            </div>
            <p id="stand-som" class="mt-1 text-sm text-inkt-500">
              ({decimalComma(start.vorigGemiddelde)} × {speeldagenGespeeld} + {decimalComma(startScore)}) ÷ {speeldagenGespeeld + 1}
               — het gemiddelde van je basispunt en al je {speeldagenGespeeld} speeldagcijfers.
            </p>
          </div>
        </div>

        <div class="mt-6 max-w-2xl border-l-4 border-club-500 bg-club-50 p-4">
          <p class="stem-baan text-[0.65rem] text-club-700">En als je er niet bij was?</p>
          <p class="mt-2 text-sm text-inkt-700">
            Dan krijg je geen nul, maar het gemiddelde van alle verliezende duo's van die avond.
            Op {dateText} was dat
             <strong class="stem-cijfer font-bold text-inkt-950">{decimalComma(absent)}</strong>, terwijl de
            top van de stand rond {decimalComma(players[0].gemiddelde, 1)} zit. Een keer overslaan is dus geen
            drama, maar wie vaak ontbreekt zakt langzaam weg.
          </p>
        </div>

        <details class="mt-5 max-w-2xl border-l-2 border-club-500/30 pl-4">
          <summary class="stem-baan cursor-pointer text-xs text-club-700 hover:text-club-800">
            Voor de rekenaars
          </summary>
          <ul class="mt-3 space-y-3 text-sm text-inkt-700">
            <li>
              <strong class="font-bold">Het basispunt.</strong> Bij de start van een seizoen krijgt
              iedereen 19,000 als eerste waarde. Je stand is het gemiddelde van dat basispunt en al
              je speeldagcijfers, dus na {speeldagenGespeeld} speeldagen weegt het nog één
              {speeldagenGespeeld + 1}de mee. Vroeg in het seizoen springt je stand daardoor flink,
              later verschuift ze nog nauwelijks.
            </li>
            <li>
              <strong class="font-bold">De tiebreaker.</strong> Dat basispunt is niet voor iedereen
              exact gelijk. Wie vorig seizoen hoger eindigde, krijgt er tienduizendsten bovenop
              (19,0001, 19,0002 en zo verder). Genoeg om twee gelijke standen te scheiden, en
              verder onzichtbaar.
            </li>
            <li>
              <strong class="font-bold">Terugschalen.</strong> Bij een set boven 21 wordt elke score
              vermenigvuldigd met 21 gedeeld door de hoogste score. Bij 24–22 geeft dat 21 en
              21⁄24 × 22 = {decimalComma((21 / 24) * 22)}.
            </li>
            <li>
              <strong class="font-bold">De code.</strong> De loting, de puntenberekening en de hele
              clubapplicatie staan open op
               <a href="https://github.com/BC-Landegem/Intraclub" class="text-club-700 underline hover:text-club-800" rel="noopener">GitHub</a>.
              Wat hierboven staat, komt daaruit.
            </li>
          </ul>
        </details>
      </section>

      {/* ─────────────────────────── SLOT ─────────────────────────── */}
      <section class="relative pl-10">
        <span class="absolute -top-16 bottom-2 left-[6px] w-1 -translate-x-1/2 rounded-full bg-club-500" aria-hidden="true"></span>
        <span class="absolute left-[6px] top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>
        <span class="absolute bottom-0 left-[6px] h-2 w-2 -translate-x-1/2 rounded-full bg-club-500" aria-hidden="true"></span>

        <h2 class="stem-display text-3xl text-inkt-950 sm:text-4xl">En nu?</h2>

        <div class="mt-6 grid gap-4 pb-10 sm:grid-cols-2">
          <div class="border-2 border-inkt-950 p-5">
            <p class="stem-baan text-xs text-club-700">Je speelt al mee</p>
            <p class="mt-2 text-sm text-inkt-700">
              Dit seizoen staan er {spelersInStand} spelers in het klassement. Bekijk de stand, je eigen
              verloop over de speeldagen en alle uitslagen.
            </p>
            <div class="mt-4 flex flex-col items-start gap-2">
              <a href={url('/intraclub/')} class="stem-baan inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
                Naar de stand
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={arrow} />
                </svg>
              </a>
              <a
                id="link-eigen-verloop"
                href={url(`/intraclub/speler/?id=${start.id}`)}
                class="stem-baan inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline"
              >
                <span id="link-eigen-tekst">Het verloop van {fullName(start)}</span>
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={arrow} />
                </svg>
              </a>
              <a href={url(`/intraclub/speeldag/?id=${speeldag.id}`)} class="stem-baan inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
                Alle uitslagen van speeldag {speeldag.nummer}
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={arrow} />
                </svg>
              </a>
            </div>
          </div>

          {/* Kleine tekst op clubrood is inkt-950 (kleine-letter-regel uit DESIGN.md) */}
          <div class="bg-club-500 p-5 text-inkt-950">
            <p class="stem-baan text-xs">Nog nooit meegedaan?</p>
            <p class="mt-2 text-sm font-medium">
              Je hoeft er niets voor te kunnen. Door de banden speel je tegen je eigen niveau, en met de
              bonuspunten klopt een recreant geregeld een competitiespeler. Kom gewoon eens langs op
              woensdag, vanaf 20u in Sporthal Oostbroek.
            </p>
            <a
              href={url('/club/word-lid/')}
              class="stem-baan mt-4 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-xs text-club-600 transition-colors hover:bg-club-50"
            >
              Word lid
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={arrow} />
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import example from '../../data/intraclub-voorbeeld.json';
  import {
    bands,
    dayScore,
    decimalComma,
    draw,
    newStanding,
    SET_LINEUP,
    isHome,
    opponentPoints,
    trimSet,
    headStart,
    fullName,
    type Court,
    type CourtSource,
    type DrawnCourt,
    type Player,
  } from '../../lib/intra-rules';

  const players = example.spelers as Player[];
  const courts = example.banen as Court[];
  const speeldagen = example.speeldagenGespeeld;

  const playerById = new Map(players.map((s) => [s.id, s]));
  const byStrength = [...players].sort((a, b) => a.rangOpAvond - b.rangOpAvond);
  const { upperEnd, lowerStart } = bands(byStrength.length);
  const positionOf = new Map(byStrength.map((s, i) => [s.id, i]));
  const courtOf = new Map<string, Court>();
  for (const court of courts) for (const id of court.spelers) courtOf.set(id, court);

  const el = (id: string) => document.getElementById(id)!;
  const choice = el('speler-keuze') as HTMLSelectElement;
  let current = playerById.get(choice.value)!;
  let activeSet = 0;

  /** Zet de opmaak van "dit ben jij" op één element. */
  function mark(element: HTMLElement, isYou: boolean, normal: string[]) {
    element.classList.toggle('border-club-500', isYou);
    element.classList.toggle('bg-club-100', isYou);
    element.classList.toggle('font-bold', isYou);
    element.classList.toggle('text-inkt-950', isYou);
    for (const cls of normal) element.classList.toggle(cls, !isYou);
  }

  /* ── Stap 2: de loting ─────────────────────────────────────────────── */

  const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-chip]'));
  const courtRows = Array.from(document.querySelectorAll<HTMLElement>('[data-baan]'));
  const caption = el('loting-bijschrift');

  const sourceName: Record<CourtSource, string> = {
    boven: 'bovenste band',
    onder: 'onderste band',
    rest: 'restbaan',
    uitgeloot: 'uitgeloot',
  };

  /** De echte loting van die avond, in hetzelfde formaat als een simulatie. */
  function actualDraw(): DrawnCourt[] {
    return courts.map((court) => {
      const positions = court.spelers.map((id) => positionOf.get(id)!);
      const source: CourtSource = positions.every((p) => p < upperEnd)
        ? 'boven'
        : positions.every((p) => p >= lowerStart)
          ? 'onder'
          : 'rest';
      return { source, spelers: court.spelers.map((id) => playerById.get(id)!) };
    });
  }

  let currentDraw = actualDraw();

  /**
   * Zet een loting in de vaste rijen die al in de HTML staan — alleen hun inhoud
   * verandert. Met 48 aanwezigen levert elke loting precies 12 banen op; komt er
   * ooit een snapshot met een ander aantal, dan blijven overtollige rijen leeg.
   */
  function renderDraw(drawResult: DrawnCourt[], animate: boolean) {
    currentDraw = drawResult;

    courtRows.forEach((row, i) => {
      const court = drawResult[i];
      row.hidden = !court;
      if (!court) return;
      row.querySelector('[data-bron]')!.textContent = sourceName[court.source];
      court.spelers.forEach((player, position) => {
        const nameEl = row.querySelector<HTMLElement>(`[data-plek="${position}"]`);
        if (!nameEl) return;
        nameEl.textContent = fullName(player);
        nameEl.classList.toggle('font-bold', player.id === current.id);
        nameEl.classList.toggle('text-club-700', player.id === current.id);
      });
      if (animate) {
        row.classList.remove('geland');
        row.style.transitionDelay = `${i * 110}ms`;
      }
    });

    for (const chip of chips) {
      mark(chip, chip.dataset.chip === current.id, [
        'border-inkt-950/15',
        'bg-white',
        'text-inkt-700',
      ]);
    }

    if (animate) {
      requestAnimationFrame(() =>
        requestAnimationFrame(() => courtRows.forEach((row) => row.classList.add('geland'))),
      );
    } else {
      for (const row of courtRows) {
        row.style.transitionDelay = '';
        row.classList.add('geland');
      }
    }
  }

  el('loot-opnieuw').addEventListener('click', () => {
    renderDraw(draw(byStrength), true);
    const courtIndex = currentDraw.findIndex((court) => court.spelers.some((s) => s.id === current.id));
    const court = currentDraw[courtIndex];
    caption.textContent =
      `Zo had het er die avond ook kunnen uitzien. ${current.voornaam} komt op baan ${courtIndex + 1} terecht` +
      (court.source === 'rest' ? ', in de restbaan.' : `, uit de ${sourceName[court.source]}.`);
  });

  el('toon-echte').addEventListener('click', () => {
    renderDraw(actualDraw(), true);
    caption.textContent = 'Zo zag de loting van die avond er echt uit.';
  });

  // Een baan aanwijzen licht zijn vier spelers op in de lijst hierboven: zo zie je
  // meteen uit welk deel van de zaal ze geplukt zijn.
  const chipById = new Map(chips.map((chip) => [chip.dataset.chip!, chip]));
  function highlight(index: number, on: boolean) {
    for (const player of currentDraw[index]?.spelers ?? []) {
      chipById.get(player.id)?.classList.toggle('ring-2', on);
      chipById.get(player.id)?.classList.toggle('ring-club-500', on);
    }
  }
  courtRows.forEach((row, i) => {
    for (const event of ['mouseenter', 'focus'] as const) {
      row.addEventListener(event, () => highlight(i, true));
    }
    for (const event of ['mouseleave', 'blur'] as const) {
      row.addEventListener(event, () => highlight(i, false));
    }
  });

  /* ── Stap 3: duo's en voorsprongen ─────────────────────────────────── */

  const courtSlots = Array.from(document.querySelectorAll<HTMLElement>('[data-baanspeler]'));
  const setTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-set-tab]'));

  function renderCourt() {
    const court = courtOf.get(current.id)!;
    el('baan-titel').textContent = `Baan ${courts.indexOf(court) + 1}`;
    court.spelers.forEach((id, position) => {
      const player = playerById.get(id)!;
      const slot = courtSlots[position];
      slot.querySelector('[data-baannaam]')!.textContent = fullName(player);
      slot.querySelector('[data-baanbonus]')!.textContent = String(player.bonus);
      mark(slot, id === current.id, ['border-inkt-950/15', 'text-inkt-700']);
    });
    renderSet();
  }

  function renderSet() {
    const court = courtOf.get(current.id)!;
    const onCourt = court.spelers.map((id) => playerById.get(id)!);
    const { home, away } = SET_LINEUP[activeSet];
    const v = headStart(onCourt.map((s) => s.bonus), activeSet);
    const names = (positions: readonly number[]) =>
      positions.map((p) => fullName(onCourt[p])).join(' & ');

    el('duo-thuis').textContent = names(home);
    el('duo-uit').textContent = names(away);
    el('bonus-thuis').textContent = String(v.homeBonus);
    el('bonus-uit').textContent = String(v.awayBonus);
    el('start-thuis').textContent = String(v.home);
    el('start-uit').textContent = String(v.away);

    const ahead = v.home > 0 ? names(home) : v.away > 0 ? names(away) : null;
    const difference = Math.max(v.home, v.away);
    el('voorsprong-uitleg').textContent = ahead
      ? `${v.homeBonus} tegen ${v.awayBonus} bonuspunten: ${ahead} begint ${difference} punt${difference === 1 ? '' : 'en'} voor.`
      : 'Even veel bonuspunten aan beide kanten: deze set begint op nul.';

    const [homeScore, awayScore] = court.sets[activeSet];
    el('echte-uitslag').textContent = `${homeScore} – ${awayScore}`;
    el('echte-winnaar').textContent = `${names(homeScore > awayScore ? home : away)} wonnen`;

    for (const tab of setTabs) {
      tab.setAttribute('aria-selected', String(Number(tab.dataset.setTab) === activeSet));
    }
  }

  for (const tab of setTabs) {
    tab.addEventListener('click', () => {
      activeSet = Number(tab.dataset.setTab);
      renderSet();
    });
  }

  /* ── Stap 4: van uitslag naar stand ────────────────────────────────── */

  // Per set: won je hem (dan telt hij altijd als 21), of verloor je met zoveel punten?
  type SetState = { won: boolean; points: number };
  let setStates: SetState[] = [];

  const sliders = Array.from(document.querySelectorAll<HTMLInputElement>('[data-punten]'));
  const resultButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-uitslag]'));

  /** De echte uitslag van deze speler, als startpunt van de rekenmachine. */
  function actualSetStates(): SetState[] {
    const court = courtOf.get(current.id)!;
    const position = court.spelers.indexOf(current.id);
    return [0, 1, 2].map((set) => {
      const [home, away] = court.sets[set];
      const own = isHome(position, set) ? home : away;
      const other = isHome(position, set) ? away : home;
      return { won: own > other, points: own };
    });
  }

  function renderCalculator() {
    el('rekenaar-naam').textContent = fullName(current);

    const counts = setStates.map((state) =>
      state.won ? 21 : trimSet(state.points, opponentPoints(state.points)),
    );

    setStates.forEach((state, set) => {
      const slider = sliders[set];
      slider.disabled = state.won;
      slider.value = String(state.won ? 21 : state.points);

      for (const button of resultButtons) {
        if (Number(button.dataset.uitslag) !== set) continue;
        button.setAttribute('aria-pressed', String((button.dataset.soort === 'gewonnen') === state.won));
      }

      document.querySelector(`[data-score="${set}"]`)!.textContent = state.won
        ? 'gewonnen'
        : `${state.points} – ${opponentPoints(state.points)}`;
      document.querySelector(`[data-telt="${set}"]`)!.textContent = decimalComma(counts[set]);
    });

    const score = dayScore(counts);
    el('dagcijfer').textContent = decimalComma(score);
    el('dagcijfer-som').textContent =
      `(${counts.map((p) => decimalComma(p)).join(' + ')}) ÷ 3 — je gemiddeld aantal punten per set.`;

    const updated = newStanding(current.vorigGemiddelde, score, speeldagen);
    el('stand-vorig').textContent = decimalComma(current.vorigGemiddelde);
    el('stand-nieuw').textContent = decimalComma(updated);
    el('stand-som').textContent =
      `(${decimalComma(current.vorigGemiddelde)} × ${speeldagen} + ${decimalComma(score)}) ÷ ${speeldagen + 1} — ` +
      `het gemiddelde van je basispunt en al je ${speeldagen} speeldagcijfers.`;
  }

  for (const slider of sliders) {
    slider.addEventListener('input', () => {
      setStates[Number(slider.dataset.punten)] = { won: false, points: Number(slider.value) };
      renderCalculator();
    });
  }

  for (const button of resultButtons) {
    button.addEventListener('click', () => {
      const set = Number(button.dataset.uitslag);
      const won = button.dataset.soort === 'gewonnen';
      setStates[set] = { won, points: won ? 21 : Math.min(setStates[set].points, 19) };
      renderCalculator();
    });
  }

  el('herstel-uitslag').addEventListener('click', () => {
    setStates = actualSetStates();
    renderCalculator();
  });

  /* ── De spelerkeuze bindt alles samen ───────────────────────────────── */

  function selectPlayer(id: string) {
    current = playerById.get(id)!;
    activeSet = 0;
    setStates = actualSetStates();
    renderDraw(currentDraw, false);
    renderCourt();
    renderCalculator();

    const link = el('link-eigen-verloop') as HTMLAnchorElement;
    link.href = link.href.replace(/id=[^&]*/, `id=${current.id}`);
    el('link-eigen-tekst').textContent = `Het verloop van ${fullName(current)}`;
  }

  choice.addEventListener('change', () => selectPlayer(choice.value));
  selectPlayer(choice.value);
</script>

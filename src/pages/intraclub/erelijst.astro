---
import Layout from '../../layouts/Layout.astro';
import RailHeading from '../../components/RailHeading.astro';
import { url } from '../../lib/url';
import { champions } from '../../lib/intra-build';
import { parsePreArchiveChampions } from '../../lib/champions';
import preArchiveCsv from '../../data/intraclub-pre-archive.csv?raw';

// Wat vóór 2009-2010 ligt, komt niet uit de API maar uit de clubadministratie.
// Aparte bron, apart blok — zie parsePreArchiveChampions().
const preArchive = parsePreArchiveChampions(preArchiveCsv);

// Bevroren data: één keer ophalen bij de build, daarna platte HTML. Nul fetches
// in de browser, meteen indexeerbaar, en leesbaar zonder netwerk. De
// pre-archiefrijen gaan mee omdat de grijze regels over de hele geschiedenis
// rekenen, niet alleen over wat de API kent.
const list = await champions(preArchive);

// De oudste jaargang die de pagina tóónt, niet de oudste die de API kent:
// anders belooft de intro 2009 terwijl er 2006 onderaan staat.
const oldest = [list[list.length - 1]?.season.label, preArchive.at(-1)?.season]
  .filter((label): label is string => Boolean(label))
  .map((label) => label.slice(0, 4))
  .sort()[0];
const newest = list[0]?.season.label.slice(-4);

const seasonUrl = (entry: (typeof list)[number]) =>
  entry.season.isRunning
    ? url('/intraclub/')
    : url(`/intraclub/seizoen/${entry.season.slug}/`);

const decimal = (value: number) => value.toFixed(2).replace('.', ',');
---

<Layout
  title="Erelijst intraclub"
  description={`Wie de intraclub van BC Landegem won, seizoen per seizoen, van ${oldest} tot ${newest}.`}
>
  <div class="bg-feather-100">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-16">
      <RailHeading
        title="Erelijst"
        accent="cork"
        continuous
        intro={`Wie het seizoen op kop afsloot, van ${oldest} tot vandaag.`}
      >
      </RailHeading>

      <ol class="relative mt-12 pl-10">
        {/* Statische rail: dezelfde grammatica als de speeluren, zonder script. */}
        <span
          class="absolute bottom-3 left-[6px] top-2 w-1 -translate-x-1/2 bg-cork-400"
          aria-hidden="true"></span>

        {list.map((entry) => (
          <li class="relative border-b border-ink-950/10 last:border-0">
            <a
              href={seasonUrl(entry)}
              class="group block py-4 transition-transform duration-300 hover:translate-x-2"
            >
              {/* Op de rail-x: de bol staat 6px vanaf de linkerrand van de lijst,
                  dus 2.5rem terug vanaf de inhoud, en dan half over de lijn heen. */}
              <span
                class:list={[
                  'absolute left-[calc(-2.5rem+6px)] top-[1.4rem] h-3.5 w-3.5 -translate-x-1/2 rounded-full ring-4 ring-feather-100 transition-transform duration-300 group-hover:scale-125',
                  entry.winner ? 'bg-cork-400' : 'bg-feather-100 inset-ring-2 inset-ring-cork-400',
                ]}
                aria-hidden="true"></span>

              <span class="type-label block text-xs text-cork-600">
                {entry.season.label}
                {/* Alleen wanneer het seizoen ook echt nog loopt: van juni tot
                    september blijft de API hetzelfde seizoen "current" noemen. */}
                {entry.season.isRunning && <span class="ml-2 text-ink-500">lopend seizoen</span>}
              </span>

              {entry.winner ? (
                <>
                  <span class="mt-1 block font-bold text-ink-950 group-hover:text-cork-600">
                    {entry.winner.name}
                  </span>
                  <span class="mt-0.5 block text-sm text-ink-500">
                    <span class="type-numeral text-ink-700">{decimal(entry.winner.average)}</span>
                    {' gemiddelde · '}
                    <span class="type-numeral text-ink-700">{entry.season.players_count}</span>
                    {' spelers · '}
                    <span class="type-numeral text-ink-700">{entry.season.rounds_count}</span>
                    {' speeldagen'}
                    {entry.note && <span class="text-ink-500">{' · '}{entry.note}</span>}
                  </span>

                  {/*
                    Een tweede regel, geen tweede kolom: op een telefoon zou een
                    kolommenrij van drie namen omvallen, en de rail draagt hier
                    één punt per seizoen.
                  */}
                  {entry.women && (
                    <span class="mt-1.5 block text-sm text-ink-500">
                      <span class="type-label text-[0.65rem] text-cork-600">Dames</span>{' '}
                      {entry.women.name === entry.winner?.name ? (
                        <span>dezelfde, zij won ook de algemene stand</span>
                      ) : (
                        <>
                          <span class="text-ink-700">{entry.women.name}</span>
                          {' · '}
                          <span class="type-numeral text-ink-700">{decimal(entry.women.average)}</span>
                        </>
                      )}
                    </span>
                  )}
                </>
              ) : (
                /*
                  Een seizoen zonder bewaarde eindstand. De rail loopt door en de
                  uitslagen blijven bereikbaar — een leeg tabelletje zou hier
                  lezen als een fout in plaats van als een gat in het archief.
                */
                <>
                  <span class="mt-1 block font-bold text-ink-700">Geen eindstand bewaard</span>
                  <span class="mt-0.5 block text-sm text-ink-500">
                    De <span class="type-numeral text-ink-700">{entry.season.rounds_count}</span>
                    {' speeldagen van dat seizoen staan er wel.'}
                  </span>
                </>
              )}
            </a>
          </li>
        ))}
      </ol>

      {/*
        Onder de rail, niet erin. De rail draagt berekende cijfers uit de API;
        deze namen zijn met de hand uit de clubadministratie gehaald en hebben
        geen gemiddelde, geen spelersaantal en geen speeldagen. Ze tussen de
        railpunten zetten zou die twee soorten data door elkaar halen — en het
        gat tussen 2006-2007 en 2009-2010 zou lezen als een fout in plaats van
        als het einde van wat bewaard is.
      */}
      {preArchive.length > 0 && (
        <section class="mt-14 border-t border-ink-950/10 pl-10 pt-8">
          <h2 class="type-label text-xs text-cork-600">Vóór het archief</h2>
          <p class="mt-2 max-w-2xl text-sm text-ink-500">
            Wat er van de oudere seizoenen teruggevonden is in de clubadministratie. 
            Toen werden de standen per Excel doorgestuurd via e-mail.<br/> Vanaf 2007-2008 werd er overgeschakeld naar een online systeem, maar de eindstanden van 2007-2008 en 2008-2009 zijn niet bewaard gebleven. De eerste seizoenen van het online systeem, vanaf 2009-2010, zijn wél volledig terug te vinden in het archief.
          </p>

          <dl class="mt-6">
            {preArchive.map((row) => (
              <div class="border-b border-ink-950/10 py-4 last:border-0">
                <dt class="type-label text-xs text-cork-600">{row.season}</dt>
                <dd class="mt-1">
                  <span class="block font-bold text-ink-950">{row.winner}</span>
                  {row.women && (
                    <span class="mt-1.5 block text-sm text-ink-500">
                      <span class="type-label text-[0.65rem] text-cork-600">Dames</span>{' '}
                      {row.women === row.winner ? (
                        <span>dezelfde, zij won ook de algemene stand</span>
                      ) : (
                        <span class="text-ink-700">{row.women}</span>
                      )}
                    </span>
                  )}
                  {row.note && <span class="mt-1 block text-sm text-ink-500">{row.note}</span>}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )}
    </div>
  </div>
</Layout>

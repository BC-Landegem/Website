---
import Layout from '../../../layouts/Layout.astro';
import RailHeading from '../../../components/RailHeading.astro';
import { url } from '../../../lib/url';
import { playerUrl, decimal, displayName, formatDate } from '../../../lib/intra';
import {
  getData,
  allCareers,
  currentFormatCareer,
  prewarm,
  seasonSlug,
  type CareerPerson,
  type CareerSeason,
  type CareerRound,
  type ArchivePlayerDetail,
  type ArchiveStanding,
  type ArchiveRound,
} from '../../../lib/intra-build';

export async function getStaticPaths() {
  /*
   * Iedereen die ooit meespeelde: de 200 uit het archief plus wie ná de
   * formaatwissel lid werd. Alleen het archief nemen zou betekenen dat de helft
   * van de namen in een eindstand klikbaar is en de andere helft niet — en dat
   * leest als een bug, niet als een keuze.
   */
  await prewarm();
  const people = await allCareers();
  return people.map((person) => ({ params: { slug: person.slug }, props: { person } }));
}

interface Props {
  person: CareerPerson;
}

const { person } = Astro.props;

/*
 * De plaats en het eindgemiddelde staan niet bij de speler maar in de eindstand
 * van elk seizoen. Die zijn er maar zeventien en ze zitten in de build-cache,
 * dus kosten ze hier niets extra — hoeveel loopbaanpagina's er ook zijn.
 */
let archiveRows: CareerSeason[] = [];
let basePoints: number | null = null;

if (person.archiveId) {
  /*
   * Mét de wedstrijden erbij. Zwaarder antwoord, maar het is de enige manier om
   * te weten op welke speeldagen deze persoon er was: het archief kent geen
   * aanwezigheidsvlag, en zijn verloop bevat ook de avonden zonder hem. Voor de
   * vier oudste seizoenen (2009-2013) is er zelfs helemaal geen verloop — daar
   * zijn de wedstrijden het énige spoor dat hij er stond.
   */
  const detail = await getData<
    ArchivePlayerDetail & { ranking_history?: (CareerRound & { season_id: number; round_id: number })[] }
  >(`/archive/players/${person.archiveId}?include=games`);
  const seasons = detail.seasons ?? [];
  basePoints = seasons[0]?.base_points ?? null;

  const played = new Set((detail.games ?? []).map((game) => game.round_id));
  const history = new Map<number, Map<number, CareerRound>>();
  for (const row of detail.ranking_history ?? []) {
    if (!played.has(row.round_id)) continue;
    const group = history.get(row.season_id) ?? new Map<number, CareerRound>();
    group.set(row.round_id, {
      number: row.number,
      date: row.date,
      average: row.average,
      day_score: null,
      rank: null,
    });
    history.set(row.season_id, group);
  }

  archiveRows = await Promise.all(
    seasons.map(async (season) => {
      const [standings, rounds] = await Promise.all([
        getData<ArchiveStanding[]>(`/archive/seasons/${season.season_id}/standings`),
        getData<ArchiveRound[]>(`/archive/seasons/${season.season_id}/rounds`),
      ]);
      const index = standings.findIndex((row) => row.archive_player_id === person.archiveId);
      const stand = index >= 0 ? standings[index] : null;

      // De speeldagen waarop hij speelde, met het gemiddelde erbij waar het
      // bewaard is. Zo krijgt ook 2009-2013 een lijst in plaats van een lege
      // uitklap: nummer, datum en een weg naar de uitslagen.
      const stored = history.get(season.season_id);
      const rounds_ = rounds
        .filter((round) => played.has(round.id))
        .map((round) => ({
          number: round.number,
          date: round.date,
          average: stored?.get(round.id)?.average ?? null,
          day_score: null,
          rank: null,
        }));

      return {
        slug: seasonSlug(season.season_name),
        label: seasonSlug(season.season_name),
        rank: stand ? index + 1 : null,
        field: standings.length,
        average: stand?.average ?? null,
        sets: season.sets,
        games: season.games,
        present: season.rounds.present,
        rounds_count: rounds.length,
        history: rounds_,
      } satisfies CareerSeason;
    }),
  );
}

const currentRows = person.playerId ? await currentFormatCareer(person.playerId) : [];
const rows = [...archiveRows, ...currentRows].sort((a, b) => a.slug.localeCompare(b.slug));

const totalGames = rows.reduce((sum, row) => sum + row.games.total, 0);
const best = rows.filter((row) => row.rank !== null).sort((a, b) => a.rank! - b.rank!)[0];
const name = displayName(person.name) || 'Onbekende speler';
// Twee formats naast elkaar: "gewonnen wedstrijden" bestaat alleen links van 2023.
const mixedFormats = currentRows.length > 0 && archiveRows.length > 0;

// Zes kolommen die de summary en de kop delen, zodat de rij uitlijnt als een tabel
// maar wél kan openklappen. Onder sm stapelt alles; daar zetten labels de kolommen.
const columns = 'grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-[7rem_7rem_4.5rem_5rem_5rem_5rem]';
---

{/*
  noindex: deze pagina gaat over één persoon en zijn cijfers. Bereikbaar via de
  eindstanden en via de eigen spelerspagina, niet vindbaar op naam in Google.
*/}
<Layout
  title={`${name} — intraclub loopbaan`}
  description={`Alle intraclubseizoenen van ${name} bij BC Landegem.`}
  noindex
>
  <div class="bg-feather-100">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-16">
      <div class="pl-10">
        <a
          href={url('/intraclub/erelijst/')}
          class="type-label inline-flex items-center gap-2 text-xs text-cork-600 hover:underline"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4m0 0l6-6m-6 6l6 6" />
          </svg>
          Erelijst
        </a>
      </div>

      <div class="mt-3">
        <RailHeading title={name} accent="cork" />
      </div>

      <div class="mt-6 max-w-4xl pl-10">
        {rows.length === 0 ? (
          <p class="text-ink-700">
            Van deze speler is geen enkel volledig seizoen bewaard — enkel losse vermeldingen in
            uitslagen.
          </p>
        ) : (
          <>
            <p class="text-ink-700">
              {rows.length === 1
                ? `Speelde één seizoen mee: ${rows[0].label}.`
                : `Speelde ${rows.length} seizoenen mee, van ${rows[0].label} tot ${rows[rows.length - 1].label}.`}
              {totalGames > 0 && ` Samen ${totalGames} wedstrijden.`}
              {best?.rank && ` Beste eindplaats: ${best.rank} van ${best.field}, in ${best.label}.`}
            </p>
            <p class="mt-2 text-sm text-ink-500">
              Klap een seizoen open voor de speeldagen waarop {name.split(" ")[0]} speelde.
            </p>

            {/* Kolomkoppen los van de lijst: de rijen zijn geen tabel maar
                uitklapbare blokken, en delen hetzelfde raster. */}
            <div
              class:list={['mt-8 hidden border-b-[3px] border-ink-950/20 pb-2.5 sm:grid', columns]}
              aria-hidden="true"
            >
              <span class="type-label pl-6 text-xs text-cork-600">Seizoen</span>
              <span class="type-label text-right text-xs text-cork-600">Plaats</span>
              <span class="type-label text-right text-xs text-cork-600">Gem.</span>
              <span class="type-label text-right text-xs text-cork-600">Sets</span>
              <span class="type-label text-right text-xs text-cork-600">Matchen</span>
              <span class="type-label text-right text-xs text-cork-600">Aanwezig</span>
            </div>

            <div class="mt-2 sm:mt-0">
              {rows.map((row) => (
                <details id={row.slug} class="group border-b border-ink-950/10">
                  <summary class="cursor-pointer list-none py-3 hover:bg-cork-300/10">
                    <span class:list={['items-baseline', columns]}>
                      <span class="col-span-2 flex items-baseline gap-2 sm:col-span-1">
                        {/* Chevron als getekende SVG, niet als teken: iconen op deze
                            site zijn altijd inline SVG. */}
                        <svg
                          class="h-4 w-4 shrink-0 text-cork-600 transition-transform duration-300 group-open:rotate-90"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                        <span class="font-semibold text-cork-600">{row.label}</span>
                      </span>

                      <span class="type-numeral text-right text-sm">
                        <span class="type-label mr-2 text-[0.65rem] text-ink-500 sm:hidden">Plaats</span>
                        {row.rank ? (
                          <>
                            {row.rank}<span class="text-ink-500"> van {row.field}</span>
                          </>
                        ) : (
                          /* Dat seizoen heeft geen bewaarde eindstand, of deze
                             speler haalde er de stand niet. */
                          <span class="text-ink-950/30">–</span>
                        )}
                      </span>

                      <span class="type-numeral text-right text-sm">
                        <span class="type-label mr-2 text-[0.65rem] text-ink-500 sm:hidden">Gem.</span>
                        {decimal(row.average)}
                      </span>

                      <span class="type-numeral text-right text-sm">
                        <span class="type-label mr-2 text-[0.65rem] text-ink-500 sm:hidden">Sets</span>
                        {row.sets.won}<span class="text-ink-500">/{row.sets.total}</span>
                      </span>

                      {/* Het aantal gespeelde wedstrijden bestaat in beide formats;
                          een gewónnen wedstrijd alleen in het oude. */}
                      <span class="type-numeral text-right text-sm">
                        <span class="type-label mr-2 text-[0.65rem] text-ink-500 sm:hidden">Matchen</span>
                        {row.games.won === null ? (
                          <span class="text-ink-950/30">–</span>
                        ) : (
                          row.games.won
                        )}
                        <span class="text-ink-500">/{row.games.total}</span>
                      </span>

                      <span class="type-numeral text-right text-sm">
                        <span class="type-label mr-2 text-[0.65rem] text-ink-500 sm:hidden">Aanwezig</span>
                        {row.present}
                      </span>
                    </span>
                  </summary>

                  <div class="pb-5 pl-6 pt-1">
                    {row.history.length === 0 ? (
                      <p class="text-sm text-ink-500">
                        Van dit seizoen is niet bijgehouden welke speeldagen hij speelde — enkel de eindtotalen
                        hierboven en de <a
                          href={url(`/intraclub/seizoen/${row.slug}/`)}
                          class="font-semibold text-cork-600 underline">uitslagen van elke speeldag</a
                        >.
                      </p>
                    ) : (
                      <>
                        <div class="overflow-x-auto">
                          <table class="w-full max-w-xl text-left text-sm">
                            <thead>
                              <tr class="border-b border-ink-950/10">
                                <th scope="col" class="type-label pb-2 text-xs text-ink-500">Speeldag</th>
                                <th scope="col" class="type-label pb-2 text-xs text-ink-500">Datum</th>
                                {row.history.some((r) => r.day_score !== null) && (
                                  <th scope="col" class="type-label pb-2 text-right text-xs text-ink-500">
                                    Die avond
                                  </th>
                                )}
                                {/* Voor 2009-2013 bewaarde het archief geen enkel gemiddelde per
                                    speeldag; een kolom vol streepjes is dan geen informatie. */}
                                {row.history.some((r) => r.average !== null) && (
                                  <th scope="col" class="type-label pb-2 text-right text-xs text-ink-500">
                                    Gemiddelde
                                  </th>
                                )}
                                {row.history.some((r) => r.rank !== null) && (
                                  <th scope="col" class="type-label pb-2 text-right text-xs text-ink-500">
                                    Plaats
                                  </th>
                                )}
                              </tr>
                            </thead>
                            <tbody>
                              {row.history.map((round) => (
                                <tr class="border-b border-ink-950/10 last:border-0">
                                  <td class="py-2">
                                    <a
                                      href={url(`/intraclub/seizoen/${row.slug}/speeldag/${round.number}/`)}
                                      class="type-numeral text-cork-600 hover:underline"
                                    >
                                      {round.number}
                                    </a>
                                  </td>
                                  <td class="py-2 text-ink-500">{formatDate(round.date)}</td>
                                  {row.history.some((r) => r.day_score !== null) && (
                                    <td class="type-numeral py-2 text-right text-ink-700">
                                      {round.day_score === null ? (
                                        <span class="text-ink-950/30">uitgeloot</span>
                                      ) : (
                                        decimal(round.day_score)
                                      )}
                                    </td>
                                  )}
                                  {row.history.some((r) => r.average !== null) && (
                                    <td class="type-numeral py-2 text-right text-ink-950">
                                      {round.average === null ? (
                                        <span class="text-ink-950/30">–</span>
                                      ) : (
                                        decimal(round.average)
                                      )}
                                    </td>
                                  )}
                                  {row.history.some((r) => r.rank !== null) && (
                                    <td class="type-numeral py-2 text-right text-ink-700">
                                      {round.rank ?? '–'}
                                    </td>
                                  )}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                        <p class="mt-3 text-xs text-ink-500">
                          {row.history.length} van de {row.rounds_count || row.history.length} speeldagen — de avonden
                          waarop hij niet speelde staan er niet bij.
                          {row.history.every((r) => r.average === null)
                            ? ' Van dit seizoen bewaarde het archief per speeldag niets meer dan de datum — geen gemiddelde, geen plaats. De uitslagen zelf staan er wel.'
                            : row.history.every((r) => r.rank === null) &&
                              ' Het archief bewaarde per speeldag alleen het gemiddelde; de plaats van toen en wat die avond opbracht, zijn niet mee overgezet.'}
                        </p>
                      </>
                    )}
                  </div>
                </details>
              ))}
            </div>

            <p class="mt-6 text-xs text-ink-500">
              De uitslagen zelf staan bij de speeldagen van elk seizoen.
              {mixedFormats &&
                ' Vanaf 2023-2024 verandert het format: vier spelers per baan met een andere combinatie per set. Een wedstrijd heeft daar geen winnend team meer, dus staat er in die kolom enkel het aantal gespeelde wedstrijden.'}
              {basePoints !== null && ` Basispunten in het eerste seizoen: ${decimal(basePoints)}.`}
            </p>
          </>
        )}

        {person.playerId && (
          <a
            href={playerUrl(person.playerId)}
            class="group mt-10 flex items-baseline justify-between gap-4 border-l-2 border-club-500 bg-club-50 px-5 py-4 transition-colors hover:bg-club-100"
          >
            <span>
              <span class="type-label block text-[0.65rem] text-club-700">Het lopende seizoen</span>
              <span class="mt-1 block text-sm text-ink-700">
                Sets, aanwezigheid en klassementsverloop van {name} in de stand van vandaag.
              </span>
            </span>
            <span class="type-label shrink-0 text-xs text-ink-950 group-hover:text-club-700" aria-hidden="true">
              Bekijk
            </span>
          </a>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  /*
   * Een link uit een eindstand wijst naar #2011-2012. Zonder script scrolt de
   * browser daar netjes naartoe met het blok dicht; met script staat het meteen
   * open, want dát is waarvoor er geklikt werd.
   */
  function openSeason() {
    if (!location.hash) return;
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (!(target instanceof HTMLDetailsElement)) return;
    target.open = true;
    target.scrollIntoView({ block: 'center', behavior: 'instant' });
  }

  openSeason();
  addEventListener('hashchange', openSeason);
</script>

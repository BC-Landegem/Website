---
import Layout from '../../../../../layouts/Layout.astro';
import Heading from '../../../../../components/Heading.astro';
import Dot from '../../../../../components/Dot.astro';
import { url } from '../../../../../lib/url';
import { formatDate, decimal } from '../../../../../lib/intra';
import type { Attendance, Game, Player } from '../../../../../lib/intra';
import {
  allSeasons,
  getData,
  prewarm,
  type SeasonEntry,
  type ArchiveRound,
  type ArchiveRoundDetail,
} from '../../../../../lib/intra-build';
import type { Round } from '../../../../../lib/intra';

export async function getStaticPaths() {
  // Alles in één parallelle ronde ophalen; hierna leest elke pagina uit de cache.
  await prewarm();
  const seasons = (await allSeasons()).filter((season) => !season.isRunning);

  const paths = await Promise.all(
    seasons.map(async (season) => {
      const rounds =
        season.format === 'archive'
          ? await getData<ArchiveRound[]>(`/archive/seasons/${season.id}/rounds`)
          : await getData<Round[]>(`/rounds?season=${season.id}`);
      return rounds.map((round) => ({
        params: { slug: season.slug, number: String(round.number) },
        props: { season, roundId: round.id },
      }));
    }),
  );

  return paths.flat();
}

interface Props {
  season: SeasonEntry;
  roundId: number;
}

const { season, roundId } = Astro.props;

/** Eén wedstrijd, in de vorm waarin de pagina ze tekent. */
interface Match {
  /**
   * Bij vaste teams (oud format) staan de namen één keer boven de sets; bij het
   * huidige format wisselt de samenstelling per set en is er dus geen kop.
   */
  header: { home: string[]; away: string[]; setsHome: number; setsAway: number } | null;
  sets: {
    label: string;
    home: string[];
    away: string[];
    /**
     * De score staat gesplitst zodat het winnende cijfer vet kan. Bij vaste
     * teams is dat de enige aanwijzing wie won: op mobiel vallen de twee
     * kolommen onder elkaar, en dan zegt links-of-rechts niets meer.
     */
    scoreHome: string;
    scoreAway: string;
    winner: 'home' | 'away' | null;
    bonus: { home: number; away: number } | null;
  }[];
}

let date = '';
let courts = 0;
let averageAbsent = 0;
let present: number | null = null;
let drawnOut = 0;
let matches: Match[] = [];
let attendees: Attendance[] = [];

if (season.format === 'archive') {
  // Zwaar antwoord dat maar één pagina nodig heeft: bewust langs de cache heen.
  const round = await getData<ArchiveRoundDetail>(`/archive/rounds/${roundId}`);
  date = round.date;
  // Het detailantwoord van het archief telt de wedstrijden niet; de lijst doet
  // dat wel. Hier is games.length hetzelfde getal en scheelt het een call.
  courts = round.games.length;
  averageAbsent = round.average_absent;

  const names = (players: { full_name: string }[]) => players.map((player) => player.full_name);
  matches = round.games.map((game) => ({
    header: {
      home: names(game.team1),
      away: names(game.team2),
      setsHome: game.sets_won.team1,
      setsAway: game.sets_won.team2,
    },
    sets: game.sets.map((set, i) => ({
      label: `Set ${i + 1}`,
      home: [],
      away: [],
      scoreHome: String(set.team1),
      scoreAway: String(set.team2),
      winner: set.team1 === set.team2 ? null : set.team1 > set.team2 ? 'home' : 'away',
      bonus: null,
    })),
  }));
} else {
  const round = await getData<
    Round & { games: Game[]; attendances: Attendance[] }
  >(`/rounds/${roundId}`);
  date = round.date;
  courts = round.games_count;
  averageAbsent = round.average_absent;
  present = round.players_present;
  drawnOut = round.players_drawn_out;

  matches = round.games.map((game) => {
    const byId = new Map(game.players.map((player) => [player.id, player]));
    const names = (ids: number[]) =>
      ids.map((id) => (byId.get(id) as Player | undefined)?.full_name ?? '').filter(Boolean);
    return {
      header: null,
      sets: game.sets.map((set) => ({
        label: `Set ${set.number}`,
        home: names(set.home.player_ids),
        away: names(set.away.player_ids),
        scoreHome: set.is_played ? String(set.home.score) : '–',
        scoreAway: set.is_played ? String(set.away.score) : '–',
        winner: set.winner,
        bonus: { home: set.home.bonus, away: set.away.bonus },
      })),
    };
  });

  // Zelfde regel als op de levende speeldagpagina: wie er niet was, krijgt hier
  // geen naam. Het gevolg — het verliezersgemiddelde — staat er wel als getal.
  attendees = (round.attendances ?? [])
    .filter((row) => row.is_present || row.is_drawn_out)
    .sort((a, b) => (b.day_score ?? -1) - (a.day_score ?? -1));
}

const summary = [
  formatDate(date),
  present !== null ? `${present} aanwezig` : null,
  `${courts} ${courts === 1 ? 'baan' : 'banen'}`,
  drawnOut ? `${drawnOut} uitgeloot` : null,
]
  .filter(Boolean)
  .join(' · ');
---

{/*
  noindex: een speeldag gaat over wie er die avond was en wat ze scoorden. Dat
  hoort bereikbaar te zijn voor wie de link heeft, niet vindbaar op naam.
*/}
<Layout
  title={`Intraclub ${season.label} — speeldag ${Astro.params.number}`}
  description={`De uitslagen van speeldag ${Astro.params.number} van het intraclubseizoen ${season.label}.`}
  noindex
>
  <div class="bg-feather-100">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-16">
      <div class="relative pl-10">
        <Dot top="top-11" />
        <span class="absolute bottom-1 left-[6px] top-[3.75rem] w-1 -translate-x-1/2 rounded-full bg-cork-400" aria-hidden="true"></span>
        <span class="absolute bottom-0 left-[6px] h-2 w-2 -translate-x-1/2 rounded-full bg-cork-400" aria-hidden="true"></span>
        <p>
          <a
            href={url(`/intraclub/seizoen/${season.slug}/`)}
            class="type-label inline-flex items-center gap-2 text-xs text-cork-600 hover:underline"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4m0 0l6-6m-6 6l6 6" />
            </svg>
            Seizoen {season.label}
          </a>
        </p>
        <h1 class="type-display mt-3 page-heading text-ink-950">Speeldag {Astro.params.number}</h1>
        <p class="mt-3 text-ink-700">{summary}</p>
      </div>

      <div class="mt-12 max-w-3xl pl-10">
        <p class="mb-6 text-sm text-ink-500">
          {season.format === 'archive'
            ? 'Twee vaste teams per baan, best of three. Het winnende team staat in het vet.'
            : 'Vier spelers per baan, elke set een andere samenstelling. Het winnende duo staat in het vet; het kleine cijfer is de som van hun bonuspunten.'}
        </p>

        <div class="space-y-4">
          {matches.map((match) => (
            <div class="border border-ink-950/10 bg-feather-50 p-4 text-sm">
              {match.header && (
                <p class="mb-2 flex flex-wrap items-baseline gap-x-2 border-b border-ink-950/10 pb-2 text-ink-950">
                  <span class:list={[match.header.setsHome > match.header.setsAway && 'font-bold']}>
                    {match.header.home.join(' & ')}
                  </span>
                  <span class="type-numeral bg-feather-100 px-2 py-0.5 text-xs">
                    {match.header.setsHome}–{match.header.setsAway}
                  </span>
                  <span class:list={[match.header.setsAway > match.header.setsHome && 'font-bold']}>
                    {match.header.away.join(' & ')}
                  </span>
                </p>
              )}
              {match.sets.map((set) => (
                <div class="grid grid-cols-[2.75rem_minmax(0,1fr)] items-center gap-x-2 gap-y-0.5 border-b border-ink-950/5 py-2 last:border-0 sm:grid-cols-[2.75rem_minmax(0,1fr)_auto_minmax(0,1fr)] sm:border-0 sm:py-1">
                  <span class="type-label text-xs text-ink-500">{set.label}</span>
                  {/*
                    Het winnende cijfer staat vet. Bij vaste teams is dat de enige
                    aanwijzing wie de set won: de namen staan in de kop, en onder
                    sm vallen de twee kolommen onder elkaar.
                  */}
                  <span class="type-numeral min-w-14 justify-self-start bg-feather-100 px-2 py-0.5 text-center sm:col-start-3 sm:row-start-1 sm:justify-self-auto">
                    <span class:list={[set.winner === 'home' && 'font-bold']}>{set.scoreHome}</span>
                    <span class="text-ink-500">–</span>
                    <span class:list={[set.winner === 'away' && 'font-bold']}>{set.scoreAway}</span>
                  </span>
                  {/* Bij vaste teams draagt de rij enkel de score; de namen staan boven. */}
                  {!match.header && (
                    <>
                      <span
                        class:list={[
                          'col-start-2 hyphens-auto break-words sm:row-start-1 sm:text-right',
                          set.winner === 'home' && 'font-semibold',
                        ]}
                      >
                        {set.home.join(' & ')}
                        {set.bonus && (
                          <span class="type-numeral ml-1 text-[0.65rem] font-normal text-ink-500">
                            +{set.bonus.home}
                          </span>
                        )}
                      </span>
                      <span
                        class:list={[
                          'col-start-2 hyphens-auto break-words sm:col-start-4 sm:row-start-1',
                          set.winner === 'away' && 'font-semibold',
                        ]}
                      >
                        {set.away.join(' & ')}
                        {set.bonus && (
                          <span class="type-numeral ml-1 text-[0.65rem] font-normal text-ink-500">
                            +{set.bonus.away}
                          </span>
                        )}
                      </span>
                    </>
                  )}
                </div>
              ))}
            </div>
          ))}
        </div>

        {attendees.length > 0 && (
          <section class="mt-14">
            <Heading size="small">Wie er was</Heading>
            <p class="mb-6 mt-3 text-sm text-ink-500">
              De dagscore is wat deze avond opleverde; het gemiddelde ernaast is de stand ná die
              verrekening.
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead>
                  <tr class="type-label border-b-[3px] border-ink-950/20 text-xs text-cork-600">
                    <th class="w-full py-2.5 pr-3 font-bold">Naam</th>
                    <th class="whitespace-nowrap py-2.5 pr-3 text-right font-bold">Dagscore</th>
                    <th class="whitespace-nowrap py-2.5 pr-3 text-right font-bold">Gemiddelde</th>
                    <th class="whitespace-nowrap py-2.5 text-right font-bold">Plaats</th>
                  </tr>
                </thead>
                <tbody>
                  {attendees.map((row) => (
                    <tr class="border-b border-ink-950/10">
                      <td class="w-full py-2.5 pr-3">{row.player.full_name}</td>
                      <td class="type-numeral whitespace-nowrap py-2.5 pr-3 text-right">
                        {row.is_drawn_out && row.day_score === null
                          ? 'uitgeloot'
                          : decimal(row.day_score)}
                      </td>
                      <td class="type-numeral whitespace-nowrap py-2.5 pr-3 text-right">
                        {decimal(row.average)}
                      </td>
                      <td class="type-numeral whitespace-nowrap py-2.5 text-right">
                        {row.rank ?? '–'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <p class="mt-8 text-sm text-ink-500">
          Wie er niet was, kreeg {decimal(averageAbsent)} — het gemiddelde van de verliezers
          van deze speeldag.
        </p>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import RailHeading from '../../components/RailHeading.astro';
import Heading from '../../components/Heading.astro';
import { url } from '../../lib/url';
import { playerUrl, decimal, seasonLabel } from '../../lib/intra';
import { getData, allSeasons } from '../../lib/intra-build';
import type { Player } from '../../lib/intra';

interface SeasonRef {
  id: number;
  name: string;
}

interface BestSeason {
  player: Player;
  season: SeasonRef;
  average: number;
  rank: number;
  players_ranked: number;
}

interface Streak {
  player: Player;
  season: SeasonRef;
  length: number;
  from_round: number;
  to_round: number;
  rounds_in_season: number;
}

interface Duo {
  players: Player[];
  games: number;
  sets: number;
  sets_won: number;
}

interface Records {
  best_seasons: BestSeason[];
  longest_streaks: Streak[];
  most_played_duos: Duo[];
}

/*
 * Twee afwijkingen op deze endpoint, allebei bewust:
 * ?season= weglaten betekent hier *alle* seizoenen, niet het lopende — een
 * clubrecord over één seizoen is er geen. En ?limit= geldt per lijst.
 */
const records = await getData<Records>('/records?limit=10');
const seasons = await allSeasons();
const huidig = seasons.filter((season) => season.format === 'huidig');
const vanaf = huidig[0]?.label.slice(0, 4);

/**
 * Vijf mensen die alle zeventien speeldagen haalden zijn geen ranglijst maar
 * één record dat vijf keer gedeeld wordt. Genummerd tonen zou een volgorde
 * suggereren die er niet is, dus groeperen we op lengte.
 */
const reeksen = new Map<number, Streak[]>();
for (const streak of records.longest_streaks ?? []) {
  const groep = reeksen.get(streak.length) ?? [];
  groep.push(streak);
  reeksen.set(streak.length, groep);
}
const reeksGroepen = [...reeksen.entries()].sort((a, b) => b[0] - a[0]).slice(0, 3);

const namenlijst = (namen: string[]) =>
  namen.length === 1
    ? namen[0]
    : `${namen.slice(0, -1).join(', ')} en ${namen[namen.length - 1]}`;
---

<Layout
  title="Clubrecords intraclub"
  description="De clubrecords van de intraclub van BC Landegem: beste seizoenen, langste reeksen aanwezig en het meest gespeelde duo."
>
  <div class="mx-auto max-w-5xl px-4 py-14 sm:py-16">
    <div class="pl-10">
      <a
        href={url('/intraclub/erelijst/')}
        class="type-label inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4m0 0l6-6m-6 6l6 6" />
        </svg>
        Erelijst
      </a>
    </div>

    <div class="mt-3">
      <RailHeading
        title="Clubrecords"
        intro={`Sinds ${vanaf}, toen het format veranderde naar vier spelers per baan met een andere combinatie per set.`}
      >
        <p class="mt-3 max-w-2xl text-sm text-ink-500">
          De veertien seizoenen daarvoor doen niet mee: die speelden met vaste teams in best of
          three, dus een dagscore van toen is niet hetzelfde getal. Zij staan in de <a
            href={url('/intraclub/erelijst/')}
            class="font-semibold text-club-700 underline hover:text-club-800">erelijst</a
          >.
        </p>
      </RailHeading>
    </div>

    {/* ------------------------------------------------------ beste seizoenen */}
    <section class="mt-14 max-w-3xl pl-10">
      <Heading size="small">Beste seizoenen</Heading>
      <p class="mb-6 mt-3 text-sm text-ink-500">
        Het aantal spelers staat erbij omdat een gemiddelde alleen iets zegt tegenover het veld
        waarin het behaald is. Dezelfde naam mag twee keer voorkomen: het zijn twee seizoenen.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="type-label border-b-[3px] border-ink-950/20 text-xs text-club-700">
              <th class="w-full py-2.5 pr-3 font-bold">Speler</th>
              <th class="whitespace-nowrap py-2.5 pr-3 text-right font-bold">Gemiddelde</th>
              <th class="whitespace-nowrap py-2.5 pr-3 text-right font-bold">Plaats</th>
              <th class="whitespace-nowrap py-2.5 font-bold">Seizoen</th>
            </tr>
          </thead>
          <tbody>
            {(records.best_seasons ?? []).map((row) => (
              <tr class="border-b border-ink-950/10">
                <td class="w-full py-2.5 pr-3">
                  <a href={playerUrl(row.player.id)} class="font-medium hover:text-club-600 hover:underline">
                    {row.player.full_name}
                  </a>
                </td>
                <td class="type-numeral whitespace-nowrap py-2.5 pr-3 text-right">
                  {decimal(row.average)}
                </td>
                <td class="type-numeral whitespace-nowrap py-2.5 pr-3 text-right">
                  {row.rank}<span class="text-ink-500"> van {row.players_ranked}</span>
                </td>
                <td class="whitespace-nowrap py-2.5 text-ink-500">{seasonLabel(row.season.name)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* -------------------------------------------------------- altijd aanwezig */}
    <section class="mt-14 max-w-3xl pl-10">
      <Heading size="small">Altijd aanwezig</Heading>
      <p class="mb-6 mt-3 text-sm text-ink-500">
        De langste reeks speeldagen op rij. Wie een volledig seizoen haalt, deelt dat record met
        iedereen die hetzelfde deed — vandaar geen nummers.
      </p>
      <ul class="border-t border-ink-950/10">
        {reeksGroepen.map(([lengte, groep]) => (
          <li class="border-b border-ink-950/10 py-4">
            <p class="type-numeral text-2xl text-ink-950">
              {lengte}
              <span class="text-base text-ink-500"> speeldagen op rij</span>
            </p>
            <p class="mt-1.5 text-sm text-ink-700">
              {namenlijst(groep.map((streak) => streak.player.full_name))}
            </p>
            <p class="mt-1 text-xs text-ink-500">
              {[...new Set(groep.map((streak) => seasonLabel(streak.season.name)))].join(', ')}
              {groep.some((streak) => streak.length === streak.rounds_in_season) &&
                ' — een volledig seizoen'}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {/* ----------------------------------------------------- meest gespeelde duo */}
    <section class="mt-14 max-w-3xl pl-10">
      <Heading size="small">Meest gespeelde duo</Heading>
      <p class="mb-6 mt-3 text-sm text-ink-500">
        Wie het vaakst samen op een baan stond. Op één baan speel je precies één set met elk van de
        drie anderen, dus is het aantal sets samen gelijk aan het aantal avonden.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="type-label border-b-[3px] border-ink-950/20 text-xs text-club-700">
              <th class="w-full py-2.5 pr-3 font-bold">Duo</th>
              <th class="whitespace-nowrap py-2.5 pr-3 text-right font-bold">Avonden</th>
              <th class="whitespace-nowrap py-2.5 text-right font-bold">Sets samen gewonnen</th>
            </tr>
          </thead>
          <tbody>
            {(records.most_played_duos ?? []).map((duo) => (
              <tr class="border-b border-ink-950/10">
                <td class="w-full py-2.5 pr-3">
                  {duo.players.map((speler, i) => (
                    <>
                      {i > 0 && <span class="text-ink-500"> &amp; </span>}
                      <a href={playerUrl(speler.id)} class="font-medium hover:text-club-600 hover:underline">
                        {speler.full_name}
                      </a>
                    </>
                  ))}
                </td>
                <td class="type-numeral whitespace-nowrap py-2.5 pr-3 text-right">{duo.games}</td>
                <td class="type-numeral whitespace-nowrap py-2.5 text-right">
                  {duo.sets_won}<span class="text-ink-500">/{duo.sets}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* ------------------------------------------------------------ wat er niet staat */}
    <section class="mt-14 max-w-3xl pl-10">
      <div class="border-l-2 border-club-500 bg-club-50 px-5 py-4 text-sm text-ink-700">
        <p class="type-label text-[0.65rem] text-club-700">Twee lijsten die hier niet staan</p>
        <p class="mt-2">
          De API houdt ook <strong class="font-bold">beste avonden</strong> en
          <strong class="font-bold">grootste sprong in één speeldag</strong> bij. Die staan er niet,
          omdat ze vooral hun eigen rekenregel meten: een dagscore van 21,00 betekent "alle drie de
          sets gewonnen" en komt zo vaak voor dat de lijst een rangschikking wordt tussen mensen die
          precies hetzelfde deden. En de grootste sprongen komen structureel uit speeldag 1 naar 2,
          wanneer het veld nog op een kluitje ligt en een halve punt tientallen plaatsen waard is.
        </p>
      </div>
    </section>
  </div>
</Layout>

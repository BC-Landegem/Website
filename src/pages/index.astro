---
import { Image } from 'astro:assets';
import Heading from '../components/Heading.astro';
import Dot from '../components/Dot.astro';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { url } from '../lib/url';
import trainings from '../data/trainings.json';
import hero from '../assets/hero.jpg';
import { visibleAlbums, photoData, monthName, coverUrl } from '../lib/media';

const CORK = { x: 80, y: 700 };
const ray = (angleDegrees: number, length: number) => ({
  x: CORK.x + length * Math.cos((angleDegrees * Math.PI) / 180),
  y: CORK.y - length * Math.sin((angleDegrees * Math.PI) / 180),
});
// Verenkrans: 16 stralen die vanuit het kurkpunt (80,700) openwaaieren, van 16° tot 82°
const rays = Array.from({ length: 16 }, (_, i) =>
  ray(16 + i * (66 / 15), i % 4 === 0 ? 540 : i % 2 === 1 ? 400 : 470),
);
// Drie gevulde veren tussen de stralen
const feathers = [
  { a: ray(24, 500), b: ray(33, 500), fill: 'var(--color-feather-200)', opacity: 0.6 },
  { a: ray(46, 540), b: ray(54, 540), fill: 'var(--color-cork-300)', opacity: 0.35 },
  { a: ray(66, 480), b: ray(73, 480), fill: 'var(--color-club-100)', opacity: 0.55 },
];

// Drie veren aan de draad: jeugd, recreatief, competitie. De class-strings
// staan integraal in de data (Tailwind scant geen samengestelde namen).
const cards = [
  {
    href: '/jeugd/',
    title: 'Jeugd',
    text: 'Vanaf 8 jaar. Vrij spel op woensdagavond, zonder selectie. Wie er klaar voor is, traint op zaterdag mee in groep 1 of 2.',
    linkText: 'Alles over de jeugdwerking',
    clip: 'polygon(0 10%, 100% 0, 100% 100%, 0 100%)',
    cardClass: 'col-span-12 -rotate-1 bg-ink-950 text-feather-50 sm:col-span-7 sm:col-start-3 sm:p-10',
    titleClass: 'text-4xl text-white transition-colors group-hover:text-club-300',
    textClass: 'max-w-md text-feather-200',
    linkClass: 'text-club-300',
  },
  {
    href: '/recreatief/',
    title: 'Recreatief',
    text: 'Vrij spel op maandag, woensdag en zondag. Je hoeft je niet in te schrijven voor een uur: je komt en je speelt.',
    linkText: 'Alles over recreatief spelen',
    clip: 'polygon(0 0, 100% 10%, 100% 100%, 0 100%)',
    cardClass: 'col-span-11 col-start-2 rotate-[1.25deg] bg-club-500 text-ink-950 sm:col-span-5 sm:col-start-8 sm:-mt-12',
    titleClass: 'text-3xl text-white',
    textClass: 'font-medium',
    linkClass: '',
  },
  {
    href: '/competitie/',
    title: 'Competitie',
    text: 'Onze ploegen spelen in de Liga- en PBO-competitie. Volg hun kalender, verslagen en standen.',
    linkText: 'Naar de ploegen',
    clip: 'polygon(0 8%, 100% 0, 100% 96%, 0 100%)',
    cardClass: 'col-span-12 -rotate-[0.75deg] bg-feather-200 text-ink-950 sm:col-span-6 sm:col-start-4 sm:-mt-8',
    titleClass: 'text-3xl',
    textClass: 'max-w-sm text-ink-700',
    linkClass: 'text-club-700',
  },
];

// Laatste foto's: de nieuwste albums dragen de homepage-strook. Ze komen uit
// dezelfde nachtelijke sync als /media/ — geen redactie, geen dood blok: is er
// niets gesynct, dan valt de sectie weg.
const photoAlbum = visibleAlbums[0];
const latestPhotos = photoAlbum ? photoData[photoAlbum.slug].photos.slice(0, 5) : [];
// Veerblad-snedes, afwisselend per tegel (zie DESIGN.md).
const photoCuts = [
  'polygon(0 8%, 100% 0, 100% 92%, 0 100%)',
  'polygon(0 0, 100% 8%, 100% 100%, 0 92%)',
];
---

<Layout>
  <div id="page" class="relative">
    {/* Hero: de shuttle lanceert vanuit het kurkpunt */}
    <section class="@container relative isolate flex min-h-[88vh] items-center overflow-hidden">
      {/* Natuurlijke aspectverhouding (geen max-h): zo blijft het kurkpunt exact op
           breedte/18 van de linkeronderhoek en valt het samen met de Word-lid-bol.
           Op lage viewports knipt overflow-hidden enkel de top van de krans af. */}
      <svg
        class="absolute bottom-0 left-0 -z-10 h-auto w-[max(100%,75rem)]"
        viewBox="0 0 1440 780"
        aria-hidden="true"
      >
        {/* Skirtbogen van de verenkrans */}
        <circle cx={CORK.x} cy={CORK.y} r="300" fill="none" stroke="var(--color-ink-950)" stroke-opacity="0.08" stroke-width="1.5" stroke-dasharray="3 10" />
        <circle cx={CORK.x} cy={CORK.y} r="440" fill="none" stroke="var(--color-ink-950)" stroke-opacity="0.06" stroke-width="1.5" stroke-dasharray="3 14" />
        {/* Gevulde veren */}
        {feathers.map((feather) => (
          <path
            d={`M ${CORK.x} ${CORK.y} L ${feather.a.x} ${feather.a.y} L ${feather.b.x} ${feather.b.y} Z`}
            fill={feather.fill}
            opacity={feather.opacity}
          />
        ))}
        {/* Stralen */}
        {rays.map((s) => (
          <line x1={CORK.x} y1={CORK.y} x2={s.x} y2={s.y} stroke="var(--color-ink-950)" stroke-opacity="0.1" stroke-width="1.5" />
        ))}
      </svg>

      {/* Het clublogo: statisch op het hangmoment, achter de hero-inhoud maar vóór
           de rode vluchtlijn (zie z-index op #page). Vanaf 900px staat het
           volledige logo er — pluim mét de getekende clubnaam — zodat het
           hangmoment een clubsignatuur is en niet enkel een mikpunt voor de draad.
           Het moet daarvoor groot en rechtop staan: op pluimmaat wordt de
           getekende naam een veeg, en gekanteld leest hij niet. Die 900px is
           nagemeten, niet gekozen: de herokop springt vanaf md in met ml-[22%] en
           meet op text-6xl zo'n 470px, dus pas rond 900px ligt de rechterbovenhoek
           vrij. Smaller draagt de hero de losse pluim in zijn oude stand. In beide
           bestanden staat de pluim op dezelfde plek in het kader, dus het
           hangmoment verschuift niet mee. De draad landt op het midden van deze box
           (zie lib/thread.ts) — dat midden ligt in de pluim, niet in de naam. */}
      <div
        id="shuttle-glyph"
        class="pointer-events-none absolute right-[5%] top-8 -z-[1] w-20 overflow-visible min-[900px]:top-16 min-[900px]:w-44"
        aria-hidden="true"
      >
        <picture>
          <source media="(min-width: 900px)" srcset={url('/images/logo-bc1.svg')} />
          <img
            src={url('/images/logo-pluim.svg')}
            alt=""
            width="516"
            height="538"
            class="h-full w-full -rotate-12 object-contain min-[900px]:rotate-0"
          />
        </picture>
      </div>

      {/* Het kurkpunt is de primaire actie: Word lid! zit op de kurk */}
      <a
        id="cork-cta"
        href={url('/club/word-lid/')}
        class="type-label absolute z-20 flex h-28 w-28 -translate-x-1/2 translate-y-1/2 items-center justify-center rounded-full bg-club-600 px-3 text-center text-xs leading-snug text-white ring-4 ring-cork-400 ring-offset-4 ring-offset-feather-50 transition-transform duration-300 [transition-timing-function:var(--ease-launch)] hover:scale-110 sm:h-36 sm:w-36 sm:text-sm"
        style="left: calc(max(100cqw, 75rem) / 18); bottom: calc(max(100cqw, 75rem) / 18);"
      >
        Word lid!
      </a>

      {/* pt-32 + pluim op top-8, allebei tot 900px: samen 13px vrije band boven
           de kop, ook wanneer de hero-inhoud hoger is dan 88vh en de verticale
           centrering wegvalt (telefoons, ook in landscape) — anders schuift de
           titel achter de pluim. Vanaf 900px draagt de hero het volledige logo
           en ligt de rechterbovenhoek horizontaal vrij (zie hierboven). */}
      <div class="mx-auto w-full max-w-6xl px-4 pb-44 pt-32 sm:pb-52 md:pb-24 min-[900px]:pt-24">
        <div class="max-w-3xl md:ml-[22%]">
          <h1 class="type-display text-ink-950">
            <span class="block text-[clamp(2rem,10.2vw,3rem)] sm:text-6xl lg:text-7xl">Badminton</span>
            <span class="block text-[clamp(1.25rem,6.4vw,1.875rem)] sm:text-4xl lg:text-5xl">voor jong en oud</span>
            <span class="block text-[clamp(2rem,10.2vw,3rem)] text-club-500 sm:text-6xl lg:text-7xl">in Nevele</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-ink-700">
            Vrij spel op maandag, woensdag en zondag, jeugdtraining op zaterdag. Nieuwe spelers
            mogen drie keer gratis meespelen voor ze beslissen.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={url('/kalender/')}
              class="type-label rounded-full border-2 border-ink-950 px-7 py-3 text-sm text-ink-950 transition-colors hover:border-club-600 hover:text-club-600"
            >
              Bekijk de kalender
            </a>
          </div>
          {/* Ruimte vooraf gereserveerd (invisible i.p.v. hidden) zodat de hero
               niet verspringt wanneer de kalenderdata binnenkomt. */}
          <div id="next-moment" class="invisible mt-8 min-h-[4.5rem] max-w-xl text-sm text-ink-700">
            <p class="flex items-center gap-3">
              <span class="inline-block h-3 w-3 rounded-full bg-club-500" aria-hidden="true"></span>
              <span>Eerstvolgend speelmoment:&nbsp;<strong id="next-moment-day" class="type-numeral text-ink-950"></strong></span>
            </p>
            <ul id="next-moment-list" class="mt-2 space-y-1 pl-6"></ul>
          </div>
        </div>
      </div>
    </section>

    {/* De rode band rond de kurk. Anker voor de draad: op smalle schermen
         verspringt hij ván de rechtermarge náár de rail ín deze band, waar rood
         op rood onzichtbaar is (zie lib/thread.ts). */}
    <section id="red-band" class="border-y-8 border-club-800 bg-club-600 text-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-12">
        <div class="flex-[1_1_28rem]">
          <Heading color="inherit">Drie keer gratis meespelen</Heading>
          <p class="mt-2 max-w-xl text-xl font-bold text-white">
            Spring binnen tijdens een speelmoment in {trainings.location.name}. Afspreken hoeft niet, laten weten dat je komt is wel zo aangenaam.
          </p>
        </div>
        <div class="flex flex-col items-start gap-4">
          <a
            href={url('/club/word-lid/')}
            class="type-label rounded-full bg-white px-7 py-3.5 text-sm text-club-600 transition-colors hover:bg-club-50"
          >
            Zo begin je
          </a>
          {/* Op de club-600-band is álle tekst wit: ink-950 haalt daar geen 4,5:1. Rangorde komt van grootte en gewicht. */}
          <a
            href={url('/folder/bc-landegem-folder-2026.pdf')}
            class="type-label inline-flex items-center gap-2 text-xs text-white transition-colors hover:underline"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0l-5-5m5 5l5-5M5 20h14" />
            </svg>
            Download de folder 2026
          </a>
        </div>
      </div>
    </section>

    {/* Intra top-10: het interne klassement als meetpunt op de draad.
         Live uit de intra-API; skeletrijen reserveren de ruimte zodat de
         pagina niet verspringt. Onbereikbaar? Dan klapt de sectie dicht. */}
    <section id="intra-section">
      <div class="mx-auto max-w-6xl px-4 py-20">
        <div class="grid gap-y-10 md:grid-cols-12 md:gap-x-12">
          <div class="relative pl-10 md:col-span-5">
            <Dot id="dot-intra" top="top-2.5" />
            <Heading size="large">Intra top-10</Heading>
            <p class="mt-3 text-ink-700">
              Onze interne competitie: vier spelers per match, elke set een ander duo,
              het hele seizoen lang één klassement.
            </p>
            <p id="intra-standing-after" class="type-label mt-4 min-h-4 text-xs text-club-700"></p>
            <a
              href={url('/intraclub/')}
              class="type-label mt-8 inline-flex items-center gap-2 rounded-full border-2 border-ink-950 px-7 py-3 text-sm text-ink-950 transition-colors hover:border-club-600 hover:text-club-600"
            >
              Bekijk de volledige stand
              <Arrow class="h-4 w-4 transition-transform duration-300" />
            </a>
          </div>
          {/* Op mobiel dezelfde rail-inspringing als de rest, zodat de draad links van de nummers loopt */}
          <ol id="intra-top10" class="self-start pl-10 md:col-span-7 md:pl-0">
            {Array.from({ length: 10 }).map(() => (
              <li class="skeleton grid min-h-12 grid-cols-[2.5rem_1fr_auto] items-center gap-x-3 border-b border-ink-950/10 py-2.5 first:border-t" aria-hidden="true">
                <span class="h-4 w-5 animate-pulse rounded bg-ink-950/10"></span>
                <span class="h-4 w-2/3 max-w-48 animate-pulse rounded bg-ink-950/10"></span>
                <span class="h-4 w-10 animate-pulse rounded bg-ink-950/10"></span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {/* Wanneer we spelen: vijf speelmomenten als meetpunten op de draad */}
    <section class="mx-auto max-w-6xl px-4 py-20">
      {/* Kop op de rail-inspringing, zodat de draad links van de letters loopt */}
      <Heading size="large" class="pl-10">Wanneer we spelen</Heading>
      <p class="mt-3 max-w-xl pl-10 text-ink-700">
        Alle trainingen en speelmomenten gaan door in {trainings.location.name}, {trainings.location.municipality}.
      </p>
      <ol id="play-hours-list" class="relative mt-12">
        {trainings.sessions.map((session) => (
          <li class="flight group relative border-b border-ink-950/10 py-6 pl-10 first:border-t">
            {/* De bol blijft op de draad (schaalt enkel); alleen de inhoud schuift op hover */}
            <Dot top="top-8" grows />
            <div class="transition-transform duration-300 [transition-timing-function:var(--ease-launch)] group-hover:translate-x-2 sm:grid sm:grid-cols-[8rem_16rem_1fr] sm:items-baseline sm:gap-6">
              <p class="type-label text-xs text-club-700">{session.day}</p>
              <p class="type-numeral mt-1 text-2xl text-ink-950 sm:mt-0 sm:text-3xl">{session.hours}</p>
              <div class="mt-1 sm:mt-0">
                <p class="font-bold">{session.description}</p>
                <p class="text-sm text-ink-500">{session.audience}</p>
                {session.note && <p class="text-sm text-ink-500">{session.note}</p>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* Komende events: skeletrijen reserveren de ruimte zodat de pagina niet
         verspringt; zonder data klapt de sectie dicht. */}
    <section id="events-section" class="border-y border-ink-950/10">
      <div class="mx-auto max-w-6xl px-4 py-20">
        <h2 class="type-display pl-10 text-4xl text-ink-950">Binnenkort in de club</h2>
        <ol id="events-list" class="relative mt-10">
          {Array.from({ length: 4 }).map(() => (
            <li class="skeleton relative border-b border-ink-950/10 py-5 pl-10 first:border-t" aria-hidden="true">
              <span class="absolute left-[6px] top-7 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-ink-950/10"></span>
              <span class="block h-6 w-44 max-w-full animate-pulse rounded bg-ink-950/10"></span>
              <span class="mt-2 block h-5 w-64 max-w-full animate-pulse rounded bg-ink-950/10"></span>
              <span class="mt-2 block h-4 w-36 max-w-full animate-pulse rounded bg-ink-950/10"></span>
            </li>
          ))}
        </ol>
        <p class="mt-8 pl-10">
          <a href={url('/kalender/')} class="type-label inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
            Bekijk de volledige kalender
            <Arrow />
          </a>
        </p>
      </div>
    </section>

    {/* Drie veren aan de draad: jeugd, recreatief, competitie */}
    <section class="mx-auto max-w-6xl px-4 py-24">
      <h2 class="sr-only">Wat de club te bieden heeft</h2>
      <div class="grid grid-cols-12 gap-y-5">
        {cards.map((card) => (
          <a
            href={url(card.href)}
            class={`flight group p-8 transition-transform duration-300 [transition-timing-function:var(--ease-launch)] hover:-translate-y-2 ${card.cardClass}`}
            style={`clip-path: ${card.clip}`}
          >
            <h3 class={`type-display ${card.titleClass}`}>{card.title}</h3>
            <p class={`mt-3 text-sm leading-relaxed ${card.textClass}`}>{card.text}</p>
            <span class={`type-label mt-6 inline-flex items-center gap-2 text-xs ${card.linkClass}`}>
              {card.linkText}
              <Arrow class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        ))}
      </div>
    </section>

    {/* Laatste foto's: het clubleven als bewijs, vers uit de albums. De foto's
         hangen op Google's CDN — dat antwoordt met 429 zodra er een vreemde
         referer meekomt, vandaar referrerpolicy per beeld. Paginabreed zetten
         kan hier niet: de Google Calendar-key ís referrer-restricted. */}
    {latestPhotos.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-24">
        <div class="pl-10">
          <Heading size="large">Uit de club</Heading>
          <p class="mt-3 max-w-xl text-ink-700">
            De laatste foto's uit onze albums — {photoAlbum.title}, {monthName(photoAlbum.date)}.
          </p>
        </div>
        <a
          href={url(`/media/${photoAlbum.slug}/`)}
          class="group mt-10 grid grid-cols-2 gap-4 pl-10 sm:grid-cols-3 lg:grid-cols-5"
          aria-label={`Alle foto's van ${photoAlbum.title}`}
        >
          {latestPhotos.map((photo, i) => (
            <img
              src={coverUrl(photo.url, 640, 640)}
              width="640"
              height="640"
              alt=""
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              class:list={[
                'flight aspect-square w-full bg-ink-950/5 object-cover transition-transform duration-300 group-hover:-translate-y-1',
                i === 4 && 'hidden lg:block',
              ]}
              style={`clip-path: ${photoCuts[i % 2]}`}
            />
          ))}
        </a>
        <p class="mt-8 pl-10">
          <a href={url('/media/')} class="type-label inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
            Alle fotoalbums
            <Arrow />
          </a>
        </p>
      </section>
    )}

    {/* Sinds 1987: één stille regel op de draad */}
    <section class="mx-auto max-w-6xl px-4 pb-24">
      <div class="relative pl-10">
        <Dot id="dot-1987" top="top-2" />
        <p class="type-numeral text-2xl text-ink-950">1987</p>
        <p class="mt-1 max-w-xl text-ink-700">
          Begonnen als een gemeentelijke initiatiecursus. Vandaag heeft de club een jeugdwerking,
          vrij spel op vier dagen en ploegen in competitie.
        </p>
        <a href={url('/club/over-de-club/')} class="type-label mt-3 inline-block text-xs text-club-700 hover:text-club-800 hover:underline">
          Lees hoe het begon
        </a>
      </div>
    </section>

    {/* Slot: de leren dop */}
    <section id="closing-section" class="relative overflow-hidden bg-ink-950 text-feather-50">
      {/* Staart van de vluchtdraad: landt op de foto, achter de tekst */}
      <svg id="thread-tail-svg" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
        <path id="thread-tail" fill="none" stroke="var(--color-club-500)" stroke-width="4" stroke-linecap="round" />
      </svg>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 md:grid-cols-2">
        <div>
          <Heading size="large" color="white">Zin om mee te spelen?</Heading>
          <p class="mt-4 max-w-md text-feather-200">
            Kom eerst eens meespelen tijdens een speelmoment, of schrijf je meteen in.
          </p>
          <div id="closing-buttons" class="mt-8 flex flex-wrap gap-4">
            <a
              id="closing-cta"
              href={url('/club/word-lid/')}
              class="type-label rounded-full bg-club-600 px-7 py-3.5 text-sm text-white transition-colors hover:bg-club-700"
            >
              Word lid!
            </a>
            <a
              href={url('/kalender/')}
              class="type-label rounded-full border-2 border-feather-200/40 px-7 py-3 text-sm text-feather-50 transition-colors hover:border-club-400 hover:text-club-300"
            >
              Bekijk de kalender
            </a>
          </div>
        </div>
        <figure id="closing-photo" style="clip-path: polygon(0 8%, 100% 0, 100% 92%, 0 100%)">
          <Image
            src={hero}
            alt="Badmintonwedstrijd van de club in de sporthal"
            widths={[640, 1024, 1600]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="h-full max-h-96 w-full object-cover"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    {/* De vluchtdraad: één doorlopende rode lijn van kurk tot slot, altijd zichtbaar.
         Hij loopt achter de inhoud en duikt onder de rode band door. */}
    <svg id="thread" class="pointer-events-none absolute inset-0 -z-[2] h-full w-full" aria-hidden="true">
      <path id="thread-core" fill="none" stroke="var(--color-club-500)" stroke-width="4" stroke-linecap="round" />
    </svg>
  </div>
</Layout>

{/* Zonder JS komt er nooit data: verberg dan de gereserveerde blokken,
     zodat er geen eeuwig pulserende skeletten staan. */}
<style is:global>
  html:not(.js) #next-moment,
  html:not(.js) #intra-section,
  html:not(.js) #events-section {
    display: none;
  }
</style>

<script>
  import trainings from '../data/trainings.json';
  import { groupFromTitle } from '../data/calendar';
  import { initThread } from '../lib/thread';
  import {
    NOW,
    dayKey,
    timeText,
    dateText,
    isHomeMatch,
    fetchCalendar,
    type CalendarItem,
  } from '../lib/calendar-client';
  import { fetchApi, playerUrl, formatDate, seasonState, seasonLabel } from '../lib/intra';
  import type { RankingRow, RankingMeta } from '../lib/intra';

  // De vluchtdraad en de landing-animatie leven in lib/thread.ts; `rebuild`
  // herberekent de draad zodra een sectie van hoogte verandert of dichtklapt.
  const { rebuild } = initThread();

  function esc(text: string): string {
    const span = document.createElement('span');
    span.textContent = text;
    return span.innerHTML;
  }

  // — Kalenderdata: de hero-chip ("Eerstvolgend speelmoment") en "Binnenkort
  //   in de club" putten uit één gedeelde pass over alle bronnen
  //   (lib/calendar-client.ts). De ruimte is vooraf gereserveerd (skeletten)
  //   zodat de pagina niet verspringt; enkel zonder enige data klapt een blok
  //   alsnog dicht — de vaste uren staan in "Wanneer we spelen". —

  // "Landegem 1H, 2H en 4H" — de clubnaam één keer, de rest kort.
  function teamListing(teams: string[]): string {
    const short = [teams[0], ...teams.slice(1).map((team) => team.replace('Landegem ', ''))];
    return short.length > 1 ? `${short.slice(0, -1).join(', ')} en ${short[short.length - 1]}` : short[0];
  }

  // — Hero-chip: alles wat er op de eerstvolgende speeldag in de zaal gebeurt.
  //   De dag komt van het eerste speelmoment; thuismatchen (gebundeld per
  //   beginuur, zoals in "Binnenkort in de club") en wat er die dag op de
  //   Events-kalender staat horen erbij — wie langskomt, komt het tegen. Tijden
  //   komen uit de kalender, teksten uit de vaste labels per bron
  //   (kalendertitels zijn interne jargon; events dragen wél een leesbare
  //   titel). —
  function showPlayMoments(items: CalendarItem[]) {
    const chip = document.getElementById('next-moment');
    const chipDay = document.getElementById('next-moment-day');
    const chipList = document.getElementById('next-moment-list');
    const moments = items.filter((item) => item.source.playSlot || isHomeMatch(item));
    const first = moments[0];
    if (!chip || !chipDay || !chipList) return;
    if (!first) {
      // Geen speelmoment binnen het venster: gereserveerde ruimte weer vrijgeven.
      chip.classList.add('hidden');
      return;
    }

    const key = dayKey(first.start);
    chipDay.textContent =
      key === dayKey(NOW)
        ? 'vandaag'
        : key === dayKey(new Date(NOW.getTime() + 24 * 60 * 60 * 1000))
          ? 'morgen'
          : first.start.toLocaleDateString('nl-BE', { weekday: 'long' });

    // Bij een gelijk beginuur: eerst wat je zelf komt doen, dan de matchen, dan
    // wat er die dag óók nog gebeurt.
    const rank = (item: CalendarItem) => (item.source.playSlot ? 0 : isHomeMatch(item) ? 1 : 2);
    const ofTheDay = items
      .filter(
        (item) =>
          dayKey(item.start) === key &&
          (item.source.playSlot || isHomeMatch(item) || item.source.label === 'Events'),
      )
      .sort((a, b) => a.start.getTime() - b.start.getTime() || rank(a) - rank(b));

    interface Row {
      time: string;
      text: string;
      audience: string;
      tail: string;
      /** Gezet op matchrijen: de ploegen die samen thuisspelen. */
      teams?: string[];
    }
    const rows: Row[] = [];
    const matchRows = new Map<number, Row>();
    for (const item of ofTheDay) {
      // Een event van een hele dag heeft geen zinnig uur om te tonen.
      const time = !item.event.start.dateTime
        ? 'hele dag'
        : item.end
          ? `${timeText(item.start)} – ${timeText(item.end)}`
          : timeText(item.start);
      const tail = item.start <= NOW && item.end !== null && NOW < item.end ? ' — nu bezig' : '';
      if (item.source.playSlot) {
        // De groep (jeugd zaterdag: groep 1 en 2) moet overal zichtbaar zijn.
        const group = groupFromTitle(item.event.summary);
        const { description, audience } = item.source.playSlot;
        rows.push({ time, text: `${description}${group ? ` ${group}` : ''}`, audience, tail });
      } else if (isHomeMatch(item)) {
        // Ploegen die samen beginnen delen één regel; anders zet een
        // competitieweekend hier vijf bijna-identieke regels neer.
        const shared = matchRows.get(item.start.getTime());
        if (shared) {
          shared.teams!.push(item.source.label);
          continue;
        }
        // "vanaf": de Badminton Vlaanderen-import zet er blokken van één uur
        // op, terwijl een matchdag uren duurt — zoals in "Binnenkort".
        const row: Row = {
          time: `vanaf ${timeText(item.start)}`,
          text: '',
          audience: 'supporters welkom',
          tail,
          teams: [item.source.label],
        };
        matchRows.set(item.start.getTime(), row);
        rows.push(row);
      } else {
        rows.push({ time, text: item.event.summary ?? 'Event', audience: 'event', tail });
      }
    }

    for (const row of rows) {
      const li = document.createElement('li');
      const time = document.createElement('strong');
      time.className = 'type-numeral text-ink-950';
      time.textContent = row.time;
      const text = row.teams
        ? `${row.teams.length > 1 ? 'Thuismatchen' : 'Thuismatch'} — ${teamListing(row.teams)}`
        : row.text;
      li.append(time, ` · ${text}${row.tail} `);
      const audienceEl = document.createElement('span');
      audienceEl.className = 'text-ink-500';
      audienceEl.textContent = `(${row.audience})`;
      li.append(audienceEl);
      chipList.append(li);
    }
    chip.classList.remove('invisible');
  }

  // — "Binnenkort in de club": events (zonder venster), de eerstvolgende
  //   intraclub-speeldag en thuismatchen gegroepeerd per dag — één rij per
  //   bezoekmoment, zodat een competitieweekend de events niet verdringt. —
  function showUpcoming(items: CalendarItem[]) {
    interface Row {
      start: Date;
      when: string;
      title: string;
      place: string | null;
      isEvent?: boolean;
    }
    const rows: Row[] = [];

    for (const item of items.filter((i) => i.source.label === 'Events')) {
      const place = item.event.location;
      rows.push({
        start: item.start,
        when: `${dateText(item.start)}${item.event.start.dateTime ? ` · ${timeText(item.start)}` : ''}`,
        title: item.event.summary ?? 'Event',
        place: place && place.toLowerCase() !== 'onbekend' ? place : null,
        isEvent: true,
      });
    }

    const intraclub = items.find((item) => item.source.label === 'Intraclub');
    if (intraclub) {
      rows.push({
        start: intraclub.start,
        when: `${dateText(intraclub.start)} · ${timeText(intraclub.start)}`,
        title: 'Intraclub + vrij spel',
        place: trainings.location.name,
      });
    }

    const matchDays = new Map<string, CalendarItem[]>();
    for (const item of items.filter(isHomeMatch)) {
      const key = dayKey(item.start);
      matchDays.set(key, [...(matchDays.get(key) ?? []), item]);
    }
    for (const matches of matchDays.values()) {
      const listing = teamListing(matches.map((match) => match.source.label));
      rows.push({
        start: matches[0].start,
        when: `${dateText(matches[0].start)} · vanaf ${timeText(matches[0].start)}`,
        title: `${matches.length > 1 ? 'Thuismatchen' : 'Thuismatch'} — ${listing}`,
        place: `${trainings.location.name}, ${trainings.location.municipality}`,
      });
    }

    const section = document.getElementById('events-section');
    const list = document.getElementById('events-list');
    if (!section || !list) return;
    if (!rows.length) {
      section.classList.add('hidden');
      return;
    }
    list.textContent = ''; // skeletrijen ruimen
    // Max. 6 rijen, maar events overleven de cap altijd: in volle
    // competitieperiodes zouden matchdagen ze anders alsnog verdringen.
    rows.sort((a, b) => a.start.getTime() - b.start.getTime());
    const events = rows.filter((row) => row.isEvent).slice(0, 6);
    const rest = rows.filter((row) => !row.isEvent).slice(0, 6 - events.length);
    const selection = [...events, ...rest].sort((a, b) => a.start.getTime() - b.start.getTime());
    for (const row of selection) {
      const li = document.createElement('li');
      li.className = 'relative border-b border-ink-950/10 py-5 pl-10 first:border-t';
      li.innerHTML = `
        <span class="absolute left-[6px] top-7 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-feather-50" aria-hidden="true"></span>
        <p class="type-numeral text-lg text-club-700">${esc(row.when)}</p>
        <p class="mt-0.5 font-bold">${esc(row.title)}</p>
        ${row.place ? `<p class="mt-0.5 text-sm text-ink-500">${esc(row.place)}</p>` : ''}`;
      list.append(li);
    }
  }

  async function loadCalendar() {
    const all = await fetchCalendar();
    if (!all.length) {
      // Geen enkele bron bereikbaar: gereserveerde blokken opruimen.
      document.getElementById('next-moment')?.classList.add('hidden');
      document.getElementById('events-section')?.classList.add('hidden');
    } else {
      showPlayMoments(all);
      showUpcoming(all);
    }
    rebuild();
  }

  loadCalendar();

  // — Intra top-10 uit de intra-API; de skeletrijen reserveren de ruimte,
  //   faalt de API of is de stand leeg, dan klapt de sectie dicht. —
  async function loadIntra() {
    const section = document.getElementById('intra-section')!;

    try {
      // Eén verzoek volstaat nu: `meta.round` zegt zelf na welke speeldag de
      // stand geldt, dus de aparte /rounds-call ernaast is weg. Wat blijft is
      // de vraag of dat seizoen nog loopt — de API heeft daar geen vlag voor en
      // geeft van juni tot september een eindstand alsof het de stand van deze
      // week is.
      const { data, meta } = await fetchApi<RankingRow[], RankingMeta>(
        '/rankings/general?limit=10',
      );
      const rows = data ?? [];
      if (!rows.length) {
        section.classList.add('hidden');
        rebuild();
        return;
      }

      const list = document.getElementById('intra-top10')!;
      list.textContent = ''; // skeletrijen ruimen
      for (const row of rows) {
        const li = document.createElement('li');
        li.className =
          'grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-3 border-b border-ink-950/10 py-2.5 first:border-t';
        li.innerHTML = `
          <span class="type-numeral text-lg text-club-700">${row.rank}</span>
          <a href="${playerUrl(row.id)}" class="truncate font-bold text-ink-950 hover:text-club-600 hover:underline">${esc(row.full_name)}</a>
          <span class="type-numeral text-lg text-ink-950">${row.average.toFixed(2)}</span>`;
        list.append(li);
      }

      const round = meta?.round;
      if (round) {
        const staat = seasonState(round);
        document.getElementById('intra-standing-after')!.textContent =
          staat === 'af'
            ? `Eindstand ${seasonLabel(meta!.season.name)} · na speeldag ${round.number}`
            : `Stand na speeldag ${round.number} · ${formatDate(round.date)}`;
      }
      rebuild();
    } catch {
      section.classList.add('hidden');
      rebuild();
    }
  }

  loadIntra();
</script>

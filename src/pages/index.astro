---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout>
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 p-8 text-center">
    <img src={`${base}images/logo-bc1.svg`} alt="Logo BC Landegem" class="w-40" />
    <h1 class="text-4xl font-bold">Badmintonclub Landegem</h1>
    <p class="max-w-md text-lg text-neutral-600">
      De nieuwe website is in opbouw. Binnenkort vind je hier opnieuw alle info over de club,
      competitie, jeugd, intraclub en de kalender.
    </p>
    <span class="rounded-full bg-club-500 px-4 py-1 text-sm font-medium text-white">
      Site in opbouw
    </span>
  </main>
</Layout>

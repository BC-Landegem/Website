---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import trainingen from '../data/trainingen.json';
import hero from '../assets/hero.jpg';
---

<Layout>
  <!-- Hero -->
  <section class="relative">
    <Image
      src={hero}
      alt="Badmintonwedstrijd in de sporthal"
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      class="h-[60vh] min-h-96 w-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-neutral-950/40 to-neutral-950/20"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="mx-auto w-full max-w-6xl px-4 pb-12">
        <h1 class="max-w-2xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          Badminton voor jong en oud in Landegem
        </h1>
        <p class="mt-4 max-w-xl text-lg text-neutral-200">
          Recreatief of competitief, beginner of gevorderde: bij BC Landegem sla je altijd raak.
          Kom vrijblijvend een keertje meespelen!
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={url('/club/word-lid/')}
            class="rounded-full bg-club-500 px-6 py-3 font-semibold text-white transition hover:bg-club-600"
          >
            Word lid!
          </a>
          <a
            href={url('/kalender/')}
            class="rounded-full bg-white/10 px-6 py-3 font-semibold text-white backdrop-blur transition hover:bg-white/20"
          >
            Bekijk de kalender
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trainingsuren -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl font-bold tracking-tight">Wanneer we spelen</h2>
    <p class="mt-2 text-neutral-600">
      Alle trainingen en speelmomenten gaan door in {trainingen.locatie.naam}, {trainingen.locatie.gemeente}.
    </p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {trainingen.momenten.map((moment) => (
        <li class="rounded-xl border border-neutral-200 p-5 transition hover:border-club-300 hover:shadow-md">
          <p class="text-sm font-semibold uppercase tracking-wide text-club-600">{moment.dag}</p>
          <p class="mt-1 text-xl font-bold">{moment.uren}</p>
          <p class="mt-2 font-medium">{moment.omschrijving}</p>
          <p class="text-sm text-neutral-600">{moment.doelgroep}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Komende events: wordt in fase 4 gevuld vanuit Google Calendar -->

  <!-- CTA -->
  <section class="bg-club-500">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-12 text-center">
      <h2 class="text-3xl font-bold text-white">Zin om mee te spelen?</h2>
      <p class="max-w-xl text-club-50">
        Proefbeurten zijn altijd welkom — spring gerust eens binnen tijdens een speelmoment,
        of schrijf je meteen in.
      </p>
      <a
        href={url('/club/word-lid/')}
        class="rounded-full bg-white px-6 py-3 font-semibold text-club-600 transition hover:bg-club-50"
      >
        Kom vrijblijvend proberen
      </a>
    </div>
  </section>
</Layout>

---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Pijl from '../components/Pijl.astro';
import { url } from '../lib/url';
import trainingen from '../data/trainingen.json';
import hero from '../assets/hero.jpg';

const KURK = { x: 80, y: 700 };
const straal = (hoekGraden: number, lengte: number) => ({
  x: KURK.x + lengte * Math.cos((hoekGraden * Math.PI) / 180),
  y: KURK.y - lengte * Math.sin((hoekGraden * Math.PI) / 180),
});
// Verenkrans: 16 stralen die vanuit het kurkpunt (80,700) openwaaieren, van 16° tot 82°
const stralen = Array.from({ length: 16 }, (_, i) =>
  straal(16 + i * (66 / 15), i % 4 === 0 ? 540 : i % 2 === 1 ? 400 : 470),
);
// Drie gevulde veren tussen de stralen
const veren = [
  { a: straal(24, 500), b: straal(33, 500), fill: 'var(--color-veer-200)', opacity: 0.6 },
  { a: straal(46, 540), b: straal(54, 540), fill: 'var(--color-kurk-300)', opacity: 0.35 },
  { a: straal(66, 480), b: straal(73, 480), fill: 'var(--color-club-100)', opacity: 0.55 },
];

// Drie veren aan de draad: jeugd, recreatief, competitie. De class-strings
// staan integraal in de data (Tailwind scant geen samengestelde namen).
const kaarten = [
  {
    href: '/jeugd/',
    titel: 'Jeugd',
    tekst: 'Vrij spel op woensdagavond, training op zaterdag in twee groepen — van eerste racket tot geselecteerde jeugd.',
    clip: 'polygon(0 10%, 100% 0, 100% 100%, 0 100%)',
    kaartClass: 'col-span-12 -rotate-1 bg-inkt-950 text-veer-50 sm:col-span-7 sm:col-start-3 sm:p-10',
    titelClass: 'text-4xl text-white transition-colors group-hover:text-club-300',
    tekstClass: 'max-w-md text-veer-200',
    linkClass: 'text-club-300',
  },
  {
    href: '/club/word-lid/',
    titel: 'Recreatief',
    tekst: 'Vrij spel op maandag, woensdag en zondag. Iedereen speelt mee, op elk niveau.',
    clip: 'polygon(0 0, 100% 10%, 100% 100%, 0 100%)',
    kaartClass: 'col-span-11 col-start-2 rotate-[1.25deg] bg-club-500 text-inkt-950 sm:col-span-5 sm:col-start-8 sm:-mt-12',
    titelClass: 'text-3xl text-white',
    tekstClass: 'font-medium',
    linkClass: '',
  },
  {
    href: '/competitie/',
    titel: 'Competitie',
    tekst: 'Onze ploegen spelen competitie — volg de wedstrijden, verslagen en standen.',
    clip: 'polygon(0 8%, 100% 0, 100% 96%, 0 100%)',
    kaartClass: 'col-span-12 -rotate-[0.75deg] bg-veer-200 text-inkt-950 sm:col-span-6 sm:col-start-4 sm:-mt-8',
    titelClass: 'text-3xl',
    tekstClass: 'max-w-sm text-inkt-700',
    linkClass: 'text-club-700',
  },
];
---

<Layout>
  <div id="pagina" class="relative">
    <!-- Hero: de shuttle lanceert vanuit het kurkpunt -->
    <section class="@container relative isolate flex min-h-[88vh] items-center overflow-hidden">
      <!-- Natuurlijke aspectverhouding (geen max-h): zo blijft het kurkpunt exact op
           breedte/18 van de linkeronderhoek en valt het samen met de Word-lid-bol.
           Op lage viewports knipt overflow-hidden enkel de top van de krans af. -->
      <svg
        class="absolute bottom-0 left-0 -z-10 h-auto w-[max(100%,75rem)]"
        viewBox="0 0 1440 780"
        aria-hidden="true"
      >
        <!-- Skirtbogen van de verenkrans -->
        <circle cx={KURK.x} cy={KURK.y} r="300" fill="none" stroke="var(--color-inkt-950)" stroke-opacity="0.08" stroke-width="1.5" stroke-dasharray="3 10" />
        <circle cx={KURK.x} cy={KURK.y} r="440" fill="none" stroke="var(--color-inkt-950)" stroke-opacity="0.06" stroke-width="1.5" stroke-dasharray="3 14" />
        <!-- Gevulde veren -->
        {veren.map((veer) => (
          <path
            d={`M ${KURK.x} ${KURK.y} L ${veer.a.x} ${veer.a.y} L ${veer.b.x} ${veer.b.y} Z`}
            fill={veer.fill}
            opacity={veer.opacity}
          />
        ))}
        <!-- Stralen -->
        {stralen.map((s) => (
          <line x1={KURK.x} y1={KURK.y} x2={s.x} y2={s.y} stroke="var(--color-inkt-950)" stroke-opacity="0.1" stroke-width="1.5" />
        ))}
      </svg>

      <!-- De shuttle op het hangmoment, neus in vliegrichting. Eigen SVG los van de
           verenkrans, zodat hij op elke viewporthoogte zichtbaar blijft (draad-anker). -->
      <svg
        id="shuttle-glyph"
        class="absolute right-[5%] top-16 w-16 overflow-visible sm:top-20 sm:w-24"
        viewBox="-16 -24 70 50"
        aria-hidden="true"
      >
        <g transform="rotate(-8)"><g class="vlucht" style="transition-delay: 1.4s">
          <path d="M 8 0 L 44 -16 L 40 -6 L 46 -4 L 42 3 L 47 6 L 41 12 L 44 18 L 8 0 Z" fill="var(--color-veer-50)" stroke="var(--color-inkt-950)" stroke-width="2" stroke-linejoin="round" />
          <circle cx="0" cy="0" r="10" fill="var(--color-kurk-400)" stroke="var(--color-inkt-950)" stroke-width="2" />
          <path d="M -10 0 A 10 10 0 0 0 10 0 Z" fill="var(--color-club-500)" />
        </g></g>
      </svg>

      <!-- Het kurkpunt is de primaire actie: Word lid! zit op de kurk -->
      <a
        id="kurk-cta"
        href={url('/club/word-lid/')}
        class="stem-baan absolute z-20 flex h-28 w-28 -translate-x-1/2 translate-y-1/2 items-center justify-center rounded-full bg-club-500 px-3 text-center text-xs leading-snug text-white ring-4 ring-kurk-400 ring-offset-4 ring-offset-veer-50 transition-transform duration-300 [transition-timing-function:var(--ease-lancering)] hover:scale-110 sm:h-36 sm:w-36 sm:text-sm"
        style="left: calc(max(100cqw, 75rem) / 18); bottom: calc(max(100cqw, 75rem) / 18);"
      >
        Word lid!
      </a>

      <div class="mx-auto w-full max-w-6xl px-4 pb-44 pt-24 sm:pb-52 md:py-24">
        <div class="max-w-3xl md:ml-[22%]">
          <h1 class="stem-display text-inkt-950">
            <span class="block text-[clamp(2rem,10.2vw,3rem)] sm:text-6xl lg:text-7xl">Badminton</span>
            <span class="block text-[clamp(1.25rem,6.4vw,1.875rem)] sm:text-4xl lg:text-5xl">voor jong en oud</span>
            <span class="block text-[clamp(2rem,10.2vw,3rem)] text-club-500 sm:text-6xl lg:text-7xl">in Nevele</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-inkt-700">
            Recreatief of competitief, beginner of gevorderde: bij BC Landegem sla je altijd raak.
            Kom vrijblijvend een keertje meespelen!
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={url('/kalender/')}
              class="stem-baan rounded-full border-2 border-inkt-950 px-7 py-3 text-sm text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
            >
              Bekijk de kalender
            </a>
          </div>
          <!-- Ruimte vooraf gereserveerd (invisible i.p.v. hidden) zodat de hero
               niet verspringt wanneer de kalenderdata binnenkomt. -->
          <div id="volgend-moment" class="invisible mt-8 min-h-[4.5rem] max-w-xl text-sm text-inkt-700">
            <p class="flex items-center gap-3">
              <span class="inline-block h-3 w-3 rounded-full bg-club-500" aria-hidden="true"></span>
              <span>Eerstvolgend speelmoment:&nbsp;<strong id="volgend-moment-dag" class="stem-cijfer text-inkt-950"></strong></span>
            </p>
            <ul id="volgend-moment-lijst" class="mt-2 space-y-1 pl-6"></ul>
          </div>
        </div>
      </div>
    </section>

    <!-- De rode band rond de kurk -->
    <section class="border-y-8 border-club-700 bg-club-500 text-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-12">
        <div class="flex-[1_1_28rem]">
          <h2 class="stem-display text-3xl sm:text-4xl">Proefbeurten altijd welkom</h2>
          <p class="mt-2 max-w-xl text-xl font-bold text-white">
            Spring gerust eens binnen tijdens een speelmoment in {trainingen.locatie.naam}.
          </p>
        </div>
        <div class="flex flex-col items-start gap-4">
          <a
            href={url('/club/word-lid/')}
            class="stem-baan rounded-full bg-white px-7 py-3.5 text-sm text-club-600 transition-colors hover:bg-club-50"
          >
            Kom vrijblijvend proberen
          </a>
          <!-- Kleine tekst op de rode band is inkt-950 (kleine-letter-regel) -->
          <a
            href={url('/folder/bc-landegem-folder-2026.pdf')}
            class="stem-baan inline-flex items-center gap-2 text-xs text-inkt-950 transition-colors hover:underline"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0l-5-5m5 5l5-5M5 20h14" />
            </svg>
            Download de folder 2026
          </a>
        </div>
      </div>
    </section>

    <!-- Intra top-10: het interne klassement als meetpunt op de draad.
         Live uit de intra-API; skeletrijen reserveren de ruimte zodat de
         pagina niet verspringt. Onbereikbaar? Dan klapt de sectie dicht. -->
    <section id="intra-sectie">
      <div class="mx-auto max-w-6xl px-4 py-20">
        <div class="grid gap-y-10 md:grid-cols-12 md:gap-x-12">
          <div class="relative pl-10 md:col-span-5">
            <span id="punt-intra" class="absolute left-[6px] top-2.5 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>
            <h2 class="stem-display text-4xl text-inkt-950 sm:text-5xl">Intra top-10</h2>
            <p class="mt-3 text-inkt-700">
              Onze interne competitie: vier spelers per match, elke set een ander duo,
              het hele seizoen lang één klassement.
            </p>
            <p id="intra-stand-na" class="stem-baan mt-4 min-h-4 text-xs text-club-700"></p>
            <a
              href={url('/intraclub/')}
              class="stem-baan mt-8 inline-flex items-center gap-2 rounded-full border-2 border-inkt-950 px-7 py-3 text-sm text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
            >
              Bekijk de volledige stand
              <Pijl class="h-4 w-4 transition-transform duration-300" />
            </a>
          </div>
          <!-- Op mobiel dezelfde rail-inspringing als de rest, zodat de draad links van de nummers loopt -->
          <ol id="intra-top10" class="self-start pl-10 md:col-span-7 md:pl-0">
            {Array.from({ length: 10 }).map(() => (
              <li class="skelet grid min-h-12 grid-cols-[2.5rem_1fr_auto] items-center gap-x-3 border-b border-inkt-950/10 py-2.5 first:border-t" aria-hidden="true">
                <span class="h-4 w-5 animate-pulse rounded bg-inkt-950/10"></span>
                <span class="h-4 w-2/3 max-w-48 animate-pulse rounded bg-inkt-950/10"></span>
                <span class="h-4 w-10 animate-pulse rounded bg-inkt-950/10"></span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Wanneer we spelen: vijf speelmomenten als meetpunten op de draad -->
    <section class="mx-auto max-w-6xl px-4 py-20">
      <!-- Kop op de rail-inspringing, zodat de draad links van de letters loopt -->
      <h2 class="stem-display pl-10 text-4xl text-inkt-950 sm:text-5xl">Wanneer we spelen</h2>
      <p class="mt-3 max-w-xl pl-10 text-inkt-700">
        Alle trainingen en speelmomenten gaan door in {trainingen.locatie.naam}, {trainingen.locatie.gemeente}.
      </p>
      <ol id="speeluren-lijst" class="relative mt-12">
        {trainingen.momenten.map((moment) => (
          <li class="vlucht group relative border-b border-inkt-950/10 py-6 pl-10 first:border-t">
            <!-- De bol blijft op de draad (schaalt enkel); alleen de inhoud schuift op hover -->
            <span class="absolute left-[6px] top-8 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50 transition-transform duration-300 group-hover:scale-125" aria-hidden="true"></span>
            <div class="transition-transform duration-300 [transition-timing-function:var(--ease-lancering)] group-hover:translate-x-2 sm:grid sm:grid-cols-[8rem_16rem_1fr] sm:items-baseline sm:gap-6">
              <p class="stem-baan text-xs text-club-700">{moment.dag}</p>
              <p class="stem-cijfer mt-1 text-2xl text-inkt-950 sm:mt-0 sm:text-3xl">{moment.uren}</p>
              <div class="mt-1 sm:mt-0">
                <p class="font-bold">{moment.omschrijving}</p>
                <p class="text-sm text-inkt-500">{moment.doelgroep}</p>
                {moment.opmerking && <p class="text-sm text-inkt-500">{moment.opmerking}</p>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Komende events: skeletrijen reserveren de ruimte zodat de pagina niet
         verspringt; zonder data klapt de sectie dicht. -->
    <section id="events-sectie" class="border-y border-inkt-950/10">
      <div class="mx-auto max-w-6xl px-4 py-20">
        <h2 class="stem-display pl-10 text-4xl text-inkt-950">Binnenkort in de club</h2>
        <ol id="events-lijst" class="relative mt-10">
          {Array.from({ length: 4 }).map(() => (
            <li class="skelet relative border-b border-inkt-950/10 py-5 pl-10 first:border-t" aria-hidden="true">
              <span class="absolute left-[6px] top-7 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-inkt-950/10"></span>
              <span class="block h-6 w-44 max-w-full animate-pulse rounded bg-inkt-950/10"></span>
              <span class="mt-2 block h-5 w-64 max-w-full animate-pulse rounded bg-inkt-950/10"></span>
              <span class="mt-2 block h-4 w-36 max-w-full animate-pulse rounded bg-inkt-950/10"></span>
            </li>
          ))}
        </ol>
        <p class="mt-8 pl-10">
          <a href={url('/kalender/')} class="stem-baan inline-flex items-center gap-2 text-xs text-club-700 hover:text-club-800 hover:underline">
            Bekijk de volledige kalender
            <Pijl />
          </a>
        </p>
      </div>
    </section>

    <!-- Drie veren aan de draad: jeugd, recreatief, competitie -->
    <section class="mx-auto max-w-6xl px-4 py-24">
      <h2 class="sr-only">Wat de club te bieden heeft</h2>
      <div class="grid grid-cols-12 gap-y-5">
        {kaarten.map((kaart) => (
          <a
            href={url(kaart.href)}
            class={`vlucht group p-8 transition-transform duration-300 [transition-timing-function:var(--ease-lancering)] hover:-translate-y-2 ${kaart.kaartClass}`}
            style={`clip-path: ${kaart.clip}`}
          >
            <h3 class={`stem-display ${kaart.titelClass}`}>{kaart.titel}</h3>
            <p class={`mt-3 text-sm leading-relaxed ${kaart.tekstClass}`}>{kaart.tekst}</p>
            <span class={`stem-baan mt-6 inline-flex items-center gap-2 text-xs ${kaart.linkClass}`}>
              Ontdek meer
              <Pijl class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Sinds 1987: één stille regel op de draad -->
    <section class="mx-auto max-w-6xl px-4 pb-24">
      <div class="relative pl-10">
        <span id="punt-1987" class="absolute left-[6px] top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>
        <p class="stem-cijfer text-2xl text-inkt-950">1987</p>
        <p class="mt-1 max-w-xl text-inkt-700">
          Ontstaan uit een gemeentelijke initiatiecursus, uitgegroeid tot een club met jeugdwerking,
          recreatieve avonden én competitieploegen.
        </p>
        <a href={url('/club/over-de-club/')} class="stem-baan mt-3 inline-block text-xs text-club-700 hover:text-club-800 hover:underline">
          Lees hoe het begon
        </a>
      </div>
    </section>

    <!-- Slot: de leren dop -->
    <section id="slot-sectie" class="relative overflow-hidden bg-inkt-950 text-veer-50">
      <!-- Staart van de vluchtdraad: landt op de foto, achter de tekst -->
      <svg id="draad-staart-svg" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
        <path id="draad-staart" fill="none" stroke="var(--color-club-500)" stroke-width="4" stroke-linecap="round" />
      </svg>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 md:grid-cols-2">
        <div>
          <h2 class="stem-display text-4xl text-white sm:text-5xl">Zin om mee te spelen?</h2>
          <p class="mt-4 max-w-md text-veer-200">
            Schrijf je in, of kom eerst gewoon eens kijken en meespelen tijdens een speelmoment.
            Jong of oud, beginner of gevorderde — je bent welkom.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              id="slot-cta"
              href={url('/club/word-lid/')}
              class="stem-baan rounded-full bg-club-500 px-7 py-3.5 text-sm text-white transition-colors hover:bg-club-400"
            >
              Word lid!
            </a>
            <a
              href={url('/kalender/')}
              class="stem-baan rounded-full border-2 border-veer-200/40 px-7 py-3 text-sm text-veer-50 transition-colors hover:border-club-400 hover:text-club-300"
            >
              Bekijk de kalender
            </a>
          </div>
        </div>
        <figure id="slot-foto" style="clip-path: polygon(0 8%, 100% 0, 100% 92%, 0 100%)">
          <Image
            src={hero}
            alt="Badmintonwedstrijd van de club in de sporthal"
            widths={[640, 1024, 1600]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="h-full max-h-96 w-full object-cover"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <!-- De vluchtdraad: één doorlopende rode lijn van kurk tot slot, getekend met de
         scroll. Hij loopt achter de inhoud en duikt onder de rode band door. -->
    <svg id="draad" class="pointer-events-none absolute inset-0 -z-[1] h-full w-full" aria-hidden="true">
      <path id="draad-kern" fill="none" stroke="var(--color-club-500)" stroke-width="4" stroke-linecap="round" />
    </svg>
  </div>
</Layout>

<!-- Zonder JS komt er nooit data: verberg dan de gereserveerde blokken,
     zodat er geen eeuwig pulserende skeletten staan. -->
<style is:global>
  html:not(.js) #volgend-moment,
  html:not(.js) #intra-sectie,
  html:not(.js) #events-sectie {
    display: none;
  }
</style>

<script>
  import trainingen from '../data/trainingen.json';
  import { groepUitTitel } from '../data/kalender';
  import { initDraad } from '../lib/draad';
  import {
    NU,
    dagKey,
    uurTekst,
    datumTekst,
    isThuismatch,
    haalKalender,
    type KalenderItem,
  } from '../lib/kalender-client';
  import { fetchJson, naam, spelerUrl, formatDatum } from '../lib/intra';
  import type { RankingRij } from '../lib/intra';

  // De vluchtdraad en de landing-animatie leven in lib/draad.ts; `herbouw`
  // herberekent de draad zodra een sectie van hoogte verandert of dichtklapt.
  const { herbouw } = initDraad();

  function esc(tekst: string): string {
    const span = document.createElement('span');
    span.textContent = tekst;
    return span.innerHTML;
  }

  // — Kalenderdata: de hero-chip ("Eerstvolgend speelmoment") en "Binnenkort
  //   in de club" putten uit één gedeelde pass over alle bronnen
  //   (lib/kalender-client.ts). De ruimte is vooraf gereserveerd (skeletten)
  //   zodat de pagina niet verspringt; enkel zonder enige data klapt een blok
  //   alsnog dicht — de vaste uren staan in "Wanneer we spelen". —

  // — Hero-chip: alle speelmomenten van de eerstvolgende speeldag. Tijden
  //   komen uit de kalender, teksten uit de vaste labels per bron
  //   (kalendertitels zijn interne jargon). Thuismatchen tellen ook mee. —
  function toonSpeelmomenten(items: KalenderItem[]) {
    const chip = document.getElementById('volgend-moment');
    const chipDag = document.getElementById('volgend-moment-dag');
    const chipLijst = document.getElementById('volgend-moment-lijst');
    const momenten = items.filter((item) => item.bron.speelmoment || isThuismatch(item));
    const eerste = momenten[0];
    if (!chip || !chipDag || !chipLijst) return;
    if (!eerste) {
      // Geen speelmoment binnen het venster: gereserveerde ruimte weer vrijgeven.
      chip.classList.add('hidden');
      return;
    }

    const key = dagKey(eerste.start);
    chipDag.textContent =
      key === dagKey(NU)
        ? 'vandaag'
        : key === dagKey(new Date(NU.getTime() + 24 * 60 * 60 * 1000))
          ? 'morgen'
          : eerste.start.toLocaleDateString('nl-BE', { weekday: 'long' });

    for (const item of momenten.filter((moment) => dagKey(moment.start) === key)) {
      const { omschrijving, doelgroep } = item.bron.speelmoment ?? {
        omschrijving: `Thuismatch ${item.bron.label}`,
        doelgroep: 'supporters welkom',
      };
      const bezig = item.start <= NU && item.einde !== null && NU < item.einde;
      // De groep (jeugd zaterdag: groep 1 en 2) moet overal zichtbaar zijn.
      const groep = groepUitTitel(item.event.summary);
      const li = document.createElement('li');
      const uur = document.createElement('strong');
      uur.className = 'stem-cijfer text-inkt-950';
      uur.textContent = item.einde ? `${uurTekst(item.start)} – ${uurTekst(item.einde)}` : uurTekst(item.start);
      li.append(uur, ` · ${omschrijving}${groep ? ` ${groep}` : ''}${bezig ? ' — nu bezig' : ''} `);
      const dg = document.createElement('span');
      dg.className = 'text-inkt-500';
      dg.textContent = `(${doelgroep})`;
      li.append(dg);
      chipLijst.append(li);
    }
    chip.classList.remove('invisible');
  }

  // — "Binnenkort in de club": events (zonder venster), de eerstvolgende
  //   intraclub-speeldag en thuismatchen gegroepeerd per dag — één rij per
  //   bezoekmoment, zodat een competitieweekend de events niet verdringt. —
  function toonBinnenkort(items: KalenderItem[]) {
    interface Rij {
      start: Date;
      wanneer: string;
      titel: string;
      plaats: string | null;
      isEvent?: boolean;
    }
    const rijen: Rij[] = [];

    for (const item of items.filter((i) => i.bron.label === 'Events')) {
      const plaats = item.event.location;
      rijen.push({
        start: item.start,
        wanneer: `${datumTekst(item.start)}${item.event.start.dateTime ? ` · ${uurTekst(item.start)}` : ''}`,
        titel: item.event.summary ?? 'Event',
        plaats: plaats && plaats.toLowerCase() !== 'onbekend' ? plaats : null,
        isEvent: true,
      });
    }

    const intraclub = items.find((item) => item.bron.label === 'Intraclub');
    if (intraclub) {
      rijen.push({
        start: intraclub.start,
        wanneer: `${datumTekst(intraclub.start)} · ${uurTekst(intraclub.start)}`,
        titel: 'Intraclub + vrij spel',
        plaats: trainingen.locatie.naam,
      });
    }

    const matchdagen = new Map<string, KalenderItem[]>();
    for (const item of items.filter(isThuismatch)) {
      const key = dagKey(item.start);
      matchdagen.set(key, [...(matchdagen.get(key) ?? []), item]);
    }
    for (const matchen of matchdagen.values()) {
      const ploegen = matchen.map((match) => match.bron.label);
      const korte = [ploegen[0], ...ploegen.slice(1).map((ploeg) => ploeg.replace('Landegem ', ''))];
      const opsomming = korte.length > 1 ? `${korte.slice(0, -1).join(', ')} en ${korte[korte.length - 1]}` : korte[0];
      rijen.push({
        start: matchen[0].start,
        wanneer: `${datumTekst(matchen[0].start)} · vanaf ${uurTekst(matchen[0].start)}`,
        titel: `${matchen.length > 1 ? 'Thuismatchen' : 'Thuismatch'} — ${opsomming}`,
        plaats: `${trainingen.locatie.naam}, ${trainingen.locatie.gemeente}`,
      });
    }

    const sectie = document.getElementById('events-sectie');
    const lijst = document.getElementById('events-lijst');
    if (!sectie || !lijst) return;
    if (!rijen.length) {
      sectie.classList.add('hidden');
      return;
    }
    lijst.textContent = ''; // skeletrijen ruimen
    // Max. 6 rijen, maar events overleven de cap altijd: in volle
    // competitieperiodes zouden matchdagen ze anders alsnog verdringen.
    rijen.sort((a, b) => a.start.getTime() - b.start.getTime());
    const events = rijen.filter((rij) => rij.isEvent).slice(0, 6);
    const rest = rijen.filter((rij) => !rij.isEvent).slice(0, 6 - events.length);
    const selectie = [...events, ...rest].sort((a, b) => a.start.getTime() - b.start.getTime());
    for (const rij of selectie) {
      const li = document.createElement('li');
      li.className = 'relative border-b border-inkt-950/10 py-5 pl-10 first:border-t';
      li.innerHTML = `
        <span class="absolute left-[6px] top-7 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>
        <p class="stem-cijfer text-lg text-club-700">${esc(rij.wanneer)}</p>
        <p class="mt-0.5 font-bold">${esc(rij.titel)}</p>
        ${rij.plaats ? `<p class="mt-0.5 text-sm text-inkt-500">${esc(rij.plaats)}</p>` : ''}`;
      lijst.append(li);
    }
  }

  async function laadKalender() {
    const alle = await haalKalender();
    if (!alle.length) {
      // Geen enkele bron bereikbaar: gereserveerde blokken opruimen.
      document.getElementById('volgend-moment')?.classList.add('hidden');
      document.getElementById('events-sectie')?.classList.add('hidden');
    } else {
      toonSpeelmomenten(alle);
      toonBinnenkort(alle);
    }
    herbouw();
  }

  laadKalender();

  // — Intra top-10 uit de intra-API; de skeletrijen reserveren de ruimte,
  //   faalt de API of is de stand leeg, dan klapt de sectie dicht. —
  async function laadIntra() {
    const sectie = document.getElementById('intra-sectie')!;
    try {
      const [rankings, laatste] = await Promise.all([
        fetchJson<{ seasonId: number; general: RankingRij[] }>('/rankings/general?$top=10'),
        fetchJson<{ id: string; number: string; date: string } | false>('/rounds/latestCalculated').catch(() => false as const),
      ]);
      const rijen = rankings.general ?? [];
      if (!rijen.length) {
        sectie.classList.add('hidden');
        herbouw();
        return;
      }

      const lijst = document.getElementById('intra-top10')!;
      lijst.textContent = ''; // skeletrijen ruimen
      for (const rij of rijen) {
        const li = document.createElement('li');
        li.className =
          'grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-3 border-b border-inkt-950/10 py-2.5 first:border-t';
        li.innerHTML = `
          <span class="stem-cijfer text-lg text-club-700">${rij.rank}</span>
          <a href="${spelerUrl(rij.id)}" class="truncate font-bold text-inkt-950 hover:text-club-600 hover:underline">${esc(naam(rij))}</a>
          <span class="stem-cijfer text-lg text-inkt-950">${rij.average.toFixed(2)}</span>`;
        lijst.append(li);
      }
      if (laatste && laatste.id) {
        document.getElementById('intra-stand-na')!.textContent =
          `Stand na speeldag ${laatste.number} · ${formatDatum(laatste.date)}`;
      }
      herbouw();
    } catch {
      sectie.classList.add('hidden');
      herbouw();
    }
  }

  laadIntra();
</script>

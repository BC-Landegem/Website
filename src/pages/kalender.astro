---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import { bronnen, categorieen } from '../data/kalender';

// Voor "In je eigen agenda": bronnen gegroepeerd per categorie, plus de
// statische links voor de eerste bron zodat de knoppen ook zonder JS werken.
const agendaGroepen = Object.entries(categorieen).map(([key, categorie]) => ({
  label: categorie.label,
  bronnen: bronnen.filter((bron) => bron.categorie === key),
}));
const eersteBron = agendaGroepen[0].bronnen[0];
const icsUrl = (id: string) => `https://calendar.google.com/calendar/ical/${encodeURIComponent(id)}/public/basic.ics`;
const googleUrl = (id: string) => `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(id)}`;
---

<Layout
  title="Kalender"
  description="De kalender van BC Landegem: trainingen, vrij spel, competitiematchen, intraclub en events."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <!-- Kop op de rail: statische draad (geen scroll-script op deze pagina) -->
    <div class="relative pl-10">
      <span class="absolute left-[6px] top-3 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>
      <span class="absolute bottom-1 left-[6px] top-7 w-1 -translate-x-1/2 rounded-full bg-club-500" aria-hidden="true"></span>
      <span class="absolute bottom-0 left-[6px] h-2 w-2 -translate-x-1/2 rounded-full bg-club-500" aria-hidden="true"></span>
      <h1 class="stem-display text-4xl text-inkt-950 sm:text-5xl">Kalender</h1>
      <p class="mt-3 max-w-2xl text-inkt-700">
        Alle trainingen, speelmomenten, competitiematchen en events op één plek.
        Klik op een activiteit voor het uur, de plaats en de details.
      </p>
      <p class="mt-2 max-w-2xl text-sm text-inkt-500">
        Het klassement en de volledige wedstrijdkalender van je competitieploeg vind je op de
        <a href={url('/competitie/')} class="font-semibold text-club-700 hover:text-club-800 hover:underline">competitiepagina</a>.
      </p>
      <!-- Kleur zegt wát je er kan doen; de titel draagt de details -->
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        {Object.values(categorieen).map((categorie) => (
          <li class="flex items-center gap-2 text-sm text-inkt-700">
            <span class="h-3 w-3 rounded-full" style={`background: ${categorie.kleur}`}></span>
            {categorie.label}
          </li>
        ))}
      </ul>
    </div>

    <div id="kalender-wrap" class="relative mt-10">
      <p id="kalender-laden" class="mb-4 hidden items-center gap-3 text-sm font-medium text-inkt-500" aria-live="polite">
        <span class="h-3.5 w-3.5 rounded-full bg-club-500 ring-4 ring-veer-50 motion-safe:animate-pulse" aria-hidden="true"></span>
        Kalender laden…
      </p>
      <div
        id="kalender-fout"
        role="alert"
        class="mb-4 hidden border-2 border-club-500 bg-club-50 p-4 font-medium text-club-800"
      >
        De kalender kon niet (volledig) geladen worden. Probeer het later opnieuw.
      </div>
      <div id="kalender"></div>

      <!-- Detailpaneel: dezelfde grammatica als een railrij (cijfer-wanneer, vette titel, stille plaats) -->
      <div
        id="kalender-detail"
        role="dialog"
        aria-labelledby="kalender-detail-titel"
        class="absolute z-20 hidden w-80 max-w-[calc(100vw-2rem)] border-2 border-inkt-950 bg-white p-5"
      >
        <button
          id="kalender-detail-sluit"
          type="button"
          class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center text-inkt-500 transition-colors hover:text-club-600"
          aria-label="Sluiten"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </button>
        <p id="kalender-detail-wanneer" class="stem-cijfer pr-8 text-lg text-club-700"></p>
        <h2 id="kalender-detail-titel" class="mt-0.5 pr-8 font-bold text-inkt-950"></h2>
        <p id="kalender-detail-plaats" class="mt-0.5 text-sm text-inkt-500"></p>
        <p id="kalender-detail-beschrijving" class="mt-3 max-h-40 overflow-y-auto text-sm leading-relaxed text-inkt-700"></p>
      </div>
    </div>

    <!-- In je eigen agenda: stille regel op de rail, abonneren per bron -->
    <section class="relative mt-16 pl-10" aria-labelledby="agenda-kop">
      <span class="absolute left-[6px] top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50" aria-hidden="true"></span>
      <h2 id="agenda-kop" class="stem-display text-2xl text-inkt-950 sm:text-3xl">In je eigen agenda</h2>
      <p class="mt-3 max-w-2xl text-inkt-700">
        Abonneer je op een clubkalender en nieuwe activiteiten verschijnen vanzelf in je eigen
        agenda-app — bijvoorbeeld het vrij spel, of alle matchen van je eigen ploeg.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <label class="sr-only" for="agenda-bron">Kies een kalender</label>
        <select
          id="agenda-bron"
          class="max-w-full rounded-full border-2 border-inkt-950 bg-white px-4 py-2.5 text-sm font-semibold text-inkt-950"
        >
          {agendaGroepen.map((groep) => (
            <optgroup label={groep.label}>
              {groep.bronnen.map((bron) => (
                <option value={bron.googleCalendarId}>{bron.label}</option>
              ))}
            </optgroup>
          ))}
        </select>
        <a
          id="agenda-google"
          href={googleUrl(eersteBron.googleCalendarId)}
          target="_blank"
          rel="noopener"
          class="stem-baan group inline-flex items-center gap-2 rounded-full border-2 border-inkt-950 px-5 py-2.5 text-xs text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Google Agenda
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
            <path d="M4 12h16m0 0l-6-6m6 6l-6 6" />
          </svg>
        </a>
        <a
          id="agenda-ical"
          href={icsUrl(eersteBron.googleCalendarId).replace('https://', 'webcal://')}
          class="stem-baan group inline-flex items-center gap-2 rounded-full border-2 border-inkt-950 px-5 py-2.5 text-xs text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Apple / Outlook
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
            <path d="M4 12h16m0 0l-6-6m6 6l-6 6" />
          </svg>
        </a>
        <button
          id="agenda-kopieer"
          type="button"
          class="stem-baan inline-flex items-center gap-2 rounded-full border-2 border-inkt-950 px-5 py-2.5 text-xs text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Kopieer link
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" />
            <path d="M5 15H4V4h11v1" />
          </svg>
        </button>
      </div>
      <p id="agenda-status" role="status" class="mt-3 min-h-5 break-words text-sm font-medium text-club-700"></p>
    </section>
  </div>
</Layout>

<script>
  import { Calendar } from '@fullcalendar/core';
  import type { EventApi } from '@fullcalendar/core';
  import nlLocale from '@fullcalendar/core/locales/nl';
  import dayGridPlugin from '@fullcalendar/daygrid';
  import listPlugin from '@fullcalendar/list';
  import googleCalendarPlugin from '@fullcalendar/google-calendar';
  import { googleCalendarApiKey, bronnen, categorieen, groepUitTitel } from '../data/kalender';

  const el = document.getElementById('kalender')!;
  const wrap = document.getElementById('kalender-wrap')!;
  const laden = document.getElementById('kalender-laden')!;
  const foutmelding = document.getElementById('kalender-fout')!;
  const paneel = document.getElementById('kalender-detail')!;
  const paneelWanneer = document.getElementById('kalender-detail-wanneer')!;
  const paneelTitel = document.getElementById('kalender-detail-titel')!;
  const paneelPlaats = document.getElementById('kalender-detail-plaats')!;
  const paneelBeschrijving = document.getElementById('kalender-detail-beschrijving')!;
  const sluitKnop = document.getElementById('kalender-detail-sluit')!;
  const isMobiel = window.matchMedia('(max-width: 640px)').matches;

  // — Detailpaneel: klik of Enter op een activiteit toont uur, plaats en
  //   beschrijving in de wereld zelf; de Google Calendar-pagina blijft dicht. —
  let trigger: HTMLElement | null = null;

  const uurTekst = (d: Date) => `${d.getHours()}u${String(d.getMinutes()).padStart(2, '0')}`;

  function wanneerTekst(event: EventApi): string {
    const start = event.start;
    if (!start) return '';
    const datum = start.toLocaleDateString('nl-BE', { weekday: 'short', day: 'numeric', month: 'long' });
    if (event.allDay) return datum;
    return event.end ? `${datum} · ${uurTekst(start)} – ${uurTekst(event.end)}` : `${datum} · ${uurTekst(start)}`;
  }

  function openDetail(event: EventApi, eventEl: HTMLElement) {
    const plaats = (event.extendedProps.location as string | undefined) ?? '';
    const beschrijving = ((event.extendedProps.description as string | undefined) ?? '')
      .replace(/<[^>]*>/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

    paneelWanneer.textContent = wanneerTekst(event);
    paneelTitel.textContent = event.title;
    paneelPlaats.textContent = plaats.toLowerCase() === 'onbekend' ? '' : plaats;
    paneelPlaats.classList.toggle('hidden', !paneelPlaats.textContent);
    paneelBeschrijving.textContent = beschrijving;
    paneelBeschrijving.classList.toggle('hidden', !beschrijving);

    paneel.classList.remove('hidden');
    const rect = eventEl.getBoundingClientRect();
    const wrect = wrap.getBoundingClientRect();
    const links = Math.max(0, Math.min(rect.left - wrect.left, wrap.clientWidth - paneel.offsetWidth));
    paneel.style.left = `${links}px`;
    paneel.style.top = `${rect.bottom - wrect.top + 8}px`;

    trigger = eventEl;
    sluitKnop.focus();
  }

  function sluitDetail() {
    if (paneel.classList.contains('hidden')) return;
    paneel.classList.add('hidden');
    trigger?.focus();
    trigger = null;
  }

  sluitKnop.addEventListener('click', sluitDetail);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') sluitDetail();
  });
  document.addEventListener('click', (e) => {
    const doel = e.target as HTMLElement;
    if (!paneel.contains(doel) && !doel.closest('.fc-event')) sluitDetail();
  });

  // — In je eigen agenda: de knoppen volgen de gekozen bron; kopiëren geeft
  //   de publieke iCal-link voor elke agenda-app. —
  const agendaSelect = document.getElementById('agenda-bron') as HTMLSelectElement;
  const agendaGoogle = document.getElementById('agenda-google') as HTMLAnchorElement;
  const agendaIcal = document.getElementById('agenda-ical') as HTMLAnchorElement;
  const agendaKopieer = document.getElementById('agenda-kopieer')!;
  const agendaStatus = document.getElementById('agenda-status')!;

  const agendaIcsUrl = (id: string) => `https://calendar.google.com/calendar/ical/${encodeURIComponent(id)}/public/basic.ics`;

  function vernieuwAgendaLinks() {
    const id = agendaSelect.value;
    agendaGoogle.href = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(id)}`;
    agendaIcal.href = agendaIcsUrl(id).replace('https://', 'webcal://');
  }
  agendaSelect.addEventListener('change', vernieuwAgendaLinks);
  vernieuwAgendaLinks();

  let kopieerTimer: number | undefined;
  agendaKopieer.addEventListener('click', async () => {
    const url = agendaIcsUrl(agendaSelect.value);
    try {
      await navigator.clipboard.writeText(url);
      agendaStatus.textContent = 'Link gekopieerd — plak hem in je agenda-app bij "Abonneren op kalender" of "Toevoegen via URL".';
    } catch {
      // Kopiëren kan geblokkeerd zijn; toon dan de link zelf om over te nemen.
      agendaStatus.textContent = url;
    }
    clearTimeout(kopieerTimer);
    kopieerTimer = window.setTimeout(() => {
      agendaStatus.textContent = '';
    }, 8000);
  });

  // — Mobiel: bij het openen meteen naar vandaag scrollen. De maandlijst
  //   begint anders bij de eerste dag van de maand, ver boven het
  //   eerstvolgende speelmoment. Eén keer, meteen na de eerste lading. —
  let naarVandaagGescrold = false;
  function scrolNaarVandaag() {
    if (!isMobiel || naarVandaagGescrold) return;
    const nu = new Date();
    const vandaagIso = `${nu.getFullYear()}-${String(nu.getMonth() + 1).padStart(2, '0')}-${String(nu.getDate()).padStart(2, '0')}`;
    const dagen = [...el.querySelectorAll<HTMLElement>('.fc-list-day')];
    const doel = dagen.find((dag) => (dag.dataset.date ?? '') >= vandaagIso);
    if (!doel) return;
    naarVandaagGescrold = true;
    const hoogteChroom = (document.querySelector('header')?.getBoundingClientRect().height ?? 0) + 8;
    window.scrollTo({ top: doel.getBoundingClientRect().top + window.scrollY - hoogteChroom });
  }

  const calendar = new Calendar(el, {
    plugins: [dayGridPlugin, listPlugin, googleCalendarPlugin],
    locale: nlLocale,
    initialView: isMobiel ? 'listMonth' : 'dayGridMonth',
    headerToolbar: {
      left: 'prev,next today',
      center: 'title',
      right: 'dayGridMonth,listMonth',
    },
    height: 'auto',
    dayMaxEvents: true,
    googleCalendarApiKey,
    eventSources: bronnen.map((bron) => ({
      googleCalendarId: bron.googleCalendarId,
      backgroundColor: categorieen[bron.categorie].kleur,
      borderColor: categorieen[bron.categorie].kleur,
      textColor: categorieen[bron.categorie].tekst,
      eventDataTransform(data: Record<string, unknown>) {
        // Nooit naar de Google Calendar-pagina navigeren (ook niet via
        // middelklik of "open in nieuw tabblad"); details tonen we zelf.
        delete data.url;
        // Kalendertitels zijn interne jargon; bronnen met een speelmoment
        // krijgen dezelfde vaste tekst als de hero-chip op de homepage.
        // De groep (jeugd zaterdag: groep 1 en 2) blijft wel zichtbaar.
        if (bron.speelmoment) {
          const groep = groepUitTitel(data.title as string | undefined);
          data.title = `${bron.speelmoment.omschrijving}${groep ? ` ${groep}` : ''} (${bron.speelmoment.doelgroep})`;
        }
        return data;
      },
    })),
    loading(bezig) {
      laden.classList.toggle('hidden', !bezig);
      laden.classList.toggle('flex', bezig);
      if (!bezig) requestAnimationFrame(scrolNaarVandaag);
    },
    eventSourceFailure() {
      foutmelding.classList.remove('hidden');
    },
    eventDidMount(arg) {
      // Zonder url is het element geen link meer; maak het zelf bedienbaar.
      arg.el.setAttribute('role', 'button');
      if (!arg.el.hasAttribute('tabindex')) arg.el.tabIndex = 0;
      arg.el.title = arg.event.title;
      arg.el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openDetail(arg.event, arg.el);
        }
      });
    },
    eventClick(info) {
      info.jsEvent.preventDefault();
      openDetail(info.event, info.el);
    },
  });

  calendar.render();
</script>

<style is:global>
  /* FullCalendar in De Shuttle: hairlines, baan-knoppen, display-titel, tabulaire cijfers */
  #kalender {
    --fc-border-color: rgba(27, 20, 16, 0.1);
    --fc-page-bg-color: var(--color-veer-50);
    --fc-neutral-bg-color: var(--color-veer-100);
    --fc-today-bg-color: rgba(230, 220, 200, 0.45);
    --fc-list-event-hover-bg-color: var(--color-veer-100);
  }
  #kalender .fc-toolbar-title {
    font-variation-settings: "wdth" 125;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: 1.5rem;
  }
  #kalender .fc-button {
    font-variation-settings: "wdth" 110;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    padding: 0.5rem 1.1rem;
  }
  #kalender .fc-button,
  #kalender .fc-button-group > .fc-button {
    border-radius: 9999px;
  }
  #kalender .fc-button-group {
    gap: 0.375rem;
  }
  /* Baan-tekst is klein: club-600 als basis haalt 4.5:1 met wit (club-500 niet) */
  #kalender .fc-button-primary {
    background: var(--color-club-600);
    border-color: var(--color-club-600);
  }
  #kalender .fc-button-primary:hover {
    background: var(--color-club-700);
    border-color: var(--color-club-700);
  }
  #kalender .fc-button-primary:not(:disabled).fc-button-active,
  #kalender .fc-button-primary:not(:disabled):active {
    background: var(--color-club-800);
    border-color: var(--color-club-800);
  }
  /* Uitgeschakeld = omtrek in inkt, geen pil die op een highlight lijkt */
  #kalender .fc-button-primary:disabled {
    background: transparent;
    border-color: rgba(107, 92, 80, 0.4);
    color: var(--color-inkt-500);
    opacity: 1;
  }
  /* Focus in het clubrood van de wereld, niet FullCalendars grijze gloed */
  #kalender .fc-button:focus,
  #kalender .fc-event:focus {
    box-shadow: none;
  }
  #kalender .fc-event:focus::after {
    display: none;
  }
  #kalender .fc-button:focus-visible,
  #kalender .fc-event:focus-visible {
    outline: 2px solid var(--color-club-500);
    outline-offset: 3px;
    box-shadow: none;
  }
  #kalender .fc-col-header-cell-cushion {
    font-variation-settings: "wdth" 110;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--color-club-700);
    padding: 0.5rem 0.25rem;
  }
  #kalender .fc-daygrid-day-number,
  #kalender .fc-list-day-text,
  #kalender .fc-list-day-side-text {
    font-variation-settings: "wdth" 112;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: var(--color-inkt-950);
  }
  #kalender .fc-daygrid-day-number {
    padding: 0.375rem 0.5rem;
  }
  /* Activiteiten zijn bedienbaar: afknippen met ellipsis, cursor toont het */
  #kalender .fc-event {
    cursor: pointer;
  }
  #kalender .fc-event-title {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* "+N meer" en de dagpopover in de wereldtokens: baan-link, scherp vlak */
  #kalender .fc-daygrid-more-link {
    font-variation-settings: "wdth" 110;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--color-club-700);
  }
  #kalender .fc-daygrid-more-link:hover {
    background: var(--color-veer-100);
    color: var(--color-club-800);
  }
  #kalender .fc-popover {
    background: #ffffff;
    border: 2px solid var(--color-inkt-950);
    border-radius: 0;
    box-shadow: none;
  }
  #kalender .fc-popover-header {
    font-variation-settings: "wdth" 110;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    background: var(--color-veer-100);
    padding: 0.5rem 0.75rem;
  }
  @media (max-width: 640px) {
    #kalender .fc-toolbar {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

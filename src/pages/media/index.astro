---
import Layout from '../../layouts/Layout.astro';
import RailHeading from '../../components/RailHeading.astro';
import { url } from '../../lib/url';
import { visibleAlbums, photoData, monthName, coverUrl } from '../../lib/media';

// Albums gegroepeerd per jaar, nieuwste eerst (zichtbareAlbums is al gesorteerd).
const years = new Map<string, typeof visibleAlbums>();
for (const album of visibleAlbums) {
  const year = album.datum.slice(0, 4);
  if (!years.has(year)) years.set(year, []);
  years.get(year)!.push(album);
}

// Veerpaneel-ritme: geen gelijke kaarten — spans en rotaties wisselen af.
const spanClasses = ['sm:col-span-7', 'sm:col-span-5', 'sm:col-span-5', 'sm:col-span-7'];
const rotationClasses = ['sm:-rotate-1', 'sm:rotate-1', 'sm:rotate-[-0.75deg]', 'sm:rotate-[0.75deg]'];
---

<Layout
  title="Foto's"
  description="Fotoalbums van Badmintonclub Landegem — jeugdcups, intraclub, clubweekends en meer clubleven in beeld."
  noReferrer
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Foto's"
      intro="Het clubleven in beeld: jeugdcups, intraclubavonden, weekends en feesten — vers uit de albums van de club."
      continuous={visibleAlbums.length > 0}
    >
      <p class="mt-3 max-w-2xl text-sm text-inkt-500">
        Sta je op een foto en zie je die liever niet online? Laat het ons weten via
        <a href="mailto:info@bclandegem.be" class="font-semibold underline hover:text-club-100">info@bclandegem.be</a>.
      </p>
    </RailHeading>

    {visibleAlbums.length === 0 && (
      <p class="mt-10 pl-10 text-inkt-700">De fotoalbums worden binnenkort toegevoegd.</p>
    )}

    <section class="mt-12 space-y-16">
      {[...years.entries()].map(([year, yearAlbums], j) => (
        <div class="relative pl-10">
          {/* Draadsegment: overbrugt ook de ruimte boven dit jaar; de rail eindigt op de bol van het laatste jaar */}
          <span
            class:list={[
              'absolute -top-16 left-[6px] w-1 -translate-x-1/2 bg-club-500',
              j === years.size - 1 ? 'h-20' : 'bottom-0',
            ]}
            aria-hidden="true"
          ></span>
          <span
            class="absolute left-[6px] top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50"
            aria-hidden="true"
          ></span>
          <h2 class="stem-cijfer text-2xl text-inkt-950">{year}</h2>

          <div class="mt-6 grid grid-cols-12 gap-x-6 gap-y-10">
            {yearAlbums.map((album, i) => (
              <a
                href={url(`/media/${album.slug}/`)}
                class:list={[
                  'group col-span-12 transition-transform duration-300 hover:-translate-y-2',
                  spanClasses[i % 4],
                  rotationClasses[i % 4],
                ]}
              >
                <figure
                  class="bg-inkt-950"
                  style="clip-path: polygon(0 16px, 100% 0, 100% calc(100% - 16px), 0 100%)"
                >
                  <img
                    src={coverUrl(photoData[album.slug].cover, 1200, 800)}
                    width="1200"
                    height="800"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="aspect-[3/2] w-full object-cover"
                  />
                  <figcaption class="px-5 pb-7 pt-4 sm:px-6">
                    <span class="stem-display block text-2xl text-veer-50 transition-colors group-hover:text-club-300">
                      {album.titel}
                    </span>
                    <span class="stem-baan mt-2 block text-xs text-veer-200">
                      {monthName(album.datum)} · {photoData[album.slug].fotos.length} foto's
                    </span>
                  </figcaption>
                </figure>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  </div>
</Layout>

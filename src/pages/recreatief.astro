---
import Layout from '../layouts/Layout.astro';
import RailHeading from '../components/RailHeading.astro';
import { url } from '../lib/url';
import trainingen from '../data/trainingen.json';

const { locatie, lidgeld } = trainingen;

// De speelmomenten waar een volwassen recreant terechtkan. Komt uit dezelfde
// bron als de homepage en /club/word-lid/: jeugduren en de zaterdagtraining
// vallen er vanzelf uit.
const freePlay = trainingen.momenten.filter((session) =>
  session.doelgroep.toLowerCase().includes('recreanten'),
);

// De twee tarieven zonder competitie: wie recreatief speelt, kiest hiertussen.
const recreationalRates = lidgeld.tarieven.filter((rate) => rate.detail.startsWith('Volwassenen'));
---

<Layout
  title="Recreatief badminton"
  description="Badminton voor volwassenen in Nevele (Deinze): vrij spel op maandag, woensdag en zondag, intraclub, een lessenreeks van vijf avonden en drie keer gratis meespelen."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Recreatief badminton"
      intro="De meeste van onze leden spelen gewoon voor hun plezier. Geen selectie, geen vaste ploegjes, geen niveau dat je eerst moet halen. Je komt binnen, je speelt, en je gaat met een rood hoofd naar huis."
    />

    <div class="mt-10 max-w-3xl space-y-4 pl-10 leading-relaxed text-inkt-700">
      <p>
        Recreanten, competitiespelers en jeugd staan bij ons in dezelfde zaal, op dezelfde uren. Dat
        maakt de avonden ook beter: de ene partij speel je tegen iemand van je eigen niveau, de
        volgende tegen iemand die hier al twintig jaar staat. Daar leer je van, zonder dat er een
        training aan te pas komt.
      </p>
    </div>

    {/* Wanneer je terechtkan: dezelfde rail als op de homepage */}
    <section class="mt-14">
      <h2 class="stem-display pl-10 text-3xl text-inkt-950 sm:text-4xl">Je komt en je speelt</h2>
      <p class="mt-3 max-w-2xl pl-10 leading-relaxed text-inkt-700">
        Inschrijven voor een uur hoeft niet, en afspreken met iemand evenmin. Wie er die avond is,
        speelt met wie er is: de dubbels worden ter plaatse samengesteld.
      </p>
      <ol class="relative mt-8">
        {freePlay.map((session, i) => (
          <li class="group relative border-b border-inkt-950/10 py-5 pl-10 first:border-t">
            {/* De statische draad in stukken per rij: van bolmiddelpunt tot bolmiddelpunt, zodat
                 er boven de eerste en onder de laatste bol geen staart blijft hangen — ook niet
                 wanneer de rijen op mobiel uitklappen. 2.1875rem = top-7 plus een halve bol. */}
            {freePlay.length > 1 && (
              <span
                class:list={[
                  'absolute left-[6px] w-1 -translate-x-1/2 bg-club-500',
                  i === 0 ? 'top-[2.1875rem]' : 'top-0',
                  i === freePlay.length - 1 ? 'h-[2.1875rem]' : '-bottom-px',
                ]}
                aria-hidden="true"
              ></span>
            )}
            {/* De bol blijft op de draad (schaalt enkel); alleen de inhoud schuift op hover */}
            <span class="absolute left-[6px] top-7 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-club-500 ring-4 ring-veer-50 transition-transform duration-300 group-hover:scale-125" aria-hidden="true"></span>
            <div class="transition-transform duration-300 [transition-timing-function:var(--ease-lancering)] group-hover:translate-x-2 sm:grid sm:grid-cols-[7rem_13rem_1fr] sm:items-baseline sm:gap-6">
              <p class="stem-baan text-xs text-club-700">{session.dag}</p>
              <p class="stem-cijfer mt-1 text-2xl text-inkt-950 sm:mt-0">{session.uren}</p>
              <div class="mt-1 sm:mt-0">
                <p class="font-bold">{session.omschrijving}</p>
                <p class="text-sm text-inkt-500">{session.doelgroep}</p>
                {session.opmerking && <p class="text-sm text-inkt-500">{session.opmerking}</p>}
              </div>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-3xl pl-10 leading-relaxed text-inkt-700">
        Alles gaat door in <strong class="text-inkt-950">{locatie.naam}</strong>, {locatie.adres},
        {locatie.gemeente} —
        <a href={locatie.kaart} target="_blank" rel="noopener" class="font-semibold text-club-700 underline hover:text-club-800">bekijk op de kaart</a>.
        Valt er uitzonderlijk een avond weg, dan lees je dat
        <a href={url('/kalender/')} class="font-semibold text-club-700 underline hover:text-club-800">in de kalender</a>.
      </p>
    </section>

    {/* Lessenreeks: het antwoord op "ik wil wél iets bijleren" */}
    <section class="mt-16 pl-10">
      <h2 class="stem-display text-3xl text-inkt-950 sm:text-4xl">De lessenreeks</h2>
      <div class="mt-4 max-w-3xl space-y-4 leading-relaxed text-inkt-700">
        <p>
          Van vrij spelen alleen word je niet vanzelf beter. Daarom geeft de club elk jaar
          een <strong class="text-inkt-950">lessenreeks voor nieuwkomers en recreanten</strong>:
          vijf avonden waarop een trainer je slagen en je verplaatsing onder handen neemt, en je
          leert hoe je een dubbel samen speelt in plaats van naast elkaar.
        </p>
        <p>
          Ervaring is niet nodig. Wie nog nooit een racket vasthad, kan gerust mee; de groep wordt
          op niveau verdeeld.
        </p>
        <p>
          <strong class="text-inkt-950">Voor leden is de reeks gratis.</strong> Ben je nog geen lid,
          dan betaal je 25 €, en dat bedrag gaat er weer af van je lidgeld als je nadien aansluit.
        </p>
        <p>
          Wanneer de volgende reeks start, hoor je het snelst door het even te vragen via
          <a href="mailto:info@bclandegem.be" class="font-semibold text-club-700 underline hover:text-club-800">info@bclandegem.be</a>.
          Zodra de data vastliggen, staan ze ook <a href={url('/kalender/')} class="font-semibold text-club-700 underline hover:text-club-800">in de kalender</a>.
        </p>
      </div>
    </section>

    {/* Intraclub: het beste argument voor een recreant die meer wil */}
    <section class="mt-16 pl-10">
      <h2 class="stem-display text-3xl text-inkt-950 sm:text-4xl">Om de twee weken intraclub</h2>
      <div class="mt-4 max-w-3xl space-y-4 leading-relaxed text-inkt-700">
        <p>
          Om de twee weken is het op woensdagavond <strong class="text-inkt-950">intraclub</strong>:
          een interne competitie waarbij je bij drie andere spelers geloot wordt en drie sets speelt,
          telkens met een andere partner. Elke speeldag wordt opnieuw op sterkte ingedeeld, dus je
          speelt tegen je eigen niveau en sta je toch bijna nooit twee keer met dezelfde mensen op de
          baan. Het hele seizoen loopt er één klassement door.
        </p>
        <p>
          Meer dan komen en je aanmelden vóór 20u30 hoef je niet te doen. Je schrijft je niet in voor
          het seizoen en je moet er niet elke keer bij zijn.
        </p>
      </div>
      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={url('/intraclub/zo-werkt-het/')}
          class="stem-baan inline-flex items-center gap-2 rounded-full border-2 border-inkt-950 px-7 py-3 text-sm text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Zo werkt de intraclub
        </a>
        <a
          href={url('/intraclub/')}
          class="stem-baan inline-flex items-center gap-2 rounded-full border-2 border-inkt-950/20 px-7 py-3 text-sm text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Bekijk de stand
        </a>
      </div>
    </section>

    {/* Wat het kost: enkel de twee tarieven die voor een recreant gelden */}
    <section class="mt-16 pl-10">
      <h2 class="stem-display text-3xl text-inkt-950 sm:text-4xl">Wat het kost</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-inkt-700">
        Als recreant kies je tussen twee tarieven. Welk van de twee hangt af van de avonden waarop
        je wil spelen. De clubshuttles zitten er in beide gevallen bij.
      </p>
      <ul class="mt-6 max-w-3xl">
        {recreationalRates.map((rate) => (
          <li class="grid grid-cols-[5rem_1fr] items-baseline gap-4 border-b border-inkt-950/10 py-4 first:border-t">
            <span class="stem-cijfer text-2xl text-club-700">{rate.prijs}</span>
            <span>
              <span class="block font-bold text-inkt-950">{rate.titel}</span>
              <span class="block text-sm text-inkt-500">{rate.detail}</span>
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-4 max-w-3xl text-sm text-inkt-500">
        Stap je later in het jaar in, dan betaal je minder: het lidgeld wordt per kwartaal verrekend.
        Alle tarieven en de rekensom staan op
        <a href={url('/club/word-lid/')} class="font-semibold text-club-700 underline hover:text-club-800">Word lid!</a>.
      </p>
    </section>

    {/* Meer dan de zaal: het groepsgevoel, met de foto's als bewijs */}
    <section class="mt-16 pl-10">
      <h2 class="stem-display text-3xl text-inkt-950 sm:text-4xl">Buiten de zaal</h2>
      <div class="mt-4 max-w-3xl space-y-4 leading-relaxed text-inkt-700">
        <p>
          Er is een <strong class="text-inkt-950">clubweekend voor volwassenen</strong>, we trekken
          samen naar recreatieve tornooien, en na het spelen blijft er geregeld nog volk hangen om
          iets te drinken.
        </p>
        <p>
          Hoe dat eruitziet, zie je
          <a href={url('/media/')} class="font-semibold text-club-700 underline hover:text-club-800">in de fotoalbums</a>.
        </p>
      </div>
    </section>
  </div>

  {/* De rode band draagt de actie, zoals overal op de site */}
  <section class="border-y-8 border-club-800 bg-club-600 text-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-12">
      <div class="flex-[1_1_28rem]">
        <h2 class="stem-display text-3xl sm:text-4xl">Drie keer gratis meespelen</h2>
        <p class="mt-2 max-w-xl text-xl font-bold text-white">
          Ben je nog nergens aangesloten, dan mag je drie keer komen meespelen voor je iets betaalt.
          Racket mee, sportschoenen aan, en binnenspringen in {locatie.naam}.
        </p>
      </div>
      <div class="flex flex-col items-start gap-4">
        <a
          href={url('/club/word-lid/')}
          class="stem-baan rounded-full bg-white px-7 py-3.5 text-sm text-club-600 transition-colors hover:bg-club-50"
        >
          Zo begin je
        </a>
        <a
          href={url('/club/contact/')}
          class="stem-baan inline-flex items-center gap-2 text-xs text-white transition-colors hover:underline"
        >
          Liever eerst iets vragen? Contacteer ons
        </a>
      </div>
    </div>
  </section>
</Layout>

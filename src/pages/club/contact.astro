---
import Layout from '../../layouts/Layout.astro';
import RailHeading from '../../components/RailHeading.astro';
import { url } from '../../lib/url';
import trainingen from '../../data/trainingen.json';

const { locatie } = trainingen;

// Wie je waarvoor aanspreekt. Bewust kort: één algemeen adres dat altijd werkt,
// en twee mensen die een eigen rol dragen en die elders op de site al met naam
// en adres staan (/jeugd/ en /club/aanspreekpunt-integriteit/).
const contacts = [
  {
    heading: 'Lid worden, speeluren en al de rest',
    text: 'Mails naar dit adres komen bij het bestuur terecht. Wil je eens komen meespelen, of heb je een praktische vraag over de club, dan is dit de juiste plek.',
    mail: 'info@bclandegem.be',
  },
  {
    heading: 'De jeugdwerking',
    text: 'Vragen over de trainingen, de groepen, of over een kind dat midden in het seizoen wil beginnen, gaan naar jeugdverantwoordelijke Luc Van Tornhout.',
    mail: 'vantornhoutluc@skynet.be',
    person: 'Luc Van Tornhout',
  },
];
---

<Layout
  title="Contact"
  description="Contactgegevens van Badmintonclub Landegem: waar we spelen in Nevele (Deinze), en bij wie je met welke vraag terechtkan."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Contact"
      intro="In de zaal heb je het snelst een antwoord: op elk speelmoment staat er iemand van de club. Kan je niet langskomen, mail ons dan gerust."
    />

    {/* Waar we spelen */}
    <section class="mt-12 pl-10">
      <h2 class="stem-display text-3xl text-inkt-950 sm:text-4xl">Waar we spelen</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-inkt-700">
        <strong class="text-inkt-950">{locatie.naam}</strong><br />
        {locatie.adres}<br />
        {locatie.gemeente}
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={locatie.kaart}
          target="_blank"
          rel="noopener"
          class="stem-baan inline-flex items-center gap-2 rounded-full border-2 border-inkt-950 px-7 py-3 text-sm text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Bekijk op de kaart
        </a>
        <a
          href={url('/kalender/')}
          class="stem-baan inline-flex items-center gap-2 rounded-full border-2 border-inkt-950/20 px-7 py-3 text-sm text-inkt-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Naar de kalender
        </a>
      </div>
    </section>

    {/* Wie je waarvoor aanspreekt */}
    <section class="mt-16 pl-10">
      <h2 class="stem-display text-3xl text-inkt-950 sm:text-4xl">Bij wie je terechtkan</h2>
      <ul class="mt-6 max-w-3xl">
        {contacts.map((item) => (
          <li class="border-b border-inkt-950/10 py-6 first:border-t">
            <h3 class="font-bold text-inkt-950">{item.heading}</h3>
            <p class="mt-2 leading-relaxed text-inkt-700">{item.text}</p>
            <p class="mt-3">
              <a href={`mailto:${item.mail}`} class="stem-baan text-sm font-semibold text-club-700 underline hover:text-club-800">
                {item.person ? `${item.person} — ${item.mail}` : item.mail}
              </a>
            </p>
          </li>
        ))}
        <li class="border-b border-inkt-950/10 py-6">
          <h3 class="font-bold text-inkt-950">Grensoverschrijdend gedrag of een slecht gevoel</h3>
          <p class="mt-2 leading-relaxed text-inkt-700">
            Daarvoor is er een aanspreekpunt integriteit, los van het bestuur. Op die pagina staat
            wie het is en hoe je er terechtkan.
          </p>
          <p class="mt-3">
            <a href={url('/club/aanspreekpunt-integriteit/')} class="stem-baan text-sm font-semibold text-club-700 underline hover:text-club-800">
              Naar het aanspreekpunt integriteit
            </a>
          </p>
        </li>
        <li class="border-b border-inkt-950/10 py-6">
          <h3 class="font-bold text-inkt-950">Een foto die je liever niet online ziet</h3>
          <p class="mt-2 leading-relaxed text-inkt-700">
            Laat het weten, dan halen we die foto uit het album en verdwijnt hij van de site. Dat
            geldt voor alle albums bij
            <a href={url('/media/')} class="font-semibold text-club-700 underline hover:text-club-800">Foto's</a>.
          </p>
          <p class="mt-3">
            <a href="mailto:info@bclandegem.be" class="stem-baan text-sm font-semibold text-club-700 underline hover:text-club-800">
              info@bclandegem.be
            </a>
          </p>
        </li>
        <li class="border-b border-inkt-950/10 py-6">
          <h3 class="font-bold text-inkt-950">Je gegevens en je privacy</h3>
          <p class="mt-2 leading-relaxed text-inkt-700">
            Welke gegevens we bijhouden, en bij wie je terechtkan om ze te laten aanpassen of
            wissen, staat in de privacyverklaring.
          </p>
          <p class="mt-3">
            <a href={url('/club/privacy/')} class="stem-baan text-sm font-semibold text-club-700 underline hover:text-club-800">
              Naar de privacyverklaring
            </a>
          </p>
        </li>
      </ul>
    </section>

    {/* Geen formulier, wel duidelijkheid over wat er daarna gebeurt */}
    <section class="mt-16 max-w-3xl pl-10">
      <h2 class="stem-display text-2xl text-inkt-950 sm:text-3xl">Wat je meestuurt</h2>
      <p class="mt-3 leading-relaxed text-inkt-700">
        Wil je eens komen meespelen, zet er dan bij wie er komt, hoe oud die is en welke avond je
        zou willen. Dan weten we wie we mogen verwachten en staat er iemand klaar om je wegwijs te
        maken.
      </p>
    </section>
  </div>

  <section class="border-y-8 border-club-800 bg-club-600 text-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-12">
      <div class="flex-[1_1_28rem]">
        <h2 class="stem-display text-3xl sm:text-4xl">Mail ons gerust</h2>
        <p class="mt-2 max-w-xl text-xl font-bold text-white">
          Elke vraag mag naar info@bclandegem.be. Ook als je nog nooit een racket vasthad en niet
          weet of dit iets voor jou is.
        </p>
      </div>
      <a
        href="mailto:info@bclandegem.be"
        class="stem-baan rounded-full bg-white px-7 py-3.5 text-sm text-club-600 transition-colors hover:bg-club-50"
      >
        info@bclandegem.be
      </a>
    </div>
  </section>
</Layout>

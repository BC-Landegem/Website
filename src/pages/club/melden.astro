---
// De meldpagina voor grensoverschrijdend gedrag. Bewust een eigen pagina en
// niet onderaan /club/aanspreekpunt-integriteit/: dat is Lieselots brief, met
// foto en "vele groetjes", en die toon wil je niet breken met een formulier.
// Hier mag het zakelijk zijn: wie leest dit, wat gebeurt er dan, en het formulier.
//
// De teksten hieronder — de intro, "Wie leest je bericht?" en de vier stappen —
// zijn die van het aanspreekpunt zelf (september 2026). Het is haar mailbox en
// haar belofte, niet die van de site: wijzig ze niet zonder haar.
import Layout from '../../layouts/Layout.astro';
import Heading from '../../components/Heading.astro';
import Link from '../../components/Link.astro';
import Dot from '../../components/Dot.astro';
import RailHeading from '../../components/RailHeading.astro';
import ReportForm from '../../components/ReportForm.astro';
import { INTEGRITY_NAME } from '../../data/contact';
import { url } from '../../lib/url';

const firstName = INTEGRITY_NAME.split(' ')[0];

// Dezelfde belofte staat in de rode band op /club/gedragscode/ en in de
// privacyverklaring. Verandert hier iets, dan daar ook.
const steps = [
  {
    title: `${firstName} leest je bericht`,
    text: 'Wat je schrijft, komt als mailtje bij haar binnen en blijft ook bij haar. Het bestuur krijgt het niet te zien, en ook op de website van de club wordt niets bewaard.',
  },
  {
    title: 'Ze neemt contact met je op',
    text: `Doorgaans beantwoordt ${firstName} je bericht binnen de week. Heb je geen contactgegevens achtergelaten? Dan wordt het moeilijk om in contact te staan met elkaar, maar het kan zeker als je een anonieme melding wil doen.`,
  },
  {
    title: 'Jullie bekijken samen wat je nodig hebt',
    text: `Misschien wil je gewoon dat iemand het weet. Misschien hoop je dat er zo iets verandert. ${firstName} doet niets zonder overleg, tenzij het echt nodig is om iemand te beschermen. Jij bepaalt mee wat er gebeurt.`,
  },
  {
    title: 'Ze helpt je verder als je dat wil',
    text: `${firstName} is geen hulpverlener, maar ze weet wie je verder kan helpen. Bijvoorbeeld hulpverlening, het Meldpunt Integriteit van Badminton Vlaanderen, of de politie als het ernstig is. Ze volgt het samen met jou op.`,
  },
];
---

<Layout
  title="Iets melden"
  description="Meld een voorval van grensoverschrijdend gedrag bij BC Landegem. Je bericht komt alleen bij het Aanspreekpunt Integriteit terecht; hier lees je wat er dan gebeurt."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Iets melden"
      intro={`Zit er jou iets dwars, of is er iets gebeurd in de club waar je mee zit? Heb je een vraag, een vermoeden of een klacht over grensoverschrijdend gedrag? Je kan, als jouw grenzen of die van iemand anders worden overschreven, terecht bij ${firstName}, ons Aanspreekpunt Integriteit.`}
    />

    {/* Bij wie komt dit terecht */}
    <section class="mt-12 max-w-3xl pl-10">
      <Heading>Wie leest je bericht?</Heading>
      <p class="mt-4 leading-relaxed text-ink-700">
        Je bericht komt rechtstreeks bij {firstName} terecht. Zij is het Aanspreekpunt Integriteit
        (API) van onze club. Belangrijk om te weten is dat zij geen deel uitmaakt van het bestuur:
        haar functie als API staat los van de bestuurswerking.
        <Link href={url('/club/aanspreekpunt-integriteit/')}>Op haar pagina</Link> kan je
        kennismaken.
      </p>
      <p class="mt-4 leading-relaxed text-ink-700">
        Het kan altijd gebeuren dat je liever met iemand anders praat. Misschien wil je overleggen
        met iemand van buiten de club? Dan kan je terecht bij het
        <Link href="https://badminton.vlaanderen/meldpunt-integriteit/">Meldpunt Integriteit van Badminton Vlaanderen</Link>.
        Bellen kan ook, naar <Link href="tel:1712">1712</Link>. Dat is gratis en je hoeft je naam
        niet te zeggen.
      </p>
    </section>

    {/* Wat er dan gebeurt: de vier stappen, op de rail zoals de gedragscode */}
    <section class="mt-16">
      <Heading class="pl-10">Wat gebeurt er daarna?</Heading>
      <div class="relative mt-8">
        <span class="absolute bottom-6 left-[6px] top-6 w-1 -translate-x-1/2 rounded-full bg-club-500" aria-hidden="true"></span>
        <ol class="max-w-3xl">
          {steps.map((step, i) => (
            <li class="relative border-b border-ink-950/10 py-8 pl-10 first:border-t">
              <Dot top="top-10" />
              <p class="type-label text-xs text-club-700">Stap {i + 1}</p>
              <h3 class="type-display mt-1 text-2xl text-ink-950">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-700">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <ReportForm />
  </div>

  <section class="border-y-8 border-club-800 bg-club-600 text-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-12">
      <div class="flex-[1_1_28rem]">
        <Heading color="inherit">Liever gewoon eens praten?</Heading>
        <p class="mt-2 max-w-xl text-xl font-bold text-white">
          {firstName} is er vaak op zondag-, maandag- en woensdagavond. Spreek haar gerust aan in
          de zaal.
        </p>
      </div>
      <a
        href={url('/club/aanspreekpunt-integriteit/')}
        class="type-label rounded-full bg-white px-7 py-3.5 text-sm text-club-600 transition-colors hover:bg-club-50"
      >
        Over {firstName}
      </a>
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Heading from '../../components/Heading.astro';
import Link from '../../components/Link.astro';
import RailHeading from '../../components/RailHeading.astro';
import { url } from '../../lib/url';

const steps = [
  {
    number: '01',
    title: 'Meld je aan',
    body: 'Twizzit werkt op je telefoon en gewoon in je browser. Je mag allebei gebruiken, met dezelfde login.',
    tips: [
      'Gebruik de login die aan je lidmaatschap bij BC Landegem hangt.',
      'Werk je liever op de computer, zet app.twizzit.com dan bij je favorieten.',
      'Wachtwoord kwijt? Kies “wachtwoord vergeten”. Een tweede account aanmaken helpt niet, want je gegevens hangen aan het eerste.',
    ],
  },
  {
    number: '02',
    title: 'Hou je planning in het oog',
    body: 'Onder Planning kies je Mijn planning. Daar staat wat er voor jou of voor je groep gepland is.',
    tips: [
      'Tik een activiteit open voor het uur, de zaal en wat er verder bij staat.',
      'Wordt je aanwezigheid gevraagd, duid ze dan aan. De verantwoordelijke ziet het meteen.',
      'Op de vrijspelavonden is antwoorden niet verplicht. Het is wel handig om te zien hoe druk het wordt.',
      'Bekijk je alles liever op één plek, exporteer je activiteiten dan naar je eigen agenda.',
    ],
  },
  {
    number: '03',
    title: 'Zet je meldingen goed',
    body: 'Bij Instellingen & voorkeuren kies je zelf wat je op je telefoon krijgt en wat in je mailbox.',
    tips: [
      'Laat clubberichten en wijzigingen aan activiteiten zeker aanstaan. Dat is net wat je niet wil missen.',
      'Te veel meldingen? Zet één categorie af in plaats van ze allemaal.',
      'Blijft Twizzit stil, kijk dan ook eens in de instellingen van je telefoon.',
    ],
  },
  {
    number: '04',
    title: 'Wissel tussen gezinsleden',
    body: 'Spelen je kinderen mee, dan hoef je niet telkens uit en weer in te loggen. Je wisselt gewoon van gebruiker.',
    tips: [
      'Kijk bovenaan voor wie je een activiteit of een bericht bekijkt.',
      'Ontbreekt er een kind, of zie je de verkeerde groep? Maak geen tweede account aan, maar laat de koppeling nakijken.',
      'Verander je van e-mailadres of gsm-nummer, pas het dan aan. Anders bereiken onze berichten je niet meer.',
    ],
  },
];
---

<Layout
  title="Tips voor Twizzit"
  description="Praktische tips voor leden en ouders van BC Landegem: aanmelden bij Twizzit, je planning en je aanwezigheid opvolgen, meldingen instellen en wisselen tussen gezinsleden."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Tips voor Twizzit"
      intro="In Twizzit staat onze planning: wanneer je traint, wanneer je ploeg speelt en wie er komt. Met deze vier dingen ben je vertrokken."
    >
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="https://get.twizzit.com"
          target="_blank"
          rel="noopener"
          class="type-label inline-flex items-center gap-2 rounded-full bg-club-600 px-5 py-3 text-xs text-white transition-colors hover:bg-club-700"
        >
          Download de app
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://app.twizzit.com"
          target="_blank"
          rel="noopener"
          class="type-label inline-flex items-center gap-2 rounded-full border border-ink-950/30 px-5 py-3 text-xs text-ink-950 transition-colors hover:border-club-600 hover:text-club-700"
        >
          Open Twizzit in je browser
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </RailHeading>

    <ol class="relative mt-14">
      <span class="absolute bottom-12 left-[6px] top-12 w-1 -translate-x-1/2 rounded-full bg-club-500" aria-hidden="true"></span>
      {steps.map((step) => (
        <li class="relative border-b border-ink-950/10 py-10 pl-10 first:border-t md:grid md:grid-cols-[18rem_1fr] md:gap-10">
          <span class="type-numeral absolute left-[6px] top-12 flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full bg-club-600 text-xs text-white ring-4 ring-feather-50" aria-hidden="true">
            {step.number}
          </span>
          <div>
            <p class="type-label text-xs text-club-700">Tip {step.number}</p>
            <Heading as="h2" size="small" class="mt-1 !break-normal">{step.title}</Heading>
          </div>
          <div class="mt-5 md:mt-0">
            <p class="leading-relaxed text-ink-700">{step.body}</p>
            <ul class="mt-5 space-y-3 leading-relaxed text-ink-700">
              {step.tips.map((tip) => (
                <li class="grid grid-cols-[1.25rem_1fr] items-baseline">
                  <span class="text-club-500" aria-hidden="true">—</span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <section class="ml-10 mt-14 max-w-4xl border-l-4 border-club-700 bg-feather-100 px-6 py-8 sm:px-8">
      <Heading size="small">Lukt het niet?</Heading>
      <div class="mt-4 space-y-4 leading-relaxed text-ink-700">
        <p>
          Kijk eerst na of je bij de juiste gebruiker en de juiste club zit. Krijg je niets binnen,
          ga dan in de instellingen van je telefoon na of Twizzit meldingen mag sturen.
        </p>
        <p>
          Voor uitleg over een functie kan je terecht in de
          <Link href="https://www.twizzit.com/nl-be/knowledgebase/category/twizzit-eerste-gebruik-eindgebruiker.html">
            officiële handleiding voor gebruikers
          </Link>.
          Ontbreekt je planning, groep of gezinskoppeling? Laat het weten via
          <Link href={url('/club/contact/#formulier')}>het contactformulier</Link>, dan kijken we het na.
        </p>
      </div>
    </section>
  </div>
</Layout>

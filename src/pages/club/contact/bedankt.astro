---
// Landing na een geslaagde verzending: de Laravel-app op intra.bclandegem.be
// stuurt hierheen terug. Bewust geen antwoordtermijn — het bestuur is
// vrijwilligerswerk, en een belofte die soms breekt is erger dan geen belofte.
// Wat we wél kunnen beloven is het snelste kanaal: gewoon binnenspringen.
import Layout from '../../../layouts/Layout.astro';
import RailHeading from '../../../components/RailHeading.astro';
import Heading from '../../../components/Heading.astro';
import Link from '../../../components/Link.astro';
import { url } from '../../../lib/url';
import trainings from '../../../data/trainings.json';

const { location } = trainings;
---

<Layout
  title="Bedankt voor je bericht"
  description="Je bericht aan BC Landegem is verstuurd."
  noindex
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Bedankt, je bericht is vertrokken"
      intro="Het komt terecht bij het bestuur. We lezen alles en antwoorden zo snel we kunnen."
    />

    <section class="mt-12 max-w-3xl space-y-4 pl-10 leading-relaxed text-ink-700">
      <p>
        Wil je sneller iets weten, spring dan gerust eens binnen op een speelmoment. In de zaal
        staat er altijd iemand van de club, en dan heb je meteen antwoord — én zie je hoe het er bij
        ons aan toegaat.
      </p>
      <p>
        We spelen in <strong class="text-ink-950">{location.name}</strong>, {location.address},
        {location.municipality}.
      </p>
    </section>

    <section class="mt-12 pl-10">
      <Heading size="small">Ondertussen</Heading>
      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={url('/kalender/')}
          class="type-label inline-flex items-center gap-2 rounded-full border-2 border-ink-950 px-7 py-3 text-sm text-ink-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Bekijk de kalender
        </a>
        <a
          href={url('/club/word-lid/')}
          class="type-label inline-flex items-center gap-2 rounded-full border-2 border-ink-950/20 px-7 py-3 text-sm text-ink-950 transition-colors hover:border-club-600 hover:text-club-600"
        >
          Lees hoe je lid wordt
        </a>
      </div>
      <p class="mt-8 max-w-3xl leading-relaxed text-ink-700">
        Toch nog iets vergeten? Je mag gerust
        <Link href={url('/club/contact/#formulier')}>nog een bericht sturen</Link>.
      </p>
    </section>
  </div>
</Layout>

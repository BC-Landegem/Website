---
import Layout from '../../layouts/Layout.astro';
import RailHeading from '../../components/RailHeading.astro';
import ArchiveSearch from '../../components/ArchiveSearch.astro';
import { url } from '../../lib/url';
import { allArticles, byYear, GROUPS, byGroup } from '../../lib/archive';

const articles = await allArticles();
const years = await byYear();
const oldest = articles[articles.length - 1];
const newest = articles[0];

const groups = await Promise.all(
  GROUPS.map(async (g) => ({ ...g, count: (await byGroup(g.key)).length })),
);

const writerCount = new Set(articles.map((a) => a.data.auteur).filter(Boolean)).size;
const withoutTopic = articles.filter((a) => !a.data.groep).length;

// Grootste jaar bepaalt de schaal van de staafjes in de jaartijdlijn.
const peak = Math.max(...[...years.values()].map((v) => v.length));
const yearList = [...years.entries()];
---

<Layout
  title="Archief"
  description="Het archief van de oude clubsite van BC Landegem: 837 artikels uit 2009 tot 2025 — wedstrijdverslagen, intraclub, jeugdweekends en clubnieuws."
>
  <div class="bg-feather-100">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-16">
      <RailHeading
        title="Archief"
        accent="cork"
        intro="Alles wat er tussen 2009 en 2025 op de oude clubsite verscheen, bewaard zoals het geschreven werd."
      >
        <p class="mt-3 max-w-2xl text-sm text-ink-500">
          {articles.length} artikels van {writerCount} schrijvers, met de reacties die er destijds onder
          stonden. De club bestaat sinds 1987 — voor de jaren daarvóór is er geen archief, wel <a
            href={url('/club/over-de-club/')}
            class="font-semibold underline hover:text-cork-600">het verhaal van Herman</a
          >.
        </p>

        <ArchiveSearch />
      </RailHeading>

      {/* ---------------------------------------------------------- groepen */}
      <section class="mt-16 pl-10" aria-labelledby="groups-heading">
        <h2 id="groups-heading" class="type-label text-xs text-ink-500">Per onderwerp</h2>
        <ul class="mt-4 grid gap-px border border-ink-950/10 bg-ink-950/10 sm:grid-cols-2">
          {groups.map((g, i) => (
            // Bij een oneven aantal zou de laatste tegel een lege cel naast zich
            // laten; die laat je dan de volle breedte nemen.
            <li class:list={['bg-feather-100', i === groups.length - 1 && groups.length % 2 === 1 && 'sm:col-span-2']}>
              <a
                href={url(`/archief/${g.key}/`)}
                class="group flex h-full items-baseline justify-between gap-4 p-5 transition-colors hover:bg-feather-50"
              >
                <span>
                  <span class="type-display block text-xl text-ink-950 group-hover:text-cork-600">
                    {g.label}
                  </span>
                  <span class="mt-1 block text-sm text-ink-500">{g.description}</span>
                </span>
                <span class="type-numeral shrink-0 text-lg text-cork-600">{g.count}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm text-ink-500">
          De {withoutTopic} oudste artikels hebben geen onderwerp: die dateren van vóór de club
          categorieën gebruikte. Ze staan wel bij hun jaar.
        </p>
      </section>

      {/* ------------------------------------------------------- jaarlijn */}
      <section class="mt-16 pl-10" aria-labelledby="years-heading">
        <h2 id="years-heading" class="type-label text-xs text-ink-500">Per jaar</h2>
        <ol class="mt-4 border-t border-ink-950/10">
          {yearList.map(([year, list]) => (
            <li class="border-b border-ink-950/10">
              <a
                href={url(`/archief/${year}/`)}
                class="group flex items-center gap-4 py-3 transition-colors hover:text-cork-600"
              >
                <span class="type-numeral w-14 shrink-0 text-lg text-ink-950 group-hover:text-cork-600">
                  {year}
                </span>
                <span class="relative h-2 flex-1 bg-ink-950/5">
                  <span
                    class="absolute inset-y-0 left-0 bg-cork-400 transition-colors group-hover:bg-cork-600"
                    style={`width: ${Math.max(2, Math.round((list.length / peak) * 100))}%`}
                  />
                </span>
                <span class="type-numeral w-10 shrink-0 text-right text-sm text-ink-500">
                  {list.length}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</Layout>

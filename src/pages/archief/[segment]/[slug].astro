---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import { url } from '../../../lib/url';
import {
  byYear, yearOf, formatDateLong, formatDateShort, articlePath, groupLabel,
  type Article, type Group,
} from '../../../lib/archive';

export const getStaticPaths: GetStaticPaths = async () => {
  const years = await byYear();
  return [...years.entries()].flatMap(([year, articles]) =>
    articles.map((article, i) => ({
      params: { segment: year, slug: article.data.urlnaam },
      props: {
        article,
        // Binnen het jaar: nieuwer staat eerder in de lijst (nieuwste eerst).
        newer: articles[i - 1] ?? null,
        older: articles[i + 1] ?? null,
      },
    })),
  );
};

interface Props {
  article: Article;
  newer: Article | null;
  older: Article | null;
}

const { article, newer, older } = Astro.props;
const year = yearOf(article);

/**
 * De beelden staan in de markdown als absoluut pad (`/archief/beelden/…`), want
 * die bestanden zijn gegenereerd uit de oude database en weten niets van de
 * base-prefix waaronder GitHub Pages de site serveert. In een .astro-bestand
 * doet `url()` dat werk; in markdown is er geen plek om die functie aan te
 * roepen, en Astro 7 draait op Sätteri — een rehype-plugin zou de hele
 * markdown-pipeline terug naar unified duwen voor deze ene prefix.
 *
 * Dus prefixen we de gerenderde HTML hier. Die HTML komt uit onze eigen
 * conversie, niet van een bezoeker: `set:html` is hier veilig.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const content = (article.rendered?.html ?? '')
  .replaceAll('"/archief/beelden/', `"${base}/archief/beelden/`)
  .replaceAll('<img ', '<img loading="lazy" decoding="async" ');
const comments = article.data.reacties ?? [];
const isoDate = article.data.datum.toISOString().slice(0, 10);
---

<Layout
  title={article.data.titel}
  description={`Uit het archief van BC Landegem, ${formatDateLong(article.data.datum)}.`}
>
  <div class="bg-feather-100">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:py-16">
      <nav class="type-label mb-8 text-[0.65rem] text-ink-500">
        <a href={url('/archief/')} class="hover:text-cork-600">Archief</a>
        <span aria-hidden="true"> / </span>
        <a href={url(`/archief/${year}/`)} class="hover:text-cork-600">{year}</a>
        {article.data.groep && (
          <>
            <span aria-hidden="true"> / </span>
            <a href={url(`/archief/${article.data.groep}/`)} class="hover:text-cork-600">
              {groupLabel(article.data.groep as Group)}
            </a>
          </>
        )}
      </nav>

      {/*
        Twee onafhankelijke signalen dat dit oud is: deze band, en de kurkkleur
        van de hele sectie. Nodig, want een deel van deze artikels leest als
        nieuws — "Nu woensdag is er intraclub, graag om 20u30" stond hier ooit
        over aanstaande woensdag.
      */}
      <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1 border-l-2 border-cork-600 bg-cork-300/20 px-4 py-2.5 text-sm text-ink-700">
        <span class="type-label text-[0.65rem] text-cork-600">Uit het archief</span>
        <span>
          Dit artikel verscheen op <time datetime={isoDate}>{formatDateLong(article.data.datum)}</time> op
          de oude clubsite. Wat erin staat gold toen, niet nu.
        </span>
      </p>

      <article class="mt-8" data-pagefind-body>
        <header>
          <h1 data-pagefind-meta="title" class="type-display text-3xl text-ink-950 sm:text-4xl">
            {article.data.titel}
          </h1>
          {/*
            Los meta-attribuut per veld: één attribuut met komma's splitst Pagefind
            niet, dan wordt "06.11.2011,author:Luc" één waarde.
            data-pagefind-ignore houdt deze regel uit het zoekuittreksel — anders
            begint elk resultaat met "6 november 2011 · door Luc · Clubnieuws".
          */}
          <span data-pagefind-meta={`date:${formatDateShort(article.data.datum)}`} hidden></span>
          {article.data.auteur && (
            <span data-pagefind-meta={`author:${article.data.auteur}`} hidden></span>
          )}
          <p data-pagefind-ignore class="type-label mt-3 text-[0.65rem] text-ink-500">
            <time datetime={isoDate}>{formatDateLong(article.data.datum)}</time>
            {article.data.auteur && (
              <>
                <span aria-hidden="true"> · </span>
                <span>door {article.data.auteur}</span>
              </>
            )}
            <span aria-hidden="true"> · </span>
            <span>{article.data.categorie === 'Uncategorised' ? 'Clubnieuws' : article.data.categorie}</span>
          </p>
        </header>

        {/*
          Krappe alinea-afstand, bewust. In de JCE-editor van de oude site maakte
          één druk op Enter een nieuwe <p>, ook middenin een zin. Met normale
          prose-afstand zou zo'n gesplitste zin eruitzien als een fout in de
          conversie; zo leest het als de regelval die de schrijver bedoelde.
        */}
        <div
          class="prose prose-sm mt-8 max-w-none text-ink-700 prose-headings:type-display prose-headings:text-ink-950 prose-p:my-2 prose-a:text-cork-600 prose-a:underline hover:prose-a:text-ink-950 prose-strong:text-ink-950 prose-img:my-6 prose-img:border prose-img:border-ink-950/10 prose-table:text-sm prose-td:px-2 prose-td:py-1 sm:prose-base sm:prose-p:my-2.5"
          set:html={content}
        />

      </article>

      {/* ------------------------------------------------------- reacties */}
      {comments.length > 0 && (
        <section class="mt-14" aria-labelledby="comments-heading">
          <h2 id="comments-heading" class="type-label text-xs text-ink-500">
            {comments.length} {comments.length === 1 ? 'reactie' : 'reacties'} destijds
          </h2>
          <ol class="mt-5 space-y-5">
            {comments.map((r) => (
              <li class="border-l-2 border-ink-950/10 pl-4">
                <p class="type-label text-[0.65rem] text-ink-500">
                  {r.naam}
                  <span aria-hidden="true"> · </span>
                  <time datetime={r.datum.toISOString().slice(0, 10)}>{formatDateShort(r.datum)}</time>
                </p>
                <p class="mt-1 whitespace-pre-line text-sm text-ink-700">{r.tekst}</p>
              </li>
            ))}
          </ol>
          <p class="mt-6 text-xs text-ink-500">
            Reageren kan niet meer — deze reacties zijn overgenomen uit de oude site.
          </p>
        </section>
      )}

      {/* ------------------------------------------------------ navigatie */}
      <nav class="mt-14 grid gap-px border border-ink-950/10 bg-ink-950/10 sm:grid-cols-2">
        {older ? (
          <a href={url(articlePath(older))} class="group bg-feather-100 p-4 transition-colors hover:bg-feather-50">
            <span class="type-label block text-[0.65rem] text-ink-500">← Ouder</span>
            <span class="mt-1 block text-sm text-ink-950 group-hover:text-cork-600">
              {older.data.titel}
            </span>
          </a>
        ) : (
          <span class="bg-feather-100 p-4">
            <span class="type-label block text-[0.65rem] text-ink-500">Oudste van {year}</span>
          </span>
        )}
        {newer ? (
          <a
            href={url(articlePath(newer))}
            class="group bg-feather-100 p-4 text-right transition-colors hover:bg-feather-50"
          >
            <span class="type-label block text-[0.65rem] text-ink-500">Nieuwer →</span>
            <span class="mt-1 block text-sm text-ink-950 group-hover:text-cork-600">
              {newer.data.titel}
            </span>
          </a>
        ) : (
          <span class="bg-feather-100 p-4 text-right">
            <span class="type-label block text-[0.65rem] text-ink-500">Nieuwste van {year}</span>
          </span>
        )}
      </nav>

      <p class="mt-6 text-center">
        <a href={url(`/archief/${year}/`)} class="type-label text-xs text-ink-500 hover:text-cork-600">
          Alles uit {year}
        </a>
      </p>
    </div>
  </div>
</Layout>

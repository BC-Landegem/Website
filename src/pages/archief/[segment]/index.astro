---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import RailHeading from '../../../components/RailHeading.astro';
import { url } from '../../../lib/url';
import {
  allArticles, byYear, inGroup, GROUPS, yearOf,
  dateShort, articlePath, excerpt, groupLabel, type Article, type Group,
} from '../../../lib/archive';

/**
 * Eén route voor twee soorten overzicht: een jaar (/archief/2013/) en een
 * onderwerp (/archief/competitie/). Ze delen dezelfde plek in de URL, dus ook
 * dezelfde route — anders zou Astro twee dynamische mappen naast elkaar zien.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const years = await byYear();
  const yearPaths = [...years.entries()].map(([year, articles]) => ({
    params: { segment: year },
    props: { kind: 'jaar' as const, title: year, articles },
  }));
  const groupPaths = await Promise.all(
    GROUPS.map(async (g) => ({
      params: { segment: g.key },
      props: {
        kind: 'groep' as const,
        title: g.label,
        description: g.description,
        articles: await inGroup(g.key),
      },
    })),
  );
  return [...yearPaths, ...groupPaths];
};

interface Props {
  kind: 'jaar' | 'groep';
  title: string;
  description?: string;
  articles: Article[];
}

const { kind, title, description, articles } = Astro.props;
const all = await allArticles();
const years = await byYear();
const yearList = [...years.keys()];

// Een onderwerppagina groepeert zelf per jaar; een jaarpagina is al één blok.
const blocks: [string, Article[]][] =
  kind === 'jaar'
    ? [['', articles]]
    : [...articles.reduce((m, a) => {
        const j = yearOf(a);
        m.set(j, [...(m.get(j) ?? []), a]);
        return m;
      }, new Map<string, Article[]>()).entries()];

const currentYear = kind === 'jaar' ? title : null;
const previous = currentYear ? yearList[yearList.indexOf(currentYear) + 1] : null;
const next = currentYear ? yearList[yearList.indexOf(currentYear) - 1] : null;

const intro =
  kind === 'jaar'
    ? `${articles.length} ${articles.length === 1 ? 'artikel' : 'artikels'} uit ${title}.`
    : description;
const pageTitle = kind === 'jaar' ? `Archief ${title}` : `Archief · ${title}`;
---

<Layout
  title={pageTitle}
  description={`${articles.length} artikels uit het archief van BC Landegem — ${kind === 'jaar' ? title : title.toLowerCase()}.`}
>
  <div class="bg-veer-100">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:py-16">
      <nav class="stem-baan mb-8 pl-10 text-[0.65rem] text-inkt-500">
        <a href={url('/archief/')} class="hover:text-kurk-600">Archief</a>
        <span aria-hidden="true"> / </span>
        <span class="text-inkt-700">{title}</span>
      </nav>

      <RailHeading title={kind === 'jaar' ? title : title} accent="kurk" intro={intro} />

      {/* -------------------------------------------------- artikellijst */}
      <div class="mt-12 space-y-14 pl-10">
        {blocks.map(([year, list]) => (
          <section aria-labelledby={year ? `jaar-${year}` : undefined}>
            {year && (
              <h2 id={`jaar-${year}`} class="stem-cijfer border-b border-inkt-950/10 pb-2 text-xl text-inkt-950">
                <a href={url(`/archief/${year}/`)} class="hover:text-kurk-600">{year}</a>
                <span class="stem-baan ml-2 text-[0.65rem] text-inkt-500">{list.length}</span>
              </h2>
            )}
            <ol class:list={['divide-y divide-inkt-950/10', !year && 'border-t border-inkt-950/10']}>
              {list.map((a) => (
                <li>
                  <a href={url(articlePath(a))} class="group flex gap-4 py-4 sm:gap-6">
                    <time
                      datetime={a.data.datum.toISOString().slice(0, 10)}
                      class="stem-cijfer w-[5.5rem] shrink-0 pt-1 text-sm text-inkt-500"
                    >
                      {dateShort(a.data.datum)}
                    </time>
                    <span class="min-w-0">
                      <span class="stem-display block text-lg text-inkt-950 group-hover:text-kurk-600">
                        {a.data.titel}
                      </span>
                      <span class="mt-1 block text-sm text-inkt-700">{excerpt(a, 150)}</span>
                      <span class="stem-baan mt-1.5 block text-[0.65rem] text-inkt-500">
                        {a.data.auteur && <>{a.data.auteur}</>}
                        {a.data.auteur && a.data.groep && <span aria-hidden="true"> · </span>}
                        {a.data.groep && <>{groupLabel(a.data.groep as Group)}</>}
                        {a.data.reacties?.length && (
                          <>
                            <span aria-hidden="true"> · </span>
                            {a.data.reacties.length}{' '}
                            {a.data.reacties.length === 1 ? 'reactie' : 'reacties'}
                          </>
                        )}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      {/* ------------------------------------------------------- navigatie */}
      {kind === 'jaar' && (
        <nav class="mt-14 flex items-center justify-between gap-4 border-t border-inkt-950/10 pl-10 pt-6">
          {previous ? (
            <a href={url(`/archief/${previous}/`)} class="stem-baan text-xs text-inkt-700 hover:text-kurk-600">
              ← {previous}
            </a>
          ) : (
            <span></span>
          )}
          <a href={url('/archief/')} class="stem-baan text-xs text-inkt-500 hover:text-kurk-600">
            Alle jaren
          </a>
          {next ? (
            <a href={url(`/archief/${next}/`)} class="stem-baan text-xs text-inkt-700 hover:text-kurk-600">
              {next} →
            </a>
          ) : (
            <span></span>
          )}
        </nav>
      )}

      {kind === 'groep' && (
        <nav class="mt-14 border-t border-inkt-950/10 pl-10 pt-6">
          <a href={url('/archief/')} class="stem-baan text-xs text-inkt-500 hover:text-kurk-600">
            ← Terug naar het archief ({all.length} artikels)
          </a>
        </nav>
      )}
    </div>
  </div>
</Layout>

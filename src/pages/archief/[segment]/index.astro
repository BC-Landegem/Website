---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import RailKop from '../../../components/RailKop.astro';
import { url } from '../../../lib/url';
import {
  alleArtikels, perJaar, vanGroep, GROEPEN, jaarVan,
  datumKort, artikelPad, inleiding, groepLabel, type Artikel, type Groep,
} from '../../../lib/archief';

/**
 * Eén route voor twee soorten overzicht: een jaar (/archief/2013/) en een
 * onderwerp (/archief/competitie/). Ze delen dezelfde plek in de URL, dus ook
 * dezelfde route — anders zou Astro twee dynamische mappen naast elkaar zien.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const jaren = await perJaar();
  const jaarPaden = [...jaren.entries()].map(([jaar, artikels]) => ({
    params: { segment: jaar },
    props: { soort: 'jaar' as const, titel: jaar, artikels },
  }));
  const groepPaden = await Promise.all(
    GROEPEN.map(async (g) => ({
      params: { segment: g.sleutel },
      props: {
        soort: 'groep' as const,
        titel: g.label,
        uitleg: g.uitleg,
        artikels: await vanGroep(g.sleutel),
      },
    })),
  );
  return [...jaarPaden, ...groepPaden];
};

interface Props {
  soort: 'jaar' | 'groep';
  titel: string;
  uitleg?: string;
  artikels: Artikel[];
}

const { soort, titel, uitleg, artikels } = Astro.props;
const alle = await alleArtikels();
const jaren = await perJaar();
const jaarLijst = [...jaren.keys()];

// Een onderwerppagina groepeert zelf per jaar; een jaarpagina is al één blok.
const blokken: [string, Artikel[]][] =
  soort === 'jaar'
    ? [['', artikels]]
    : [...artikels.reduce((m, a) => {
        const j = jaarVan(a);
        m.set(j, [...(m.get(j) ?? []), a]);
        return m;
      }, new Map<string, Artikel[]>()).entries()];

const huidigJaar = soort === 'jaar' ? titel : null;
const vorige = huidigJaar ? jaarLijst[jaarLijst.indexOf(huidigJaar) + 1] : null;
const volgende = huidigJaar ? jaarLijst[jaarLijst.indexOf(huidigJaar) - 1] : null;

const intro =
  soort === 'jaar'
    ? `${artikels.length} ${artikels.length === 1 ? 'artikel' : 'artikels'} uit ${titel}.`
    : uitleg;
const paginaTitel = soort === 'jaar' ? `Archief ${titel}` : `Archief · ${titel}`;
---

<Layout
  title={paginaTitel}
  description={`${artikels.length} artikels uit het archief van BC Landegem — ${soort === 'jaar' ? titel : titel.toLowerCase()}.`}
>
  <div class="bg-veer-100">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:py-16">
      <nav class="stem-baan mb-8 pl-10 text-[0.65rem] text-inkt-500">
        <a href={url('/archief/')} class="hover:text-kurk-600">Archief</a>
        <span aria-hidden="true"> / </span>
        <span class="text-inkt-700">{titel}</span>
      </nav>

      <RailKop title={soort === 'jaar' ? titel : titel} accent="kurk" intro={intro} />

      {/* -------------------------------------------------- artikellijst */}
      <div class="mt-12 space-y-14 pl-10">
        {blokken.map(([jaar, lijst]) => (
          <section aria-labelledby={jaar ? `jaar-${jaar}` : undefined}>
            {jaar && (
              <h2 id={`jaar-${jaar}`} class="stem-cijfer border-b border-inkt-950/10 pb-2 text-xl text-inkt-950">
                <a href={url(`/archief/${jaar}/`)} class="hover:text-kurk-600">{jaar}</a>
                <span class="stem-baan ml-2 text-[0.65rem] text-inkt-500">{lijst.length}</span>
              </h2>
            )}
            <ol class:list={['divide-y divide-inkt-950/10', !jaar && 'border-t border-inkt-950/10']}>
              {lijst.map((a) => (
                <li>
                  <a href={url(artikelPad(a))} class="group flex gap-4 py-4 sm:gap-6">
                    <time
                      datetime={a.data.datum.toISOString().slice(0, 10)}
                      class="stem-cijfer w-[5.5rem] shrink-0 pt-1 text-sm text-inkt-500"
                    >
                      {datumKort(a.data.datum)}
                    </time>
                    <span class="min-w-0">
                      <span class="stem-display block text-lg text-inkt-950 group-hover:text-kurk-600">
                        {a.data.titel}
                      </span>
                      <span class="mt-1 block text-sm text-inkt-700">{inleiding(a, 150)}</span>
                      <span class="stem-baan mt-1.5 block text-[0.65rem] text-inkt-500">
                        {a.data.auteur && <>{a.data.auteur}</>}
                        {a.data.auteur && a.data.groep && <span aria-hidden="true"> · </span>}
                        {a.data.groep && <>{groepLabel(a.data.groep as Groep)}</>}
                        {a.data.reacties?.length && (
                          <>
                            <span aria-hidden="true"> · </span>
                            {a.data.reacties.length}{' '}
                            {a.data.reacties.length === 1 ? 'reactie' : 'reacties'}
                          </>
                        )}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      {/* ------------------------------------------------------- navigatie */}
      {soort === 'jaar' && (
        <nav class="mt-14 flex items-center justify-between gap-4 border-t border-inkt-950/10 pl-10 pt-6">
          {vorige ? (
            <a href={url(`/archief/${vorige}/`)} class="stem-baan text-xs text-inkt-700 hover:text-kurk-600">
              ← {vorige}
            </a>
          ) : (
            <span></span>
          )}
          <a href={url('/archief/')} class="stem-baan text-xs text-inkt-500 hover:text-kurk-600">
            Alle jaren
          </a>
          {volgende ? (
            <a href={url(`/archief/${volgende}/`)} class="stem-baan text-xs text-inkt-700 hover:text-kurk-600">
              {volgende} →
            </a>
          ) : (
            <span></span>
          )}
        </nav>
      )}

      {soort === 'groep' && (
        <nav class="mt-14 border-t border-inkt-950/10 pl-10 pt-6">
          <a href={url('/archief/')} class="stem-baan text-xs text-inkt-500 hover:text-kurk-600">
            ← Terug naar het archief ({alle.length} artikels)
          </a>
        </nav>
      )}
    </div>
  </div>
</Layout>

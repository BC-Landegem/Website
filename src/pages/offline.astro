---
// Vangnet van de service worker: verschijnt wanneer je een pagina opvraagt die
// nog niet in de cache zit en er geen verbinding is.
import Layout from '../layouts/Layout.astro';
import RailHeading from '../components/RailHeading.astro';
import { url } from '../lib/url';
---

<Layout
  title="Geen verbinding"
  description="Deze pagina van BC Landegem is niet beschikbaar zonder internetverbinding."
  noindex
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-16">
    <RailHeading
      title="Geen verbinding"
      intro="Deze pagina staat nog niet in de cache en je toestel krijgt er op dit moment niet bij."
    />

    <div class="mt-12 max-w-2xl space-y-4 pl-10 leading-relaxed text-inkt-700">
      <p>
        Pagina's die je eerder bezocht blijven wél werken, ook zonder bereik. Van de kalender en de
        intraclub toont de app dan de laatst opgehaalde stand — die kan intussen achterhaald zijn.
      </p>
      <p>
        <a
          href={url('/')}
          class="font-semibold text-club-700 underline underline-offset-4 hover:text-club-500"
          >Terug naar de startpagina</a
        >
      </p>
    </div>
  </div>
</Layout>

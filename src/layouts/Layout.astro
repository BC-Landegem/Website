---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Onderdruk de Referer-header voor alle requests vanaf deze pagina.
   * Nodig op de mediapagina's: Google's foto-CDN (lh3.googleusercontent.com)
   * antwoordt met 429 zodra er een vreemde referer meekomt. Niet site-breed
   * zetten — de Google Calendar API-key is juist referrer-restricted.
   */
  noReferrer?: boolean;
}

const {
  title,
  description = 'Badmintonclub Landegem — recreatief en competitief badminton voor jong en oud.',
  noReferrer = false,
} = Astro.props;
const pageTitle = title ? `${title} | BC Landegem` : 'BC Landegem — Badmintonclub Landegem';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noReferrer && <meta name="referrer" content="no-referrer" />}
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-screen flex-col bg-veer-50 text-inkt-950 antialiased">
    <!--
      DESIGN CONTRACT — De Shuttle (seed fc2b4f50, code-led)
      THESIS: De site is opgebouwd uit de anatomie van de shuttle — kurk, rode
      band, verenkrans, vluchtbaan — en weigert de standaard clubsite van
      fotohero plus kaartengrid.
      OWN-WORLD: veerwit (#faf7f1) als grond, warm inktzwart als basis,
      clubrood #eb4024 dat hele banen bezit, kurk als accent; Archivo over drie
      breedtes (expanded display, baan-labels, tabulaire cijfers); één
      doorlopende rode vluchtlijn draagt echte data.
      STORY: een bezoeker begrijpt in seconden dat dit een warme dorpsclub is,
      ziet wanneer er gespeeld wordt, en doet een proefbeurt of wordt lid.
      FIRST VIEWPORT: verenkrans en vluchtbaan lanceren vanuit het kurkpunt
      linksonder; de kop rijdt de lancering, "Word lid!" zit op het kurkpunt,
      het eerstvolgende speelmoment is meteen zichtbaar.
      FORM: de veren shuttle als fysiek object, kandidaat 7 van de gegronde
      lijst, toegewezen door seed fc2b4f50.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, DESIGN.md, and every shipping raster
      carrying its provenance.
    -->
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>

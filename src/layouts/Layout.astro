---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KleurLab from '../components/KleurLab.astro';
import { APP_KORTE_NAAM, THEMA_KLEUR } from '../data/pwa';
import registratieSjabloon from '../sw/registratie.js?raw';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /**
   * Onderdruk de Referer-header voor alle requests vanaf deze pagina.
   * Nodig op de mediapagina's: Google's foto-CDN (lh3.googleusercontent.com)
   * antwoordt met 429 zodra er een vreemde referer meekomt. Niet site-breed
   * zetten — de Google Calendar API-key is juist referrer-restricted.
   */
  noReferrer?: boolean;
  /** Houdt de pagina uit de zoekresultaten (gebruikt door /offline/). */
  noindex?: boolean;
}

const {
  title,
  description = 'Badmintonclub Landegem — recreatief en competitief badminton voor jong en oud.',
  noReferrer = false,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | BC Landegem` : 'BC Landegem — Badmintonclub Landegem';
// Alle paden lopen via url(): import.meta.env.BASE_URL is '/Website' zónder
// slash op het einde, dus `${BASE_URL}favicon.ico` gaf /Websitefavicon.ico.

// Registratie van de service worker plus het opruimen van vreemde workers
// (zie src/sw/registratie.js). Inline in de head zodat het geen extra request
// kost, en alleen in een echte build — in dev zou de worker de HMR-assets
// cachen.
const swRegistratie = registratieSjabloon
  .replaceAll('__SW_PAD__', url('/sw.js'))
  .replaceAll('__BASE__', url('/'));
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noReferrer && <meta name="referrer" content="no-referrer" />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('/favicon-16x16.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    {/* Progressive web app: installeerbaar op het beginscherm, met een service
         worker die de schil offline houdt. Zie src/data/pwa.ts. */}
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="theme-color" content={THEMA_KLEUR} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={APP_KORTE_NAAM} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Kalenderdata (hero-chip, events, kalenderpagina) komt via fetch van de
         Google Calendar API; preconnect scheelt een handshake. */}
    <link rel="preconnect" href="https://www.googleapis.com" crossorigin />
    {/* De intraclub-API staat op het oude domein en praat HTTP/1.1: de TLS-
         handshake kost er 150–450 ms, en die stond vóór dit hint volledig op
         het kritieke pad van de standen (de homepage-top-10 en /intraclub/).
         crossorigin, want een CORS-fetch gebruikt de anonieme socketpool — zonder
         dat attribuut warmt de preconnect de verkeerde verbinding op. Bij de
         domeinswitch naar bclandegem.be wordt dit same-origin en dus overbodig. */}
    <link rel="preconnect" href="https://www.bclandegem.be" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* Intern kleurlab: doet niets zonder ?kleurlab in de URL. */}
    <KleurLab />
    {import.meta.env.PROD && <script is:inline set:html={swRegistratie} />}
  </head>
  <body class="flex min-h-screen flex-col bg-veer-50 text-inkt-950 antialiased">
    {/*
      DESIGN CONTRACT — De Shuttle (seed fc2b4f50, code-led)
      THESIS: De site is opgebouwd uit de anatomie van de shuttle — kurk, rode
      band, verenkrans, vluchtbaan — en weigert de standaard clubsite van
      fotohero plus kaartengrid.
      OWN-WORLD: veerwit (#faf7f1) als grond, warm inktzwart als basis,
      clubrood #eb4024 dat hele banen bezit, kurk als accent; Archivo over drie
      breedtes (expanded display, baan-labels, tabulaire cijfers); één
      doorlopende rode vluchtlijn draagt echte data.
      STORY: een bezoeker begrijpt in seconden dat dit een warme dorpsclub is,
      ziet wanneer er gespeeld wordt, en doet een proefbeurt of wordt lid.
      FIRST VIEWPORT: verenkrans en vluchtbaan lanceren vanuit het kurkpunt
      linksonder; de kop rijdt de lancering, "Word lid!" zit op het kurkpunt,
      het eerstvolgende speelmoment is meteen zichtbaar.
      FORM: de veren shuttle als fysiek object, kandidaat 7 van de gegronde
      lijst, toegewezen door seed fc2b4f50.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, DESIGN.md, and every shipping raster
      carrying its provenance.
    */}
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>

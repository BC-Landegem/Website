# De intraclub-API (Laravel). Deze waarde staat ook als standaard in
# src/lib/intra.ts en src/lib/intra-build.ts, dus zonder .env werkt alles;
# zet hem hier wanneer je tegen een andere omgeving wil ontwikkelen.
#
# PUBLIC_ is verplicht: de variabele wordt zowel bij de build gelezen (de
# bevroren pagina's) als meegecompileerd naar de browser (het lopende seizoen).
PUBLIC_INTRA_API=https://intra.bclandegem.be/api

# Bestemming van de build. Zonder deze twee bouwt alles voor GitHub Pages
# (https://bc-landegem.github.io/Website/), ook de dev-server. Wil je lokaal
# nakijken hoe de site er op de root van www.bclandegem.be uitziet — zoals
# deploy-ftp.yml hem bouwt — zet dan:
# SITE_URL=https://www.bclandegem.be
# BASE_PATH=/

# Pushberichten. Zonder PUBLIC_VAPID_PUBLIC_KEY staat push uit: de pagina
# /club/pushberichten/ zegt dat, en de links ernaartoe verschijnen niet. De
# sleutel is de publieke helft van het VAPID-paar in de Laravel-config van
# intra.bclandegem.be (base64url) — één paar per omgeving, zodat testberichten
# nooit bij de echte abonnees belanden. Zie README "Databronnen · Pushberichten".
# PUBLIC_VAPID_PUBLIC_KEY=
# PUBLIC_PUSH_ENDPOINT=https://intra.bclandegem.be/api/push/subscriptions
